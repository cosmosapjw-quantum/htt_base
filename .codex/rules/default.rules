# htt_base project-local Codex rules. Rules are experimental; verify with codex execpolicy check.

prefix_rule(
    pattern = ["python", "-m", "pytest"],
    decision = "allow",
    justification = "Allow project test commands.",
    match = ["python -m pytest -q", "python -m pytest --collect-only -q"],
)

prefix_rule(
    pattern = ["python", "scripts/codex_harness/validate_pr_dag.py"],
    decision = "allow",
    justification = "Allow repo-local DAG validation.",
    match = ["python scripts/codex_harness/validate_pr_dag.py docs/codex_handoff/pr_backlog.yaml"],
)

prefix_rule(
    pattern = ["python", "scripts/codex_harness/progress_report.py"],
    decision = "allow",
    justification = "Allow repo-local DAG progress reporting.",
    match = ["python scripts/codex_harness/progress_report.py docs/codex_handoff/pr_backlog.yaml docs/codex_handoff/pr_status.yaml"],
)

prefix_rule(
    pattern = ["python", "scripts/codex_harness/run_subset.py"],
    decision = "allow",
    justification = "Allow repo-local subset runner inspection.",
    match = ["python scripts/codex_harness/run_subset.py --list"],
)

prefix_rule(
    pattern = ["python", "scripts/codex_harness/verify_skill_layout.py"],
    decision = "allow",
    justification = "Allow repo-local skill layout verification.",
    match = ["python scripts/codex_harness/verify_skill_layout.py ."],
)

prefix_rule(
    pattern = ["python", "scripts/codex_harness/skill_index.py"],
    decision = "allow",
    justification = "Allow repo-local skill inventory export.",
    match = ["python scripts/codex_harness/skill_index.py ."],
)

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Read-only git status is safe.",
    match = ["git status", "git status --short"],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Read-only git diff is safe.",
    match = ["git diff", "git diff --stat"],
)

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Allow staging for automatic commits (user-authorized 2026-06-20). Additive only.",
    match = ["git add AGENTS.md", "git add docs/codex_handoff/pr_status.yaml"],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Allow automatic commits (user-authorized 2026-06-20). Additive only; no branch/history rewrite; push still gated.",
    match = ["git commit -m PR-000: intake"],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Do not recursively delete. Use explicit path-specific cleanup with review.",
    match = ["rm -rf /tmp/foo"],
)
