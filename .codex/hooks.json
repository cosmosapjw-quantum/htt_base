{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 -B \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start_context.py\"",
            "timeout": 20,
            "statusMessage": "Loading shared-context harness"
          }
        ]
      }
    ],
    "SubagentStart": [],
    "SubagentStop": []
  }
}
