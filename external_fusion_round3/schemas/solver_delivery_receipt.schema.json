{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/htt/solver_delivery_receipt.schema.json",
  "title": "Native Bianchi Boltzmann Solver Delivery Receipt",
  "type": "object",
  "required": ["schema", "solver_commit", "environment_hash", "temperature", "polarization_EB", "recombination", "reionization", "flrw_null", "analytic_benchmarks", "independent_oracle", "convergence", "error_model", "pass"],
  "properties": {
    "schema": {"const": "htt.native_bianchi_solver_delivery.v1"},
    "solver_commit": {"type": "string", "minLength": 7},
    "environment_hash": {"type": "string", "minLength": 16},
    "temperature": {"const": true},
    "polarization_EB": {"const": true},
    "recombination": {"const": true},
    "reionization": {"const": true},
    "flrw_null": {"const": "PASS"},
    "analytic_benchmarks": {"type": "array", "minItems": 3},
    "independent_oracle": {"const": "PASS"},
    "convergence": {"const": "PASS"},
    "error_model": {"type": "object"},
    "pass": {"const": true}
  }
}
