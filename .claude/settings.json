      "Bash(git commit *)",
      "Bash(cargo test *)",
      "Bash(kill *)",
      "Bash(awk '{print $10}')",
      "Bash(git mv *)",
      "Bash(PYTHONPATH=. ../venv/bin/python -m pytest bass/validation/test_external_code_policy.py -q)",
