      "Bash(venv/bin/python scripts/make_physics_gallery.py --only 04_reionization 06_tilt_boost 08_parameter_sweeps)",
      "Bash(venv/bin/python scripts/make_physics_gallery.py --only 05_bianchi_shear 07_friedmann_closure)",
      "Bash(venv/bin/python scripts/make_physics_gallery.py --only 02_flrw_geometry)",
