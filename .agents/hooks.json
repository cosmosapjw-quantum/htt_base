{
  "publication-firewall": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agent-harness/scripts/provider_publication_hook.py --provider antigravity",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*github.*|mcp__.*pull[_-]request.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agent-harness/scripts/provider_publication_hook.py --provider antigravity",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
