{
  "all_rows_valid": true,
  "automated_scan_failures": [],
  "equation_source_definitions": {
    "NUMPY-RFFTN-REAL-INPUT-CONVENTION": {
      "kind": "external_api_source",
      "statement": "NumPy real-input FFTs exploit Hermitian symmetry and retain only non-negative frequencies on the final transformed axis.",
      "url": "https://numpy.org/doc/stable/reference/generated/numpy.fft.rfft.html",
      "verified_on": "2026-07-16"
    },
    "PR123-EQ-CAP-ALPHA-HAT": {
      "kind": "analytic_equation",
      "statement": "alpha_hat=sum_p N_p / sum_p R_p is refitted independently for every realization."
    },
    "PR123-EQ-CONJUGATE-NORMAL-MARGINAL-LIKELIHOOD": {
      "kind": "analytic_equation",
      "statement": "log BF10=-0.5 log(1+n tau^2/sigma^2)+0.5 n^2 tau^2 ybar^2/[sigma^2(sigma^2+n tau^2)]."
    },
    "PR123-EQ-CONJUGATE-POSTERIOR-PREDICTIVE": {
      "kind": "analytic_equation",
      "statement": "mu|y is Normal(m_n,V_n) and y_rep|mu is Normal(mu,sigma^2)."
    },
    "PR123-EQ-CONSTRAINED-BLUE-KKT": {
      "kind": "analytic_equation",
      "statement": "D=[N,S], C=diag(sigma_i^2), W=[I,0](D^T C^-1 D)^-1 D^T C^-1, hence WN=I and WS=0 when D has full column rank."
    },
    "PR123-EQ-COVARIANCE-INFLATION": {
      "kind": "analytic_equation",
      "statement": "C=diag(sigma_i^2)+sigma_shared^2 11^T; sigma_i to infinity removes row i from the GLS limit."
    },
    "PR123-EQ-CURL-DIVERGENCE": {
      "kind": "analytic_equation",
      "statement": "curl(v)_i=epsilon_ijk partial_j v_k and div(v)=partial_i v_i in the analytic Cartesian test frame."
    },
    "PR123-EQ-D2-D4-FIRST-DERIVATIVE": {
      "kind": "analytic_equation",
      "statement": "D2 f_i=(f_{i+1}-f_{i-1})/(2h); D4 f_i=(-f_{i+2}+8f_{i+1}-8f_{i-1}+f_{i-2})/(12h), with registered one-sided closures."
    },
    "PR123-EQ-GRADIENT-TENSOR-SQRT2": {
      "kind": "analytic_equation",
      "statement": "For zero-mean iid isotropic G_ij with E[G_ij G_kl]=sigma^2 delta_ik delta_jl, E|curl v|^2=6 sigma^2 and E(div v)^2=3 sigma^2, so the RMS ratio is sqrt(2)."
    },
    "PR123-EQ-GREATER-EQUAL-TIE-POLICY": {
      "kind": "analytic_equation",
      "statement": "Greater-equal ranks assign tied scores the same conservative finite-sample tail probability."
    },
    "PR123-EQ-HETEROSCEDASTIC-GLS": {
      "kind": "analytic_equation",
      "statement": "mu_hat=(1^T C^-1 y)/(1^T C^-1 1), Var(mu_hat)=(1^T C^-1 1)^-1."
    },
    "PR123-EQ-OBSERVATION-INCLUSIVE-FINITE-RANK": {
      "kind": "analytic_equation",
      "statement": "p_i=#{j:s_j>=s_i}/N on the pooled observation-plus-null sample."
    },
    "PR123-EQ-OCCAM-FACTOR": {
      "kind": "analytic_equation",
      "statement": "The negative log-normalization term distinguishes normalized marginal evidence from a fitted-score gain."
    },
    "PR123-EQ-PREDICTIVE-VARIANCE-DECOMPOSITION": {
      "kind": "analytic_equation",
      "statement": "Var(y_rep|y)=sigma^2+V_n; a plug-in predictive omits V_n."
    },
    "PR123-EQ-REAL-DFT-HERMITIAN-PLANE": {
      "kind": "analytic_equation",
      "statement": "For real x, F(k)=conj(F(-k)); self-conjugate zero and Nyquist plane entries obey the corresponding Hermitian constraints."
    },
    "PR123-EQ-VALIDATED-DOMAIN-CONTAINMENT": {
      "kind": "analytic_equation",
      "statement": "A requested closed interval is authorized only when it is contained in both callable and hash-bound validated intervals with endpoint openness respected."
    },
    "PR123-EQ-WEIGHTED-MONOPOLE-ZERO": {
      "kind": "analytic_equation",
      "statement": "For delta_p=(N_p-alpha_hat R_p)/(alpha_hat R_p), sum_p R_p delta_p=0."
    },
    "PR123-SOURCE-ACT-VALIDATED-RANGE-40-763": {
      "external_url": "https://arxiv.org/abs/2304.05202",
      "kind": "repository_audit_source",
      "repository_path": "docs/audits/self_adversarial_audit_20260713_nsc/04_web_crag_novelty_ledger.json",
      "repository_sha256": "193a0ad5dc5b461724edea6f8c5e9d09ee00fb5fe49a456fdc6d770b3a30bca8",
      "statement": "The frozen CRAG ledger records the ACT DR6 baseline lensing range 40<L<763 and the low-L exclusion caveat."
    },
    "PR123-SOURCE-JCAP-AUDIT-SHELL-MONOPOLE": {
      "kind": "repository_audit_source",
      "repository_path": "docs/audits/self_adversarial_audit_20260713_nsc/05_significance_panel.json",
      "repository_sha256": "d16729a7a13d62187bc1ed70e37589f666244873c724c9983f7bf97b2f346040",
      "statement": "The frozen audit identifies radial shell-monopole leakage as the mapped CF4 estimator defect."
    }
  },
