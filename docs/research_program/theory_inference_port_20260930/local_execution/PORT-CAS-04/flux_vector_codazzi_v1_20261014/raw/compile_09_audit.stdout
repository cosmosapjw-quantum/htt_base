                  r
PORTCAS04FluxVectorCodazzi.codazzi_core : ∀ (G : Fin 4 → Fin 4 → Fin 4 → ℝ) (dG : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ)
  (K : Fin 4 → Fin 4 → ℝ) (dK : Fin 4 → Fin 4 → Fin 4 → ℝ) (dH : Fin 4 → ℝ),
  (∀ (a b c : Fin 4), G a b c = G a c b) →
    (∀ (p q : Fin 4), G p 0 q = -K p q) →
      (∀ (p q : Fin 4), G p q 0 = -K p q) →
        (∀ (r p q : Fin 4), dG r p q 0 = -dK r p q) →
          (∀ (q : Fin 4), K 0 q = 0) →
            (∀ (p : Fin 4), K p 0 = 0) →
              (∀ (r q : Fin 4), dK r 0 q = 0) →
                (∀ (r : Fin 4), dH r = ∑ p, dK r p p) →
                  ∀ (i : Fin 4),
                    i ≠ 0 →
                      ∑ a, dG a a i 0 - ∑ a, dG i a a 0 + ∑ a, ∑ e, G a a e * G e i 0 - ∑ a, ∑ e, G a i e * G e a 0 =
                        -(∑ b,
                              ∑ p,
                                ∑ q,
                                  ∑ r,
                                    Matrix.diagonal ![0, 1, 1, 1] b p * Matrix.diagonal ![0, 1, 1, 1] q i *
                                        Matrix.diagonal ![0, 1, 1, 1] r b *
                                      (dK r p q + ∑ s, G p r s * K s q - ∑ s, G s r q * K p s) -
                            ∑ r, Matrix.diagonal ![0, 1, 1, 1] r i * dH r)
PORTCAS04FluxVectorCodazzi.homogeneous_core : ∀ (G : Fin 4 → Fin 4 → Fin 4 → ℝ) (K : Fin 4 → Fin 4 → ℝ)
  (dK : Fin 4 → Fin 4 → Fin 4 → ℝ) (dH : Fin 4 → ℝ),
  (∀ (d : Fin 4), G 0 0 d = 0) →
    (∀ (d : Fin 4), K 0 d = 0) →
      (∀ (r : Fin 4), r ≠ 0 → ∀ (p q : Fin 4), dK r p q = 0) →
        (∀ (r : Fin 4), r ≠ 0 → dH r = 0) →
          ∀ (i : Fin 4),
            i ≠ 0 →
              ∑ b,
                    ∑ p,
                      ∑ q,
                        ∑ r,
                          Matrix.diagonal ![0, 1, 1, 1] b p * Matrix.diagonal ![0, 1, 1, 1] q i *
                              Matrix.diagonal ![0, 1, 1, 1] r b *
                            (dK r p q + ∑ s, G p r s * K s q - ∑ s, G s r q * K p s) -
                  ∑ r, Matrix.diagonal ![0, 1, 1, 1] r i * dH r =
                ∑ b, ∑ d, G b b d * K d i - ∑ b, ∑ d, G d b i * K b d
@PORTCAS04FluxVectorCodazzi.vec0111_ne : ∀ {a : Fin 4}, a ≠ 0 → ![0, 1, 1, 1] a = 1
PORTCAS04FluxVectorCodazzi.diag0111_col0 : ∀ (q : Fin 4), Matrix.diagonal ![0, 1, 1, 1] q 0 = 0
PORTCAS04FluxVectorCodazzi.diag0111_row0 : ∀ (q : Fin 4), Matrix.diagonal ![0, 1, 1, 1] 0 q = 0
PORTCAS04FluxVectorCodazzi.sum_diag0111 : ∀ (a : Fin 4) (f : Fin 4 → ℝ),
  ∑ b, Matrix.diagonal ![0, 1, 1, 1] a b * f b = ![0, 1, 1, 1] a * f a
PORTCAS04FluxVectorCodazzi.sum_single0 : ∀ (f : Fin 4 → ℝ), ∑ c, Pi.single 0 1 c * f c = f 0
PORTCAS04FluxVectorCodazzi.codazziLHS_unfold : ∀
  (g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M)
  (x : PORTCAS03VelocityJetDecomposition.Pt) (a : Fin 4),
  PORTCAS04FluxVectorCodazzi.codazziLHS g ginv x a =
    ∑ b,
        ∑ p,
          ∑ q,
            ∑ r,
              PORTCAS03VelocityJetDecomposition.projUp (g x) (PORTCAS04FluxVectorCodazzi.sliceNormal ginv x) b p *
                    PORTCAS03VelocityJetDecomposition.projUp (g x) (PORTCAS04FluxVectorCodazzi.sliceNormal ginv x) q a *
                  PORTCAS03VelocityJetDecomposition.projUp (g x) (PORTCAS04FluxVectorCodazzi.sliceNormal ginv x) r b *
                (PORTCAS03VelocityJetDecomposition.pd (fun y => PORTCAS04FluxVectorCodazzi.extrinsicMixed g ginv y p q)
                      x r +
                    ∑ s,
                      PORTCAS04FluxVectorCodazzi.christoffel g ginv x p r s *
                        PORTCAS04FluxVectorCodazzi.extrinsicMixed g ginv x s q -
                  ∑ s,
                    PORTCAS04FluxVectorCodazzi.christoffel g ginv x s r q *
                      PORTCAS04FluxVectorCodazzi.extrinsicMixed g ginv x p s) -
      ∑ r,
        PORTCAS03VelocityJetDecomposition.projUp (g x) (PORTCAS04FluxVectorCodazzi.sliceNormal ginv x) r a *
          PORTCAS03VelocityJetDecomposition.pd (PORTCAS04FluxVectorCodazzi.meanCurvature g ginv) x r
@PORTCAS04FluxVectorCodazzi.codazziLHS_zero : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {x : PORTCAS03VelocityJetDecomposition.Pt}, x ∈ U → PORTCAS04FluxVectorCodazzi.codazziLHS g ginv x 0 = 0
@PORTCAS04FluxVectorCodazzi.einstein_mixed_gaussian : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {x : PORTCAS03VelocityJetDecomposition.Pt},
      x ∈ U →
        (∀ (a b c : Fin 4), DifferentiableAt ℝ (fun y => PORTCAS04FluxVectorCodazzi.christoffel g ginv y a b c) x) →
          ∀ (i : Fin 4),
            i ≠ 0 →
              PORTCAS04FluxVectorCodazzi.einstein (PORTCAS04FluxVectorCodazzi.christoffel g ginv) g ginv x 0 i =
                -PORTCAS04FluxVectorCodazzi.codazziLHS g ginv x i
@PORTCAS04FluxVectorCodazzi.contracted_codazzi_gaussian : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {x : PORTCAS03VelocityJetDecomposition.Pt},
      x ∈ U →
        (∀ (a b c : Fin 4), DifferentiableAt ℝ (fun y => PORTCAS04FluxVectorCodazzi.christoffel g ginv y a b c) x) →
          ∀ (a : Fin 4),
            PORTCAS04FluxVectorCodazzi.codazziLHS g ginv x a =
              -∑ b,
                  PORTCAS03VelocityJetDecomposition.projDown (g x) (PORTCAS04FluxVectorCodazzi.sliceNormal ginv x) a b *
                    ∑ c,
                      PORTCAS04FluxVectorCodazzi.sliceNormal ginv x c *
                        PORTCAS04FluxVectorCodazzi.ricci (PORTCAS04FluxVectorCodazzi.christoffel g ginv) x c b
@PORTCAS04FluxVectorCodazzi.normalFlux_gauss : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {y : PORTCAS03VelocityJetDecomposition.Pt},
      y ∈ U →
        ∀ (T : PORTCAS04FluxVectorCodazzi.M) (a : Fin 4),
          PORTCAS04FluxVectorCodazzi.normalFlux (g y) (Pi.single 0 1) T a = -(![0, 1, 1, 1] a * T a 0)
@PORTCAS04FluxVectorCodazzi.momentum_constraint : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {x : PORTCAS03VelocityJetDecomposition.Pt},
      x ∈ U →
        (∀ (a b c : Fin 4), DifferentiableAt ℝ (fun y => PORTCAS04FluxVectorCodazzi.christoffel g ginv y a b c) x) →
          ∀ (κ Λ : ℝ) (T : PORTCAS04FluxVectorCodazzi.M),
            Matrix.transpose T = T →
              (∀ (b d : Fin 4),
                  PORTCAS04FluxVectorCodazzi.einstein (PORTCAS04FluxVectorCodazzi.christoffel g ginv) g ginv x b d +
                      Λ * g x b d =
                    κ * T b d) →
                ∀ (a : Fin 4),
                  PORTCAS04FluxVectorCodazzi.codazziLHS g ginv x a =
                    κ * PORTCAS04FluxVectorCodazzi.normalFlux (g x) (PORTCAS04FluxVectorCodazzi.sliceNormal ginv x) T a
@PORTCAS04FluxVectorCodazzi.codazzi_perfect_fluid_tilt : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {x : PORTCAS03VelocityJetDecomposition.Pt},
      x ∈ U →
        (∀ (a b c : Fin 4), DifferentiableAt ℝ (fun y => PORTCAS04FluxVectorCodazzi.christoffel g ginv y a b c) x) →
          ∀ {κ : ℝ},
            κ ≠ 0 →
              ∀ (Λ : ℝ) {w : ℝ},
                0 < w →
                  ∀ (p γ : ℝ) (β : PORTCAS04FluxVectorCodazzi.V),
                    PORTCAS04FluxVectorCodazzi.sliceNormal ginv x ⬝ᵥ Matrix.mulVec (g x) β = 0 →
                      γ • (PORTCAS04FluxVectorCodazzi.sliceNormal ginv x + β) ⬝ᵥ
                            Matrix.mulVec (g x) (γ • (PORTCAS04FluxVectorCodazzi.sliceNormal ginv x + β)) =
                          -1 →
                        (β ≠ 0 → 0 < β ⬝ᵥ Matrix.mulVec (g x) β) →
                          (∀ (b d : Fin 4),
                              PORTCAS04FluxVectorCodazzi.einstein (PORTCAS04FluxVectorCodazzi.christoffel g ginv) g ginv
                                    x b d +
                                  Λ * g x b d =
                                κ *
                                  PORTCAS04FluxVectorCodazzi.perfectFluid (g x) w p
                                    (γ • (PORTCAS04FluxVectorCodazzi.sliceNormal ginv x + β)) b d) →
                            PORTCAS04FluxVectorCodazzi.codazziLHS g ginv x = (κ * (w * γ ^ 2)) • Matrix.mulVec (g x) β ∧
                              PORTCAS04FluxVectorCodazzi.betaVector (ginv x) w
                                    (κ⁻¹ • PORTCAS04FluxVectorCodazzi.codazziLHS g ginv x) =
                                  Matrix.mulVec (g x) β ∧
                                PORTCAS04FluxScalarInverse.betaOfRatio
                                    (PORTCAS04FluxVectorCodazzi.fluxNorm (ginv x)
                                        (κ⁻¹ • PORTCAS04FluxVectorCodazzi.codazziLHS g ginv x) /
                                      w) =
                                  √(β ⬝ᵥ Matrix.mulVec (g x) β)
@PORTCAS04FluxVectorCodazzi.codazzi_homogeneous_reduction : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {x : PORTCAS03VelocityJetDecomposition.Pt},
      x ∈ U →
        (∀ (r : Fin 4),
            r ≠ 0 →
              ∀ (p q : Fin 4),
                PORTCAS03VelocityJetDecomposition.pd (fun y => PORTCAS04FluxVectorCodazzi.extrinsicMixed g ginv y p q) x
                    r =
                  0) →
          (∀ (r : Fin 4),
              r ≠ 0 → PORTCAS03VelocityJetDecomposition.pd (PORTCAS04FluxVectorCodazzi.meanCurvature g ginv) x r = 0) →
            ∀ (i : Fin 4),
              i ≠ 0 →
                PORTCAS04FluxVectorCodazzi.codazziLHS g ginv x i =
                  ∑ b,
                      ∑ d,
                        PORTCAS04FluxVectorCodazzi.christoffel g ginv x b b d *
                          PORTCAS04FluxVectorCodazzi.extrinsicMixed g ginv x d i -
                    ∑ b,
                      ∑ d,
                        PORTCAS04FluxVectorCodazzi.christoffel g ginv x d b i *
                          PORTCAS04FluxVectorCodazzi.extrinsicMixed g ginv x b d
PORTCAS04FluxVectorCodazzi.minkowski_codazzi_witness : ∀ (κ : ℝ) (x : PORTCAS03VelocityJetDecomposition.Pt),
  PORTCAS04FluxVectorCodazzi.GaussianChart PORTCAS03VelocityJetDecomposition.gMink
      PORTCAS03VelocityJetDecomposition.gMink Set.univ ∧
    (∀ (a b c : Fin 4),
        DifferentiableAt ℝ
          (fun y =>
            PORTCAS04FluxVectorCodazzi.christoffel PORTCAS03VelocityJetDecomposition.gMink
              PORTCAS03VelocityJetDecomposition.gMink y a b c)
          x) ∧
      ∀ (b d : Fin 4),
        PORTCAS04FluxVectorCodazzi.einstein
              (PORTCAS04FluxVectorCodazzi.christoffel PORTCAS03VelocityJetDecomposition.gMink
                PORTCAS03VelocityJetDecomposition.gMink)
              PORTCAS03VelocityJetDecomposition.gMink PORTCAS03VelocityJetDecomposition.gMink x b d +
            0 * PORTCAS03VelocityJetDecomposition.gMink x b d =
          κ * 0 b d
