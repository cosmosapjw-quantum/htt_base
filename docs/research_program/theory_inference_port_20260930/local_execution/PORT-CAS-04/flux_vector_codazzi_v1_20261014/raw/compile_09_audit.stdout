PORTCAS04FluxVectorCodazzi.vmv_mulVec : ∀ (a b v : PORTCAS04FluxVectorCodazzi.V),
  (Matrix.vecMulVec a b).mulVec v = (b ⬝ᵥ v) • a
PORTCAS04FluxVectorCodazzi.perfectFluid_mulVec : ∀ (g : PORTCAS04FluxVectorCodazzi.M) (w p : ℝ)
  (u v : PORTCAS04FluxVectorCodazzi.V),
  Matrix.mulVec (PORTCAS04FluxVectorCodazzi.perfectFluid g w p u) v =
    (w * Matrix.mulVec g u ⬝ᵥ v) • Matrix.mulVec g u + p • Matrix.mulVec g v
PORTCAS04FluxVectorCodazzi.projDown_mulVec : ∀ (g : PORTCAS04FluxVectorCodazzi.M) (n v : PORTCAS04FluxVectorCodazzi.V),
  (PORTCAS03VelocityJetDecomposition.projDown g n).mulVec v = v + (n ⬝ᵥ v) • Matrix.mulVec g n
PORTCAS04FluxVectorCodazzi.normalFlux_eq : ∀ (g : PORTCAS04FluxVectorCodazzi.M) (n : PORTCAS04FluxVectorCodazzi.V)
  (T : PORTCAS04FluxVectorCodazzi.M),
  PORTCAS04FluxVectorCodazzi.normalFlux g n T = -(Matrix.mulVec T n + (n ⬝ᵥ Matrix.mulVec T n) • Matrix.mulVec g n)
@PORTCAS04FluxVectorCodazzi.perfectFluid_symm : ∀ {g : PORTCAS04FluxVectorCodazzi.M},
  Matrix.transpose g = g →
    ∀ (w p : ℝ) (u : PORTCAS04FluxVectorCodazzi.V),
      Matrix.transpose (PORTCAS04FluxVectorCodazzi.perfectFluid g w p u) =
        PORTCAS04FluxVectorCodazzi.perfectFluid g w p u
@PORTCAS04FluxVectorCodazzi.n_dot_ul : ∀ {g : PORTCAS04FluxVectorCodazzi.M} {n β : PORTCAS04FluxVectorCodazzi.V},
  n ⬝ᵥ Matrix.mulVec g n = -1 → n ⬝ᵥ Matrix.mulVec g β = 0 → ∀ (γ : ℝ), n ⬝ᵥ Matrix.mulVec g (γ • (n + β)) = -γ
@PORTCAS04FluxVectorCodazzi.ul_dot_n : ∀ {g : PORTCAS04FluxVectorCodazzi.M} {n β : PORTCAS04FluxVectorCodazzi.V},
  n ⬝ᵥ Matrix.mulVec g n = -1 → n ⬝ᵥ Matrix.mulVec g β = 0 → ∀ (γ : ℝ), Matrix.mulVec g (γ • (n + β)) ⬝ᵥ n = -γ
@PORTCAS04FluxVectorCodazzi.beta_dot_n : ∀ {g : PORTCAS04FluxVectorCodazzi.M} {n β : PORTCAS04FluxVectorCodazzi.V},
  Matrix.transpose g = g → n ⬝ᵥ Matrix.mulVec g β = 0 → β ⬝ᵥ Matrix.mulVec g n = 0
@PORTCAS04FluxVectorCodazzi.quad : ∀ {g : PORTCAS04FluxVectorCodazzi.M} {n β : PORTCAS04FluxVectorCodazzi.V},
  Matrix.transpose g = g →
    n ⬝ᵥ Matrix.mulVec g n = -1 →
      n ⬝ᵥ Matrix.mulVec g β = 0 →
        ∀ (γ : ℝ), γ • (n + β) ⬝ᵥ Matrix.mulVec g (γ • (n + β)) = γ ^ 2 * (β ⬝ᵥ Matrix.mulVec g β - 1)
@PORTCAS04FluxVectorCodazzi.normalFlux_perfectFluid : ∀ {g : PORTCAS04FluxVectorCodazzi.M}
  {n β : PORTCAS04FluxVectorCodazzi.V},
  Matrix.transpose g = g →
    n ⬝ᵥ Matrix.mulVec g n = -1 →
      n ⬝ᵥ Matrix.mulVec g β = 0 →
        ∀ (w p γ : ℝ),
          PORTCAS04FluxVectorCodazzi.normalFlux g n (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β))) =
            (w * γ ^ 2) • Matrix.mulVec g β
@PORTCAS04FluxVectorCodazzi.normalEnergy_perfectFluid : ∀ {g : PORTCAS04FluxVectorCodazzi.M}
  {n β : PORTCAS04FluxVectorCodazzi.V},
  Matrix.transpose g = g →
    n ⬝ᵥ Matrix.mulVec g n = -1 →
      n ⬝ᵥ Matrix.mulVec g β = 0 →
        ∀ (w p γ : ℝ),
          PORTCAS04FluxVectorCodazzi.normalEnergy n (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β))) =
            w * γ ^ 2 - p
@PORTCAS04FluxVectorCodazzi.projDown_ul : ∀ {g : PORTCAS04FluxVectorCodazzi.M} {n β : PORTCAS04FluxVectorCodazzi.V},
  n ⬝ᵥ Matrix.mulVec g n = -1 →
    n ⬝ᵥ Matrix.mulVec g β = 0 →
      ∀ (γ : ℝ),
        (PORTCAS03VelocityJetDecomposition.projDown g n).mulVec (Matrix.mulVec g (γ • (n + β))) = γ • Matrix.mulVec g β
@PORTCAS04FluxVectorCodazzi.projDown_g_projDownT : ∀ {g : PORTCAS04FluxVectorCodazzi.M}
  {n : PORTCAS04FluxVectorCodazzi.V},
  Matrix.transpose g = g →
    n ⬝ᵥ Matrix.mulVec g n = -1 →
      PORTCAS03VelocityJetDecomposition.projDown g n * g * (PORTCAS03VelocityJetDecomposition.projDown g n).transpose =
        PORTCAS03VelocityJetDecomposition.hDown g n
@PORTCAS04FluxVectorCodazzi.normalStress_perfectFluid : ∀ {g : PORTCAS04FluxVectorCodazzi.M}
  {n β : PORTCAS04FluxVectorCodazzi.V},
  Matrix.transpose g = g →
    n ⬝ᵥ Matrix.mulVec g n = -1 →
      n ⬝ᵥ Matrix.mulVec g β = 0 →
        ∀ (w p γ : ℝ),
          PORTCAS04FluxVectorCodazzi.normalStress g n (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β))) =
            p • PORTCAS03VelocityJetDecomposition.hDown g n +
              (w * γ ^ 2) • Matrix.vecMulVec (Matrix.mulVec g β) (Matrix.mulVec g β)
@PORTCAS04FluxVectorCodazzi.gamma_sq_of_normalized : ∀ {g : PORTCAS04FluxVectorCodazzi.M}
  {n β : PORTCAS04FluxVectorCodazzi.V} {γ : ℝ},
  Matrix.transpose g = g →
    n ⬝ᵥ Matrix.mulVec g n = -1 →
      n ⬝ᵥ Matrix.mulVec g β = 0 →
        γ • (n + β) ⬝ᵥ Matrix.mulVec g (γ • (n + β)) = -1 →
          β ⬝ᵥ Matrix.mulVec g β < 1 ∧ γ ^ 2 = 1 / (1 - β ⬝ᵥ Matrix.mulVec g β)
@PORTCAS04FluxVectorCodazzi.gamma_ne_zero : ∀ {g : PORTCAS04FluxVectorCodazzi.M} {n β : PORTCAS04FluxVectorCodazzi.V}
  {γ : ℝ},
  Matrix.transpose g = g →
    n ⬝ᵥ Matrix.mulVec g n = -1 → n ⬝ᵥ Matrix.mulVec g β = 0 → γ • (n + β) ⬝ᵥ Matrix.mulVec g (γ • (n + β)) = -1 → γ ≠ 0
@PORTCAS04FluxVectorCodazzi.flux_exact_coefficient : ∀ {g : PORTCAS04FluxVectorCodazzi.M}
  {n β : PORTCAS04FluxVectorCodazzi.V} {γ : ℝ},
  Matrix.transpose g = g →
    n ⬝ᵥ Matrix.mulVec g n = -1 →
      n ⬝ᵥ Matrix.mulVec g β = 0 →
        γ • (n + β) ⬝ᵥ Matrix.mulVec g (γ • (n + β)) = -1 →
          ∀ (w p : ℝ),
            PORTCAS04FluxVectorCodazzi.normalFlux g n (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β))) =
              (w / (1 - β ⬝ᵥ Matrix.mulVec g β)) • Matrix.mulVec g β
@PORTCAS04FluxVectorCodazzi.beta_eq_flux_div_enthalpy : ∀ {g : PORTCAS04FluxVectorCodazzi.M}
  {n β : PORTCAS04FluxVectorCodazzi.V} {γ w : ℝ},
  Matrix.transpose g = g →
    n ⬝ᵥ Matrix.mulVec g n = -1 →
      n ⬝ᵥ Matrix.mulVec g β = 0 →
        γ • (n + β) ⬝ᵥ Matrix.mulVec g (γ • (n + β)) = -1 →
          w ≠ 0 →
            ∀ (p : ℝ),
              Matrix.mulVec g β =
                (PORTCAS04FluxVectorCodazzi.normalEnergy n
                        (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β))) +
                      p)⁻¹ •
                  PORTCAS04FluxVectorCodazzi.normalFlux g n
                    (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β)))
@PORTCAS04FluxVectorCodazzi.normalStress_rank_one : ∀ {g : PORTCAS04FluxVectorCodazzi.M}
  {n β : PORTCAS04FluxVectorCodazzi.V} {γ w : ℝ},
  Matrix.transpose g = g →
    n ⬝ᵥ Matrix.mulVec g n = -1 →
      n ⬝ᵥ Matrix.mulVec g β = 0 →
        γ • (n + β) ⬝ᵥ Matrix.mulVec g (γ • (n + β)) = -1 →
          w ≠ 0 →
            ∀ (p : ℝ),
              PORTCAS04FluxVectorCodazzi.normalStress g n
                  (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β))) =
                p • PORTCAS03VelocityJetDecomposition.hDown g n +
                  (PORTCAS04FluxVectorCodazzi.normalEnergy n
                          (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β))) +
                        p)⁻¹ •
                    Matrix.vecMulVec
                      (PORTCAS04FluxVectorCodazzi.normalFlux g n
                        (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β))))
                      (PORTCAS04FluxVectorCodazzi.normalFlux g n
                        (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β))))
PORTCAS04FluxVectorCodazzi.betaOfRatio_denominator_pos : ∀ (r : ℝ), 0 < 1 + √(1 + 4 * r ^ 2)
PORTCAS04FluxVectorCodazzi.betaOfRatio_zero : PORTCAS04FluxScalarInverse.betaOfRatio 0 = 0
@PORTCAS04FluxVectorCodazzi.betaOfRatio_mem : ∀ {r : ℝ},
  0 ≤ r → 0 ≤ PORTCAS04FluxScalarInverse.betaOfRatio r ∧ PORTCAS04FluxScalarInverse.betaOfRatio r < 1
@PORTCAS04FluxVectorCodazzi.betaOfRatio_solves : ∀ {r : ℝ},
  0 ≤ r → PORTCAS04FluxScalarInverse.betaOfRatio r / (1 - PORTCAS04FluxScalarInverse.betaOfRatio r ^ 2) = r
@PORTCAS04FluxVectorCodazzi.betaOfRatio_unique : ∀ {b r : ℝ},
  0 ≤ b → b < 1 → b / (1 - b ^ 2) = r → b = PORTCAS04FluxScalarInverse.betaOfRatio r
@PORTCAS04FluxVectorCodazzi.fluxNorm_perfectFluid : ∀ {g ginv : PORTCAS04FluxVectorCodazzi.M}
  {n β : PORTCAS04FluxVectorCodazzi.V} {γ w : ℝ},
  Matrix.transpose g = g →
    g * ginv = 1 →
      n ⬝ᵥ Matrix.mulVec g n = -1 →
        n ⬝ᵥ Matrix.mulVec g β = 0 →
          γ • (n + β) ⬝ᵥ Matrix.mulVec g (γ • (n + β)) = -1 →
            0 ≤ w →
              ∀ (p : ℝ),
                PORTCAS04FluxVectorCodazzi.fluxNorm ginv
                    (PORTCAS04FluxVectorCodazzi.normalFlux g n
                      (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β)))) =
                  w * γ ^ 2 * √(β ⬝ᵥ Matrix.mulVec g β)
@PORTCAS04FluxVectorCodazzi.scalar_flux_inverse : ∀ {g ginv : PORTCAS04FluxVectorCodazzi.M}
  {n β : PORTCAS04FluxVectorCodazzi.V} {γ w : ℝ},
  Matrix.transpose g = g →
    g * ginv = 1 →
      n ⬝ᵥ Matrix.mulVec g n = -1 →
        n ⬝ᵥ Matrix.mulVec g β = 0 →
          γ • (n + β) ⬝ᵥ Matrix.mulVec g (γ • (n + β)) = -1 →
            0 < w →
              0 ≤ β ⬝ᵥ Matrix.mulVec g β →
                ∀ (p : ℝ),
                  PORTCAS04FluxScalarInverse.betaOfRatio
                      (PORTCAS04FluxVectorCodazzi.fluxNorm ginv
                          (PORTCAS04FluxVectorCodazzi.normalFlux g n
                            (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β)))) /
                        w) =
                    √(β ⬝ᵥ Matrix.mulVec g β)
@PORTCAS04FluxVectorCodazzi.flux_zero_iff : ∀ {g ginv : PORTCAS04FluxVectorCodazzi.M}
  {n β : PORTCAS04FluxVectorCodazzi.V} {γ w : ℝ},
  Matrix.transpose g = g →
    g * ginv = 1 →
      n ⬝ᵥ Matrix.mulVec g n = -1 →
        n ⬝ᵥ Matrix.mulVec g β = 0 →
          γ • (n + β) ⬝ᵥ Matrix.mulVec g (γ • (n + β)) = -1 →
            w ≠ 0 →
              ∀ (p : ℝ),
                PORTCAS04FluxVectorCodazzi.normalFlux g n
                      (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β))) =
                    0 ↔
                  β = 0
PORTCAS04FluxVectorCodazzi.betaVector_zero : ∀ (ginv : PORTCAS04FluxVectorCodazzi.M) (w : ℝ),
  PORTCAS04FluxVectorCodazzi.betaVector ginv w 0 = 0
@PORTCAS04FluxVectorCodazzi.betaVector_of_ne : ∀ {ginv : PORTCAS04FluxVectorCodazzi.M} {w : ℝ}
  {J : PORTCAS04FluxVectorCodazzi.V},
  J ≠ 0 →
    PORTCAS04FluxVectorCodazzi.betaVector ginv w J =
      (PORTCAS04FluxScalarInverse.betaOfRatio (PORTCAS04FluxVectorCodazzi.fluxNorm ginv J / w) /
          PORTCAS04FluxVectorCodazzi.fluxNorm ginv J) •
        J
@PORTCAS04FluxVectorCodazzi.vector_flux_inverse : ∀ {g ginv : PORTCAS04FluxVectorCodazzi.M}
  {n β : PORTCAS04FluxVectorCodazzi.V} {γ w : ℝ},
  Matrix.transpose g = g →
    g * ginv = 1 →
      n ⬝ᵥ Matrix.mulVec g n = -1 →
        n ⬝ᵥ Matrix.mulVec g β = 0 →
          γ • (n + β) ⬝ᵥ Matrix.mulVec g (γ • (n + β)) = -1 →
            0 < w →
              (β ≠ 0 → 0 < β ⬝ᵥ Matrix.mulVec g β) →
                ∀ (p : ℝ),
                  PORTCAS04FluxVectorCodazzi.betaVector ginv w
                        (PORTCAS04FluxVectorCodazzi.normalFlux g n
                          (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β)))) =
                      Matrix.mulVec g β ∧
                    Matrix.mulVec ginv
                        (PORTCAS04FluxVectorCodazzi.betaVector ginv w
                          (PORTCAS04FluxVectorCodazzi.normalFlux g n
                            (PORTCAS04FluxVectorCodazzi.perfectFluid g w p (γ • (n + β))))) =
                      β
PORTCAS04FluxVectorCodazzi.minkowski_flux_inverse : ∀ (x y z : ℝ),
  PortCas01.s x y z < 1 →
    ∀ {w : ℝ},
      0 < w →
        ∀ (p : ℝ),
          PortCas01.fourVelocity x y z = PortCas01.gamma x y z • (PortCas01.e0 + ![0, x, y, z]) ∧
            PORTCAS04FluxVectorCodazzi.normalFlux PortCas01.eta PortCas01.e0
                  (PORTCAS04FluxVectorCodazzi.perfectFluid PortCas01.eta w p (PortCas01.fourVelocity x y z)) =
                (w * PortCas01.gamma x y z ^ 2) • ![0, x, y, z] ∧
              PORTCAS04FluxVectorCodazzi.betaVector PortCas01.eta w
                    (PORTCAS04FluxVectorCodazzi.normalFlux PortCas01.eta PortCas01.e0
                      (PORTCAS04FluxVectorCodazzi.perfectFluid PortCas01.eta w p (PortCas01.fourVelocity x y z))) =
                  ![0, x, y, z] ∧
                PORTCAS04FluxScalarInverse.betaOfRatio
                    (PORTCAS04FluxVectorCodazzi.fluxNorm PortCas01.eta
                        (PORTCAS04FluxVectorCodazzi.normalFlux PortCas01.eta PortCas01.e0
                          (PORTCAS04FluxVectorCodazzi.perfectFluid PortCas01.eta w p (PortCas01.fourVelocity x y z))) /
                      w) =
                  √(PortCas01.s x y z)
PORTCAS04FluxVectorCodazzi.normalFlux_add : ∀ (g : PORTCAS04FluxVectorCodazzi.M) (n : PORTCAS04FluxVectorCodazzi.V)
  (T₁ T₂ : PORTCAS04FluxVectorCodazzi.M),
  PORTCAS04FluxVectorCodazzi.normalFlux g n (T₁ + T₂) =
    PORTCAS04FluxVectorCodazzi.normalFlux g n T₁ + PORTCAS04FluxVectorCodazzi.normalFlux g n T₂
PORTCAS04FluxVectorCodazzi.counterflow_gamma_sq : (2 / √3) ^ 2 = 4 / 3
PORTCAS04FluxVectorCodazzi.counterflow_control : (2 / √3) • (PortCas01.e0 + ![0, 1 / 2, 0, 0]) ⬝ᵥ
      PortCas01.eta.mulVec ((2 / √3) • (PortCas01.e0 + ![0, 1 / 2, 0, 0])) =
    -1 ∧
  (2 / √3) • (PortCas01.e0 + -![0, 1 / 2, 0, 0]) ⬝ᵥ
        PortCas01.eta.mulVec ((2 / √3) • (PortCas01.e0 + -![0, 1 / 2, 0, 0])) =
      -1 ∧
    PORTCAS04FluxVectorCodazzi.normalFlux PortCas01.eta PortCas01.e0
          (PORTCAS04FluxVectorCodazzi.perfectFluid PortCas01.eta 1 0 ((2 / √3) • (PortCas01.e0 + ![0, 1 / 2, 0, 0])) +
            PORTCAS04FluxVectorCodazzi.perfectFluid PortCas01.eta 1 0
              ((2 / √3) • (PortCas01.e0 + -![0, 1 / 2, 0, 0]))) =
        0 ∧
      ![0, 1 / 2, 0, 0] ≠ 0 ∧
        PORTCAS04FluxVectorCodazzi.normalFlux PortCas01.eta PortCas01.e0
            (PORTCAS04FluxVectorCodazzi.perfectFluid PortCas01.eta 1 0
              ((2 / √3) • (PortCas01.e0 + ![0, 1 / 2, 0, 0]))) ≠
          0
PORTCAS04FluxVectorCodazzi.not_total_flux_zero_implies_untilted : ¬∀ (w₁ w₂ p₁ p₂ γ₁ γ₂ : ℝ)
    (β₁ β₂ : PORTCAS04FluxVectorCodazzi.V),
    0 < w₁ →
      0 < w₂ →
        PortCas01.e0 ⬝ᵥ PortCas01.eta.mulVec β₁ = 0 →
          PortCas01.e0 ⬝ᵥ PortCas01.eta.mulVec β₂ = 0 →
            γ₁ • (PortCas01.e0 + β₁) ⬝ᵥ PortCas01.eta.mulVec (γ₁ • (PortCas01.e0 + β₁)) = -1 →
              γ₂ • (PortCas01.e0 + β₂) ⬝ᵥ PortCas01.eta.mulVec (γ₂ • (PortCas01.e0 + β₂)) = -1 →
                PORTCAS04FluxVectorCodazzi.normalFlux PortCas01.eta PortCas01.e0
                      (PORTCAS04FluxVectorCodazzi.perfectFluid PortCas01.eta w₁ p₁ (γ₁ • (PortCas01.e0 + β₁)) +
                        PORTCAS04FluxVectorCodazzi.perfectFluid PortCas01.eta w₂ p₂ (γ₂ • (PortCas01.e0 + β₂))) =
                    0 →
                  β₁ = 0
@PORTCAS04FluxVectorCodazzi.pd_congr : ∀ {f f' : PORTCAS03VelocityJetDecomposition.Pt → ℝ}
  {x : PORTCAS03VelocityJetDecomposition.Pt},
  f =ᶠ[nhds x] f' →
    ∀ (r : Fin 4), PORTCAS03VelocityJetDecomposition.pd f x r = PORTCAS03VelocityJetDecomposition.pd f' x r
PORTCAS04FluxVectorCodazzi.pd_const : ∀ (c : ℝ) (x : PORTCAS03VelocityJetDecomposition.Pt) (r : Fin 4),
  PORTCAS03VelocityJetDecomposition.pd (fun x => c) x r = 0
PORTCAS04FluxVectorCodazzi.pd_neg : ∀ (f : PORTCAS03VelocityJetDecomposition.Pt → ℝ)
  (x : PORTCAS03VelocityJetDecomposition.Pt) (r : Fin 4),
  PORTCAS03VelocityJetDecomposition.pd (fun y => -f y) x r = -PORTCAS03VelocityJetDecomposition.pd f x r
@PORTCAS04FluxVectorCodazzi.pd_sum : ∀ {f : Fin 4 → PORTCAS03VelocityJetDecomposition.Pt → ℝ}
  {x : PORTCAS03VelocityJetDecomposition.Pt},
  (∀ (i : Fin 4), DifferentiableAt ℝ (f i) x) →
    ∀ (r : Fin 4),
      PORTCAS03VelocityJetDecomposition.pd (fun y => ∑ i, f i y) x r =
        ∑ i, PORTCAS03VelocityJetDecomposition.pd (f i) x r
@PORTCAS04FluxVectorCodazzi.sliceNormal_unit : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {y : PORTCAS03VelocityJetDecomposition.Pt},
  g y * ginv y = 1 →
    ginv y 0 0 < 0 →
      PORTCAS04FluxVectorCodazzi.sliceNormal ginv y ⬝ᵥ
            Matrix.mulVec (g y) (PORTCAS04FluxVectorCodazzi.sliceNormal ginv y) =
          -1 ∧
        0 < PORTCAS04FluxVectorCodazzi.sliceNormal ginv y 0
@PORTCAS04FluxVectorCodazzi.gauss_sym : ∀ {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {y : PORTCAS03VelocityJetDecomposition.Pt}, y ∈ U → ∀ (i j : Fin 4), g y i j = g y j i
@PORTCAS04FluxVectorCodazzi.gauss_g : ∀ {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {y : PORTCAS03VelocityJetDecomposition.Pt},
      y ∈ U → g y 0 0 = -1 ∧ g y 0 1 = 0 ∧ g y 0 2 = 0 ∧ g y 0 3 = 0 ∧ g y 1 0 = 0 ∧ g y 2 0 = 0 ∧ g y 3 0 = 0
@PORTCAS04FluxVectorCodazzi.gauss_ginv : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {y : PORTCAS03VelocityJetDecomposition.Pt},
      y ∈ U →
        ginv y 0 0 = -1 ∧
          ginv y 0 1 = 0 ∧ ginv y 0 2 = 0 ∧ ginv y 0 3 = 0 ∧ ginv y 1 0 = 0 ∧ ginv y 2 0 = 0 ∧ ginv y 3 0 = 0
@PORTCAS04FluxVectorCodazzi.gauss_col0 : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {y : PORTCAS03VelocityJetDecomposition.Pt}, y ∈ U → ∀ (b : Fin 4), g y b 0 = if b = 0 then -1 else 0
@PORTCAS04FluxVectorCodazzi.gauss_row0 : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {y : PORTCAS03VelocityJetDecomposition.Pt}, y ∈ U → ∀ (c : Fin 4), g y 0 c = if c = 0 then -1 else 0
@PORTCAS04FluxVectorCodazzi.gauss_pd_row0 : ∀
  {g ginv : PORTCAS03VelocityJetDecomposition.Pt → PORTCAS04FluxVectorCodazzi.M}
  {U : Set PORTCAS03VelocityJetDecomposition.Pt},
  PORTCAS04FluxVectorCodazzi.GaussianChart g ginv U →
    ∀ {y : PORTCAS03VelocityJetDecomposition.Pt},
