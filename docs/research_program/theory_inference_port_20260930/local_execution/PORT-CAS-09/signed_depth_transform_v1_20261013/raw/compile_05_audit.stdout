@P09SignedDepth.Idx : {d : ℕ} → (Fin (d + 1) → ℕ) → Type
@P09SignedDepth.CIdx : {d : ℕ} → (Fin (d + 1) → ℕ) → Type
@P09SignedDepth.Transport : {d : ℕ} → (Fin (d + 1) → ℕ) → Type
@P09SignedDepth.contrast : {d : ℕ} →
  {n : Fin (d + 1) → ℕ} → P09SignedDepth.Transport n → (P09SignedDepth.Idx n → ℝ) → P09SignedDepth.CIdx n → ℝ
@P09SignedDepth.contrastLin : {d : ℕ} →
  {n : Fin (d + 1) → ℕ} → P09SignedDepth.Transport n → (P09SignedDepth.Idx n → ℝ) →ₗ[ℝ] P09SignedDepth.CIdx n → ℝ
@P09SignedDepth.H : {d : ℕ} →
  {n : Fin (d + 1) → ℕ} → P09SignedDepth.Transport n → Matrix (P09SignedDepth.CIdx n) (P09SignedDepth.Idx n) ℝ
@P09SignedDepth.anchored : {d : ℕ} →
  {n : Fin (d + 1) → ℕ} → P09SignedDepth.Transport n → (P09SignedDepth.Idx n → ℝ) → P09SignedDepth.Idx n → ℝ
@P09SignedDepth.anchored_zero : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (x : P09SignedDepth.Idx n → ℝ) (a : Fin (n 0)), P09SignedDepth.anchored K x ⟨0, a⟩ = x ⟨0, a⟩
@P09SignedDepth.anchored_succ : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (x : P09SignedDepth.Idx n → ℝ) (j : Fin d) (a : Fin (n j.succ)),
  P09SignedDepth.anchored K x ⟨j.succ, a⟩ = P09SignedDepth.contrast K x ⟨j, a⟩
@P09SignedDepth.anchored_add : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (x y : P09SignedDepth.Idx n → ℝ),
  P09SignedDepth.anchored K (x + y) = P09SignedDepth.anchored K x + P09SignedDepth.anchored K y
@P09SignedDepth.anchored_smul : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n) (c : ℝ)
  (x : P09SignedDepth.Idx n → ℝ), P09SignedDepth.anchored K (c • x) = c • P09SignedDepth.anchored K x
@P09SignedDepth.anchoredLin : {d : ℕ} →
  {n : Fin (d + 1) → ℕ} → P09SignedDepth.Transport n → (P09SignedDepth.Idx n → ℝ) →ₗ[ℝ] P09SignedDepth.Idx n → ℝ
@P09SignedDepth.Tmat : {d : ℕ} →
  {n : Fin (d + 1) → ℕ} → P09SignedDepth.Transport n → Matrix (P09SignedDepth.Idx n) (P09SignedDepth.Idx n) ℝ
@P09SignedDepth.restoreBlock : {d : ℕ} →
  {n : Fin (d + 1) → ℕ} → P09SignedDepth.Transport n → (P09SignedDepth.Idx n → ℝ) → (i : Fin (d + 1)) → Fin (n i) → ℝ
@P09SignedDepth.restore : {d : ℕ} →
  {n : Fin (d + 1) → ℕ} → P09SignedDepth.Transport n → (P09SignedDepth.Idx n → ℝ) → P09SignedDepth.Idx n → ℝ
@P09SignedDepth.restoreBlock_zero : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (r : P09SignedDepth.Idx n → ℝ), P09SignedDepth.restoreBlock K r 0 = fun a => r ⟨0, a⟩
@P09SignedDepth.restoreBlock_succ : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (r : P09SignedDepth.Idx n → ℝ) (j : Fin d),
  P09SignedDepth.restoreBlock K r j.succ = fun a =>
    r ⟨j.succ, a⟩ + (K j).mulVec (P09SignedDepth.restoreBlock K r j.castSucc) a
@P09SignedDepth.blockDiagPart : {d : ℕ} →
  {n : Fin (d + 1) → ℕ} →
    Matrix (P09SignedDepth.Idx n) (P09SignedDepth.Idx n) ℝ → Matrix (P09SignedDepth.Idx n) (P09SignedDepth.Idx n) ℝ
@P09SignedDepth.H_mulVec : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (x : P09SignedDepth.Idx n → ℝ), (P09SignedDepth.H K).mulVec x = P09SignedDepth.contrast K x
@P09SignedDepth.H_apply' : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n) (p : P09SignedDepth.CIdx n)
  (q : P09SignedDepth.Idx n), P09SignedDepth.H K p q = P09SignedDepth.contrast K (Pi.single q 1) p
@P09SignedDepth.H_apply_succ : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n) (j : Fin d)
  (a b : Fin (n j.succ)), P09SignedDepth.H K ⟨j, a⟩ ⟨j.succ, b⟩ = if a = b then 1 else 0
@P09SignedDepth.H_apply_castSucc : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n) (j : Fin d)
  (a : Fin (n j.succ)) (b : Fin (n j.castSucc)), P09SignedDepth.H K ⟨j, a⟩ ⟨j.castSucc, b⟩ = -K j a b
@P09SignedDepth.H_apply_other : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n) (j : Fin d)
  (i : Fin (d + 1)) (a : Fin (n j.succ)) (b : Fin (n i)),
  i ≠ j.succ → i ≠ j.castSucc → P09SignedDepth.H K ⟨j, a⟩ ⟨i, b⟩ = 0
@P09SignedDepth.Tmat_mulVec : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (x : P09SignedDepth.Idx n → ℝ), (P09SignedDepth.Tmat K).mulVec x = P09SignedDepth.anchored K x
@P09SignedDepth.Tmat_apply' : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (p q : P09SignedDepth.Idx n), P09SignedDepth.Tmat K p q = P09SignedDepth.anchored K (Pi.single q 1) p
@P09SignedDepth.Tmat_apply_zero : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n) (a : Fin (n 0))
  (q : P09SignedDepth.Idx n), P09SignedDepth.Tmat K ⟨0, a⟩ q = if q = ⟨0, a⟩ then 1 else 0
@P09SignedDepth.Tmat_apply_succ : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n) (j : Fin d)
  (a : Fin (n j.succ)) (q : P09SignedDepth.Idx n), P09SignedDepth.Tmat K ⟨j.succ, a⟩ q = P09SignedDepth.H K ⟨j, a⟩ q
@P09SignedDepth.Tmat_apply_diag : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n) (i : Fin (d + 1))
  (a b : Fin (n i)), P09SignedDepth.Tmat K ⟨i, a⟩ ⟨i, b⟩ = if a = b then 1 else 0
@P09SignedDepth.Tmat_apply_upper : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n) (i i' : Fin (d + 1))
  (a : Fin (n i)) (b : Fin (n i')), i < i' → P09SignedDepth.Tmat K ⟨i, a⟩ ⟨i', b⟩ = 0
@P09SignedDepth.Tmat_blockTriangular : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n),
  (P09SignedDepth.Tmat K).BlockTriangular fun p => OrderDual.toDual p.fst
P09SignedDepth.anchored_depth_zero : ∀ (n : Fin 1 → ℕ) (K : P09SignedDepth.Transport n), P09SignedDepth.anchored K = id
P09SignedDepth.Tmat_depth_zero : ∀ (n : Fin 1 → ℕ) (K : P09SignedDepth.Transport n), P09SignedDepth.Tmat K = 1
@P09SignedDepth.anchored_restore : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (r : P09SignedDepth.Idx n → ℝ), P09SignedDepth.anchored K (P09SignedDepth.restore K r) = r
@P09SignedDepth.restoreBlock_anchored : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (x : P09SignedDepth.Idx n → ℝ) (i : Fin (d + 1)),
  P09SignedDepth.restoreBlock K (P09SignedDepth.anchored K x) i = fun a => x ⟨i, a⟩
@P09SignedDepth.restore_anchored : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (x : P09SignedDepth.Idx n → ℝ), P09SignedDepth.restore K (P09SignedDepth.anchored K x) = x
@P09SignedDepth.restore_succ : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (r : P09SignedDepth.Idx n → ℝ) (j : Fin d) (a : Fin (n j.succ)),
  P09SignedDepth.restore K r ⟨j.succ, a⟩ =
    r ⟨j.succ, a⟩ + (K j).mulVec (fun b => P09SignedDepth.restore K r ⟨j.castSucc, b⟩) a
@P09SignedDepth.anchored_bijective : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n),
  Function.Bijective (P09SignedDepth.anchored K)
@P09SignedDepth.Tequiv : {d : ℕ} →
  {n : Fin (d + 1) → ℕ} → P09SignedDepth.Transport n → (P09SignedDepth.Idx n → ℝ) ≃ₗ[ℝ] P09SignedDepth.Idx n → ℝ
@P09SignedDepth.Rmat : {d : ℕ} →
  {n : Fin (d + 1) → ℕ} → P09SignedDepth.Transport n → Matrix (P09SignedDepth.Idx n) (P09SignedDepth.Idx n) ℝ
@P09SignedDepth.Tmat_mul_Rmat : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n),
  P09SignedDepth.Tmat K * P09SignedDepth.Rmat K = 1
@P09SignedDepth.Rmat_mul_Tmat : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n),
  P09SignedDepth.Rmat K * P09SignedDepth.Tmat K = 1
P09SignedDepth.bijective_depth_zero : ∀ (n : Fin 1 → ℕ) (K : P09SignedDepth.Transport n),
  Function.Bijective (P09SignedDepth.anchored K)
@P09SignedDepth.Tmat_det : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n),
  (P09SignedDepth.Tmat K).det = 1
@P09SignedDepth.meanVec : {Ω : Type u_1} →
  [inst : MeasurableSpace Ω] → {ι : Type u_2} → MeasureTheory.Measure Ω → (Ω → ι → ℝ) → ι → ℝ
@P09SignedDepth.covMat : {Ω : Type u_1} →
  [inst : MeasurableSpace Ω] → {ι : Type u_2} → MeasureTheory.Measure Ω → (Ω → ι → ℝ) → Matrix ι ι ℝ
@P09SignedDepth.mean_mulVec : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} {ι : Type u_2}
  {κ : Type u_3} [inst_1 : Fintype ι] (H : Matrix κ ι ℝ) (x : Ω → ι → ℝ),
  (∀ (i : ι), MeasureTheory.Integrable (fun ω => x ω i) μ) →
    (P09SignedDepth.meanVec μ fun ω => H.mulVec (x ω)) = H.mulVec (P09SignedDepth.meanVec μ x)
@P09SignedDepth.covMat_mulVec : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} {ι : Type u_2}
  {κ : Type u_3} [inst_1 : Fintype ι] [MeasureTheory.IsFiniteMeasure μ] (H : Matrix κ ι ℝ) (x : Ω → ι → ℝ),
  (∀ (i : ι), MeasureTheory.MemLp (fun ω => x ω i) 2 μ) →
    (P09SignedDepth.covMat μ fun ω => H.mulVec (x ω)) = H * P09SignedDepth.covMat μ x * H.transpose
@P09SignedDepth.contrast_moments : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} {d : ℕ}
  {n : Fin (d + 1) → ℕ} [MeasureTheory.IsProbabilityMeasure μ] (K : P09SignedDepth.Transport n)
  (x : Ω → P09SignedDepth.Idx n → ℝ),
  (∀ (p : P09SignedDepth.Idx n), MeasureTheory.MemLp (fun ω => x ω p) 2 μ) →
    (P09SignedDepth.meanVec μ fun ω => P09SignedDepth.contrast K (x ω)) =
        (P09SignedDepth.H K).mulVec (P09SignedDepth.meanVec μ x) ∧
      (P09SignedDepth.covMat μ fun ω => P09SignedDepth.contrast K (x ω)) =
        P09SignedDepth.H K * P09SignedDepth.covMat μ x * (P09SignedDepth.H K).transpose
@P09SignedDepth.anchored_moments : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} {d : ℕ}
  {n : Fin (d + 1) → ℕ} [MeasureTheory.IsProbabilityMeasure μ] (K : P09SignedDepth.Transport n)
  (x : Ω → P09SignedDepth.Idx n → ℝ),
  (∀ (p : P09SignedDepth.Idx n), MeasureTheory.MemLp (fun ω => x ω p) 2 μ) →
    (P09SignedDepth.meanVec μ fun ω => P09SignedDepth.anchored K (x ω)) =
        (P09SignedDepth.Tmat K).mulVec (P09SignedDepth.meanVec μ x) ∧
      (P09SignedDepth.covMat μ fun ω => P09SignedDepth.anchored K (x ω)) =
        P09SignedDepth.Tmat K * P09SignedDepth.covMat μ x * (P09SignedDepth.Tmat K).transpose
@P09SignedDepth.HCHt_apply : ∀ {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (C : Matrix (P09SignedDepth.Idx n) (P09SignedDepth.Idx n) ℝ) (j k : Fin d) (a : Fin (n j.succ)) (b : Fin (n k.succ)),
  (P09SignedDepth.H K * C * (P09SignedDepth.H K).transpose) ⟨j, a⟩ ⟨k, b⟩ =
    C ⟨j.succ, a⟩ ⟨k.succ, b⟩ - ∑ e, C ⟨j.succ, a⟩ ⟨k.castSucc, e⟩ * K k b e -
        ∑ c, K j a c * C ⟨j.castSucc, c⟩ ⟨k.succ, b⟩ +
      ∑ c, ∑ e, K j a c * C ⟨j.castSucc, c⟩ ⟨k.castSucc, e⟩ * K k b e
@P09SignedDepth.law_mulVec : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} {ι : Type u_2}
  {κ : Type u_3} [inst_1 : Fintype ι] [Fintype κ] (H : Matrix κ ι ℝ) (x : Ω → ι → ℝ),
  AEMeasurable x μ →
    MeasureTheory.Measure.map (fun ω => H.mulVec (x ω)) μ =
      MeasureTheory.Measure.map (fun v => H.mulVec v) (MeasureTheory.Measure.map x μ)
@P09SignedDepth.contrast_law : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} {d : ℕ}
  {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n) (x : Ω → P09SignedDepth.Idx n → ℝ),
  AEMeasurable x μ →
    MeasureTheory.Measure.map (fun ω => P09SignedDepth.contrast K (x ω)) μ =
      MeasureTheory.Measure.map (fun v => (P09SignedDepth.H K).mulVec v) (MeasureTheory.Measure.map x μ)
@P09SignedDepth.contrast_law_congr : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω} {d : ℕ}
  {n : Fin (d + 1) → ℕ} {Ω' : Type u_2} [inst_1 : MeasurableSpace Ω'] {ν : MeasureTheory.Measure Ω'}
  (K : P09SignedDepth.Transport n) (x : Ω → P09SignedDepth.Idx n → ℝ) (y : Ω' → P09SignedDepth.Idx n → ℝ),
  AEMeasurable x μ →
    AEMeasurable y ν →
      MeasureTheory.Measure.map x μ = MeasureTheory.Measure.map y ν →
        MeasureTheory.Measure.map (fun ω => P09SignedDepth.contrast K (x ω)) μ =
          MeasureTheory.Measure.map (fun ω => P09SignedDepth.contrast K (y ω)) ν
@P09SignedDepth.contrast_law_marginal_of_anchored : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω]
  {μ : MeasureTheory.Measure Ω} {d : ℕ} {n : Fin (d + 1) → ℕ} (K : P09SignedDepth.Transport n)
  (x : Ω → P09SignedDepth.Idx n → ℝ),
  AEMeasurable x μ →
    MeasureTheory.Measure.map (fun ω => P09SignedDepth.contrast K (x ω)) μ =
      MeasureTheory.Measure.map (fun y p => y ⟨p.fst.succ, p.snd⟩)
        (MeasureTheory.Measure.map (fun ω => P09SignedDepth.anchored K (x ω)) μ)
P09SignedDepth.n₁ : Fin 3 → ℕ
P09SignedDepth.K₁ : P09SignedDepth.Transport P09SignedDepth.n₁
P09SignedDepth.ones : Matrix (P09SignedDepth.Idx P09SignedDepth.n₁) (P09SignedDepth.Idx P09SignedDepth.n₁) ℝ
P09SignedDepth.ones_contrast_cov_zero : P09SignedDepth.H P09SignedDepth.K₁ * P09SignedDepth.ones *
    (P09SignedDepth.H P09SignedDepth.K₁).transpose =
  0
P09SignedDepth.blockDiag_contrast_cov_00 : (P09SignedDepth.H P09SignedDepth.K₁ *
        P09SignedDepth.blockDiagPart P09SignedDepth.ones *
      (P09SignedDepth.H P09SignedDepth.K₁).transpose)
    ⟨0, 0⟩ ⟨0, 0⟩ =
  2
P09SignedDepth.blockDiag_contrast_cov_01 : (P09SignedDepth.H P09SignedDepth.K₁ *
        P09SignedDepth.blockDiagPart P09SignedDepth.ones *
      (P09SignedDepth.H P09SignedDepth.K₁).transpose)
    ⟨0, 0⟩ ⟨1, 0⟩ =
  -1
P09SignedDepth.dropping_cross_blocks_changes_cov : P09SignedDepth.H P09SignedDepth.K₁ *
      P09SignedDepth.blockDiagPart P09SignedDepth.ones *
    (P09SignedDepth.H P09SignedDepth.K₁).transpose ≠
  P09SignedDepth.H P09SignedDepth.K₁ * P09SignedDepth.ones * (P09SignedDepth.H P09SignedDepth.K₁).transpose
@P09SignedDepth.copy_covMat : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) (Z : Ω → ℝ),
  (P09SignedDepth.covMat μ fun ω x => Z ω) = ProbabilityTheory.covariance Z Z μ • P09SignedDepth.ones
@P09SignedDepth.copy_contrast_cov_zero : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  (Z : Ω → ℝ),
  (P09SignedDepth.H P09SignedDepth.K₁ * P09SignedDepth.covMat μ fun ω x => Z ω) *
      (P09SignedDepth.H P09SignedDepth.K₁).transpose =
    0
@P09SignedDepth.copy_covMat_var : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) (Z : Ω → ℝ),
  AEMeasurable Z μ → (P09SignedDepth.covMat μ fun ω x => Z ω) = ProbabilityTheory.variance Z μ • P09SignedDepth.ones
@P09SignedDepth.copy_blockDiag_contrast_cov_00 : ∀ {Ω : Type u_1} [inst : MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) (Z : Ω → ℝ),
  (P09SignedDepth.H P09SignedDepth.K₁ * P09SignedDepth.blockDiagPart (P09SignedDepth.covMat μ fun ω x => Z ω) *
        (P09SignedDepth.H P09SignedDepth.K₁).transpose)
      ⟨0, 0⟩ ⟨0, 0⟩ =
    2 * ProbabilityTheory.covariance Z Z μ
