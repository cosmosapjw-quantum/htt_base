poly p21=((1*g*b1)*(-1*g*b1))+((1+h*b1*b1)*(1+h*b1*b1))+((0+h*b1*b2)*(0+h*b2*b1))+((0+h*b1*b3)*(0+h*b3*b1))-(1);
poly q21=reduce(p21,G);
if (q21 != 0) { print("FAIL residual 21"); print(q21); fail=1; }
poly p22=((1*g*b1)*(-1*g*b2))+((1+h*b1*b1)*(0+h*b1*b2))+((0+h*b1*b2)*(1+h*b2*b2))+((0+h*b1*b3)*(0+h*b3*b2))-(0);
poly q22=reduce(p22,G);
if (q22 != 0) { print("FAIL residual 22"); print(q22); fail=1; }
poly p23=((1*g*b1)*(-1*g*b3))+((1+h*b1*b1)*(0+h*b1*b3))+((0+h*b1*b2)*(0+h*b2*b3))+((0+h*b1*b3)*(1+h*b3*b3))-(0);
poly q23=reduce(p23,G);
if (q23 != 0) { print("FAIL residual 23"); print(q23); fail=1; }
poly p24=((1*g*b2)*g)+((0+h*b2*b1)*(-1*g*b1))+((1+h*b2*b2)*(-1*g*b2))+((0+h*b2*b3)*(-1*g*b3))-(0);
poly q24=reduce(p24,G);
if (q24 != 0) { print("FAIL residual 24"); print(q24); fail=1; }
poly p25=((1*g*b2)*(-1*g*b1))+((0+h*b2*b1)*(1+h*b1*b1))+((1+h*b2*b2)*(0+h*b2*b1))+((0+h*b2*b3)*(0+h*b3*b1))-(0);
poly q25=reduce(p25,G);
