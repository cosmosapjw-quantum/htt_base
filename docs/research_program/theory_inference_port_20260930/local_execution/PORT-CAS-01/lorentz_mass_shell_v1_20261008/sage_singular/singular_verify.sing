// PORT-CAS-01 exact polynomial ideal reductions, Sage-bundled Singular 4.4.1
ring r=0,(b1,b2,b3,g,h),dp;
poly s=b1^2+b2^2+b3^2;
ideal J=g^2*(1-s)-1,h*(g+1)-g^2;
