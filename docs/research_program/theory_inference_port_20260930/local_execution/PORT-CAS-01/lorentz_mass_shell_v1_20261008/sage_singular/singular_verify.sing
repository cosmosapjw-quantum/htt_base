poly q7=reduce(p7,G);
if (q7 != 0) { print("FAIL residual 7"); print(q7); fail=1; }
poly p8=(-1*(1*g*b2)*g)+(1*(0+h*b1*b2)*(1*g*b1))+(1*(1+h*b2*b2)*(1*g*b2))+(1*(0+h*b3*b2)*(1*g*b3))-(0);
poly q8=reduce(p8,G);
if (q8 != 0) { print("FAIL residual 8"); print(q8); fail=1; }
poly p9=(-1*(1*g*b2)*(1*g*b1))+(1*(0+h*b1*b2)*(1+h*b1*b1))+(1*(1+h*b2*b2)*(0+h*b2*b1))+(1*(0+h*b3*b2)*(0+h*b3*b1))-(0);
poly q9=reduce(p9,G);
