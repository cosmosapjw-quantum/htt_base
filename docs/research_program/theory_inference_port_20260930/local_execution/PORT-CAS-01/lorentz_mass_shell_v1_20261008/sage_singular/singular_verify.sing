poly p26=((1*g*b2)*(-1*g*b2))+((0+h*b2*b1)*(0+h*b1*b2))+((1+h*b2*b2)*(1+h*b2*b2))+((0+h*b2*b3)*(0+h*b3*b2))-(1);
