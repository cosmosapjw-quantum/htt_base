poly p11=(-1*(1*g*b2)*(1*g*b3))+(1*(0+h*b1*b2)*(0+h*b1*b3))+(1*(1+h*b2*b2)*(0+h*b2*b3))+(1*(0+h*b3*b2)*(1+h*b3*b3))-(0);
poly q11=reduce(p11,G);
