poly q15=reduce(p15,G);
if (q15 != 0) { print("FAIL residual 15"); print(q15); fail=1; }
poly p16=(g*g)+((1*g*b1)*(-1*g*b1))+((1*g*b2)*(-1*g*b2))+((1*g*b3)*(-1*g*b3))-(1);
