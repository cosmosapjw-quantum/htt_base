'P06ASphere.measurable_dens' depends on axioms: [propext, Classical.choice, Quot.sound]
@key_identity : ∀ {b1 b2 b3 : ℝ} (hb : s b1 b2 b3 < 1) (A : Set ↑S2),
  MeasurableSet A → σS A = ∫⁻ (n : ↑S2) in aberrS hb ⁻¹' A, dens b1 b2 b3 n ∂σS
'P06ASphere.key_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
@aberr_pushforward : ∀ {b1 b2 b3 : ℝ} (hb : s b1 b2 b3 < 1),
  Measure.map (aberrS hb) (σS.withDensity (dens b1 b2 b3)) = σS
'P06ASphere.aberr_pushforward' depends on axioms: [propext, Classical.choice, Quot.sound]
@aberr_integral : ∀ {b1 b2 b3 : ℝ} (hb : s b1 b2 b3 < 1) {g : ↑S2 → ℝ},
  Continuous g → ∫ (n : ↑S2), g (aberrS hb n) * (dopS b1 b2 b3 ↑n ^ 2)⁻¹ ∂σS = ∫ (n : ↑S2), g n ∂σS
'P06ASphere.aberr_integral' depends on axioms: [propext, Classical.choice, Quot.sound]
@solidAngleNew_eq : ∀ {b1 b2 b3 : ℝ} (hb : s b1 b2 b3 < 1),
  solidAngleNew hb = σS.withDensity (dens b1 b2 b3) ∧
    ∀ (A : Set ↑S2),
      MeasurableSet A →
        (solidAngleNew hb) A = σS (aberrS hb '' A) ∧ σS (aberrS hb '' A) = ∫⁻ (n : ↑S2) in A, dens b1 b2 b3 n ∂σS
'P06ASphere.solidAngleNew_eq' depends on axioms: [propext, Classical.choice, Quot.sound]
@areaDist_scale : ∀ {D : ℝ},
  0 < D → ∀ (dS dΩ : ℝ), areaDist dS ((D ^ 2)⁻¹ * dΩ) = PORTCAS06EndpointScalarInvariant.dANew (areaDist dS dΩ) D
'P06ASphere.areaDist_scale' depends on axioms: [propext, Classical.choice, Quot.sound]
@areaDist_sphere : ∀ {b1 b2 b3 : ℝ} (hb : s b1 b2 b3 < 1) (dS dΩ : ℝ),
  ∀ᵐ (n : ↑S2) ∂σS,
    areaDist dS (((solidAngleNew hb).rnDeriv σS n).toReal * dΩ) =
      PORTCAS06EndpointScalarInvariant.dANew (areaDist dS dΩ) (dopS b1 b2 b3 ↑n)
'P06ASphere.areaDist_sphere' depends on axioms: [propext, Classical.choice, Quot.sound]
@endpoint_optical_sphere : ∀ {b1 b2 b3 : ℝ} (hb : s b1 b2 b3 < 1) {E Es dS dΩ : ℝ},
  0 < E →
    ∀ᵐ (n : ↑S2) ∂σS,
      redshiftOf Es (energy (fourVelocity b1 b2 b3) (photon E ((↑n).ofLp 0) ((↑n).ofLp 1) ((↑n).ofLp 2))) =
          PORTCAS06EndpointScalarInvariant.zNew
            (redshiftOf Es (energy e0 (photon E ((↑n).ofLp 0) ((↑n).ofLp 1) ((↑n).ofLp 2)))) (dopS b1 b2 b3 ↑n) ∧
        areaDist dS (((solidAngleNew hb).rnDeriv σS n).toReal * dΩ) =
            PORTCAS06EndpointScalarInvariant.dANew (areaDist dS dΩ) (dopS b1 b2 b3 ↑n) ∧
          (1 + redshiftOf Es (energy (fourVelocity b1 b2 b3) (photon E ((↑n).ofLp 0) ((↑n).ofLp 1) ((↑n).ofLp 2)))) *
              areaDist dS (((solidAngleNew hb).rnDeriv σS n).toReal * dΩ) =
            (1 + redshiftOf Es (energy e0 (photon E ((↑n).ofLp 0) ((↑n).ofLp 1) ((↑n).ofLp 2)))) * areaDist dS dΩ
'P06ASphere.endpoint_optical_sphere' depends on axioms: [propext, Classical.choice, Quot.sound]
beta_zero_admissible : s 0 0 0 < 1
'P06ASphere.beta_zero_admissible' depends on axioms: [propext, Classical.choice, Quot.sound]
@endpoint_optical_sphere_beta_zero : ∀ {E Es dS dΩ : ℝ},
  0 < E →
    (∀ (n : ↑S2), aberrS beta_zero_admissible n = n) ∧
      solidAngleNew beta_zero_admissible = σS ∧
        ∀ᵐ (n : ↑S2) ∂σS,
          redshiftOf Es (energy (fourVelocity 0 0 0) (photon E ((↑n).ofLp 0) ((↑n).ofLp 1) ((↑n).ofLp 2))) =
              redshiftOf Es (energy e0 (photon E ((↑n).ofLp 0) ((↑n).ofLp 1) ((↑n).ofLp 2))) ∧
            areaDist dS (((solidAngleNew beta_zero_admissible).rnDeriv σS n).toReal * dΩ) = areaDist dS dΩ ∧
              (1 + redshiftOf Es (energy (fourVelocity 0 0 0) (photon E ((↑n).ofLp 0) ((↑n).ofLp 1) ((↑n).ofLp 2)))) *
                  areaDist dS (((solidAngleNew beta_zero_admissible).rnDeriv σS n).toReal * dΩ) =
                (1 + redshiftOf Es (energy e0 (photon E ((↑n).ofLp 0) ((↑n).ofLp 1) ((↑n).ofLp 2)))) * areaDist dS dΩ
'P06ASphere.endpoint_optical_sphere_beta_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
