'P06ASphere.coneMap_injOn' depends on axioms: [propext, Classical.choice, Quot.sound]
@hasFDerivAt_norm3 : ∀ {x : E3}, x ≠ 0 → HasFDerivAt (fun y => ‖y‖) (‖x‖⁻¹ • (innerSL ℝ) x) x
'P06ASphere.hasFDerivAt_norm3' depends on axioms: [propext, Classical.choice, Quot.sound]
