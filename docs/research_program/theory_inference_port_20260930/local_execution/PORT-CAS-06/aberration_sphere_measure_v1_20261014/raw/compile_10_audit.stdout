coneDeriv_eq : ∀ (b1 b2 b3 : ℝ) (x : E3),
  coneDeriv b1 b2 b3 x =
    ContinuousLinearMap.id ℝ E3 +
      ((innerSL ℝ) ((gamma b1 b2 b3 * ‖x‖⁻¹) • x + h b1 b2 b3 • bvec b1 b2 b3)).smulRight (bvec b1 b2 b3)
'P06ASphere.coneDeriv_eq' depends on axioms: [propext, Classical.choice, Quot.sound]
@coneMap_jacobian : ∀ {b1 b2 b3 : ℝ},
  s b1 b2 b3 < 1 →
    ∀ {x : E3},
      x ≠ 0 →
        HasFDerivAt (coneMap b1 b2 b3) (coneDeriv b1 b2 b3 x) x ∧ (coneDeriv b1 b2 b3 x).det = dopS b1 b2 b3 (‖x‖⁻¹ • x)
'P06ASphere.coneMap_jacobian' depends on axioms: [propext, Classical.choice, Quot.sound]
@aberrS_coe : ∀ {b1 b2 b3 : ℝ} (hb : s b1 b2 b3 < 1) (n : ↑S2), ↑(aberrS hb n) = aberrV b1 b2 b3 ↑n
'P06ASphere.aberrS_coe' depends on axioms: [propext, Classical.choice, Quot.sound]
@aberrS_inv_gen : ∀ {b1 b2 b3 c1 c2 c3 : ℝ} (hb : s b1 b2 b3 < 1) (hc : s c1 c2 c3 < 1),
  c1 = -b1 → c2 = -b2 → c3 = -b3 → ∀ (n : ↑S2), aberrS hc (aberrS hb n) = n
'P06ASphere.aberrS_inv_gen' depends on axioms: [propext, Classical.choice, Quot.sound]
@aberrS_left : ∀ {b1 b2 b3 : ℝ} (hb : s b1 b2 b3 < 1) (n : ↑S2), aberrS ⋯ (aberrS hb n) = n
'P06ASphere.aberrS_left' depends on axioms: [propext, Classical.choice, Quot.sound]
@aberrS_right : ∀ {b1 b2 b3 : ℝ} (hb : s b1 b2 b3 < 1) (n : ↑S2), aberrS hb (aberrS ⋯ n) = n
'P06ASphere.aberrS_right' depends on axioms: [propext, Classical.choice, Quot.sound]
continuous_coneMap : ∀ (b1 b2 b3 : ℝ), Continuous (coneMap b1 b2 b3)
'P06ASphere.continuous_coneMap' depends on axioms: [propext, Classical.choice, Quot.sound]
@aberrS_continuous : ∀ {b1 b2 b3 : ℝ} (hb : s b1 b2 b3 < 1), Continuous (aberrS hb)
'P06ASphere.aberrS_continuous' depends on axioms: [propext, Classical.choice, Quot.sound]
