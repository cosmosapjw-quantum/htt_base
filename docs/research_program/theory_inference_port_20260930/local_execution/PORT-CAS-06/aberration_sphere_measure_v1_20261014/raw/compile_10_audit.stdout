'P06ASphere.coneMap_hasFDerivAt' depends on axioms: [propext, Classical.choice, Quot.sound]
det_rank_one : ∀ (w v : E3), (ContinuousLinearMap.id ℝ E3 + ((innerSL ℝ) w).smulRight v).det = 1 + inner ℝ w v
