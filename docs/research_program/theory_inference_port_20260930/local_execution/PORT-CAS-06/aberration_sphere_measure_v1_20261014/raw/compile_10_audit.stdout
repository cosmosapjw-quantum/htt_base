coneMap_smul : ∀ (b1 b2 b3 : ℝ) {c : ℝ}, 0 ≤ c → ∀ (x : E3), coneMap b1 b2 b3 (c • x) = c • coneMap b1 b2 b3 x
'P06ASphere.coneMap_smul' depends on axioms: [propext, Classical.choice, Quot.sound]
@coneMap_sphere : ∀ {b1 b2 b3 : ℝ} (hb : s b1 b2 b3 < 1) (n : ↑S2),
  coneMap b1 b2 b3 ↑n = dopS b1 b2 b3 ↑n • ↑(aberrS hb n)
'P06ASphere.coneMap_sphere' depends on axioms: [propext, Classical.choice, Quot.sound]
