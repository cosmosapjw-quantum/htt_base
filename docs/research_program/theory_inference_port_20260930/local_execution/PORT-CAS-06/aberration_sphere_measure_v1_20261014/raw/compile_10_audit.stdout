bvec_neg : ∀ (b1 b2 b3 : ℝ), bvec (-b1) (-b2) (-b3) = -bvec b1 b2 b3
'P06ASphere.bvec_neg' depends on axioms: [propext, Classical.choice, Quot.sound]
