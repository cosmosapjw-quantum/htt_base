'P06ASphere.aberrS_bijective' depends on axioms: [propext, Classical.choice, Quot.sound]
lintegral_polar : ∀ (f : E3 → ENNReal),
  ∫⁻ (x : E3) in {0}ᶜ, f x = ∫⁻ (p : ↑S2 × ↑(Set.Ioi 0)), f (↑p.2 • ↑p.1) ∂σS.prod (Measure.volumeIoiPow 2)
'P06ASphere.lintegral_polar' depends on axioms: [propext, Classical.choice, Quot.sound]
@radial_Iio : ∀ {c : ℝ}, 0 < c → (Measure.volumeIoiPow 2) {r | ↑r * c < 1} = ENNReal.ofReal (c⁻¹ ^ 3 / 3)
'P06ASphere.radial_Iio' depends on axioms: [propext, Classical.choice, Quot.sound]
radial_one : (Measure.volumeIoiPow 2) (Set.Iio ⟨1, ⋯⟩) = ENNReal.ofReal (1 / 3)
'P06ASphere.radial_one' depends on axioms: [propext, Classical.choice, Quot.sound]
mem_coneSet_smul : ∀ (A : Set ↑S2) {c : ℝ}, 0 < c → ∀ (m : ↑S2), c • ↑m ∈ coneSet A ↔ m ∈ A ∧ c < 1
'P06ASphere.mem_coneSet_smul' depends on axioms: [propext, Classical.choice, Quot.sound]
@ind_congr : ∀ {α : Type u_1} {β : Type u_2} {S : Set α} {T : Set β} {a : α} {b : β},
