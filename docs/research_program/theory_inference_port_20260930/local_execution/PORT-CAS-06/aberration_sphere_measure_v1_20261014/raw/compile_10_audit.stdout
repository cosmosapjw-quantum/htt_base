'P06ASphere.coneMap_norm' depends on axioms: [propext, Classical.choice, Quot.sound]
@coneMap_inv : ∀ {b1 b2 b3 : ℝ}, s b1 b2 b3 < 1 → ∀ (x : E3), coneMap (-b1) (-b2) (-b3) (coneMap b1 b2 b3 x) = x
'P06ASphere.coneMap_inv' depends on axioms: [propext, Classical.choice, Quot.sound]
@coneMap_inv' : ∀ {b1 b2 b3 : ℝ}, s b1 b2 b3 < 1 → ∀ (y : E3), coneMap b1 b2 b3 (coneMap (-b1) (-b2) (-b3) y) = y
'P06ASphere.coneMap_inv'' depends on axioms: [propext, Classical.choice, Quot.sound]
@coneMap_image : ∀ {b1 b2 b3 : ℝ}, s b1 b2 b3 < 1 → coneMap b1 b2 b3 '' {0}ᶜ = {0}ᶜ
'P06ASphere.coneMap_image' depends on axioms: [propext, Classical.choice, Quot.sound]
