    (∀ (i : Fin 4), DifferentiableAt ℝ (h i) x) →
      ∀ (a : Fin 4), pd (fun y => ∑ i, f i y * h i y) x a = ∑ i, (f i x * pd (h i) x a + h i x * pd (f i) x a)
'PORTCAS03VelocityJetDecomposition.pd_sum_mul' depends on axioms: [propext, Classical.choice, Quot.sound]
