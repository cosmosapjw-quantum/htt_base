@kinematics_in_Q : ∀ {g ginv : Matrix (Fin 4) (Fin 4) ℝ} {u : Fin 4 → ℝ},
  g.transpose = g →
    g * ginv = 1 →
      u ⬝ᵥ g.mulVec u = -1 →
        ∀ (c : ℝ) (D : Matrix (Fin 4) (Fin 4) ℝ),
          expansion c ginv g u D = contract ginv (spatialJet g u (c • D)) ∧
            expansion c ginv g u D = contract (hUp ginv u) (c • D) ∧
              shear c ginv g u D = symPart (spatialJet g u (c • D)) - (expansion c ginv g u D / 3) • hDown g u ∧
                vorticity c g u D = skewPart (spatialJet g u (c • D)) ∧
                  acceleration c u D = Matrix.vecMul (c • u) (c • D)
'PORTCAS03VelocityJetDecomposition.kinematics_in_Q' depends on axioms: [propext, Classical.choice, Quot.sound]
@D_eq_inv_smul_Q : ∀ {c : ℝ}, 0 < c → ∀ (D : Matrix (Fin 4) (Fin 4) ℝ), D = c⁻¹ • c • D
'PORTCAS03VelocityJetDecomposition.D_eq_inv_smul_Q' depends on axioms: [propext, Classical.choice, Quot.sound]
@pointwise_kinematics : ∀ {g ginv : Matrix (Fin 4) (Fin 4) ℝ} {u : Fin 4 → ℝ},
  g.transpose = g →
    g * ginv = 1 →
      u ⬝ᵥ g.mulVec u = -1 →
        ∀ {c : ℝ},
          0 < c →
            ∀ (D : Matrix (Fin 4) (Fin 4) ℝ),
              D.mulVec u = 0 →
                expansion c ginv g u D = c * contract (hUp ginv u) D ∧
                  expansion c ginv g u D = c * contract ginv D ∧
                    c • spatialJet g u D =
                        shear c ginv g u D + (expansion c ginv g u D / 3) • hDown g u + vorticity c g u D ∧
                      (shear c ginv g u D).transpose = shear c ginv g u D ∧
                        contract ginv (shear c ginv g u D) = 0 ∧
                          (shear c ginv g u D).mulVec u = 0 ∧
                            Matrix.vecMul u (shear c ginv g u D) = 0 ∧
                              (vorticity c g u D).transpose = -vorticity c g u D ∧
                                (vorticity c g u D).mulVec u = 0 ∧
                                  Matrix.vecMul u (vorticity c g u D) = 0 ∧
                                    metricInner ginv (shear c ginv g u D) (vorticity c g u D) = 0 ∧
                                      metricInner ginv (shear c ginv g u D) (hDown g u) = 0 ∧
                                        metricInner ginv (vorticity c g u D) (hDown g u) = 0 ∧
                                          u ⬝ᵥ acceleration c u D = 0 ∧
                                            c ^ 2 • D =
                                                c •
                                                    (shear c ginv g u D + (expansion c ginv g u D / 3) • hDown g u +
                                                      vorticity c g u D) -
                                                  Matrix.vecMulVec (g.mulVec u) (acceleration c u D) ∧
                                              D = c⁻¹ • c • D
'PORTCAS03VelocityJetDecomposition.pointwise_kinematics' depends on axioms: [propext, Classical.choice, Quot.sound]
