'PORTCAS03VelocityJetDecomposition.velJet_mulVec_u' depends on axioms: [propext, Classical.choice, Quot.sound]
@velJetMatrix_smul : ∀ {Γ : Pt → Fin 4 → Fin 4 → Fin 4 → ℝ} {g : Pt → Matrix (Fin 4) (Fin 4) ℝ} {u : Pt → Fin 4 → ℝ}
  {x : Pt}, FieldDiffAt g u x → ∀ (c : ℝ), velJetMatrix Γ g (fun y => c • u y) x = c • velJetMatrix Γ g u x
'PORTCAS03VelocityJetDecomposition.velJetMatrix_smul' depends on axioms: [propext, Classical.choice, Quot.sound]
@velocity_jet_kinematics : ∀ {Γ : Pt → Fin 4 → Fin 4 → Fin 4 → ℝ} {g : Pt → Matrix (Fin 4) (Fin 4) ℝ}
  {u : Pt → Fin 4 → ℝ} {x : Pt} {ginv : Matrix (Fin 4) (Fin 4) ℝ} {c : ℝ},
  FieldDiffAt g u x →
    MetricCompatibleAt Γ g x →
      (g x).transpose = g x →
        g x * ginv = 1 →
          (∀ᶠ (y : Pt) in nhds x, u y ⬝ᵥ (g y).mulVec (u y) = -1) →
            0 < c →
              (velJetMatrix Γ g u x).mulVec (u x) = 0 ∧
                velJetMatrix Γ g (fun y => c • u y) x = c • velJetMatrix Γ g u x ∧
                  velJetMatrix Γ g u x = c⁻¹ • velJetMatrix Γ g (fun y => c • u y) x ∧
                    expansion c ginv (g x) (u x) (velJetMatrix Γ g u x) =
                        c * contract (hUp ginv (u x)) (velJetMatrix Γ g u x) ∧
                      c • spatialJet (g x) (u x) (velJetMatrix Γ g u x) =
                          shear c ginv (g x) (u x) (velJetMatrix Γ g u x) +
                              (expansion c ginv (g x) (u x) (velJetMatrix Γ g u x) / 3) • hDown (g x) (u x) +
                            vorticity c (g x) (u x) (velJetMatrix Γ g u x) ∧
                        (shear c ginv (g x) (u x) (velJetMatrix Γ g u x)).transpose =
                            shear c ginv (g x) (u x) (velJetMatrix Γ g u x) ∧
                          contract ginv (shear c ginv (g x) (u x) (velJetMatrix Γ g u x)) = 0 ∧
                            (shear c ginv (g x) (u x) (velJetMatrix Γ g u x)).mulVec (u x) = 0 ∧
                              (vorticity c (g x) (u x) (velJetMatrix Γ g u x)).transpose =
                                  -vorticity c (g x) (u x) (velJetMatrix Γ g u x) ∧
                                (vorticity c (g x) (u x) (velJetMatrix Γ g u x)).mulVec (u x) = 0 ∧
                                  u x ⬝ᵥ acceleration c (u x) (velJetMatrix Γ g u x) = 0 ∧
                                    acceleration c (u x) (velJetMatrix Γ g u x) =
                                        Matrix.vecMul (c • u x) (velJetMatrix Γ g (fun y => c • u y) x) ∧
                                      c ^ 2 • velJetMatrix Γ g u x =
                                        c •
                                            (shear c ginv (g x) (u x) (velJetMatrix Γ g u x) +
                                                (expansion c ginv (g x) (u x) (velJetMatrix Γ g u x) / 3) •
                                                  hDown (g x) (u x) +
                                              vorticity c (g x) (u x) (velJetMatrix Γ g u x)) -
                                          Matrix.vecMulVec ((g x).mulVec (u x))
                                            (acceleration c (u x) (velJetMatrix Γ g u x))
'PORTCAS03VelocityJetDecomposition.velocity_jet_kinematics' depends on axioms: [propext, Classical.choice, Quot.sound]
