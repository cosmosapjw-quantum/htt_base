boost_admissible : ∀ (x y z : ℝ),
  PortCas01.s x y z < 1 → PortCas01.fourVelocity x y z ⬝ᵥ PortCas01.eta.mulVec (PortCas01.fourVelocity x y z) = -1
'PORTCAS03VelocityJetDecomposition.boost_admissible' depends on axioms: [propext, Classical.choice, Quot.sound]
boost_kinematics : ∀ (x y z : ℝ),
  PortCas01.s x y z < 1 →
    ∀ {c : ℝ},
      0 < c →
        ∀ (D : Matrix (Fin 4) (Fin 4) ℝ),
          D.mulVec (PortCas01.fourVelocity x y z) = 0 →
            (projUp PortCas01.eta (PortCas01.fourVelocity x y z)).trace = 3 ∧
              (PortCas01.eta * hDown PortCas01.eta (PortCas01.fourVelocity x y z)).trace = 3 ∧
                contract PortCas01.eta (shear c PortCas01.eta PortCas01.eta (PortCas01.fourVelocity x y z) D) = 0 ∧
                  PortCas01.fourVelocity x y z ⬝ᵥ acceleration c (PortCas01.fourVelocity x y z) D = 0 ∧
                    c ^ 2 • D =
                        c •
                            (shear c PortCas01.eta PortCas01.eta (PortCas01.fourVelocity x y z) D +
                                (expansion c PortCas01.eta PortCas01.eta (PortCas01.fourVelocity x y z) D / 3) •
                                  hDown PortCas01.eta (PortCas01.fourVelocity x y z) +
                              vorticity c PortCas01.eta (PortCas01.fourVelocity x y z) D) -
                          Matrix.vecMulVec (PortCas01.eta.mulVec (PortCas01.fourVelocity x y z))
                            (acceleration c (PortCas01.fourVelocity x y z) D) ∧
                      D = c⁻¹ • c • D
'PORTCAS03VelocityJetDecomposition.boost_kinematics' depends on axioms: [propext, Classical.choice, Quot.sound]
