{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GR statistics local CAS return",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "source_publication_commit",
    "local_head",
    "environment",
    "tasks",
    "preserved_scientific_status",
    "publication",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_publication_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "local_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "environment": {
      "type": "object",
      "required": [
        "receipt_path",
        "receipt_sha256",
        "actual_toolchains"
      ],
      "properties": {
        "receipt_path": {
          "type": "string"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "actual_toolchains": {
          "type": "object"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "claim_ids",
          "contract_path",
          "contract_sha256",
          "axes",
          "aggregate_status",
          "closed_mathematical_scope",
          "remaining_analytical_obligations",
          "counterexamples",
          "evidence",
          "failure_class"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contract_path": {
            "type": "string"
          },
          "contract_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "axes": {
            "type": "object",
            "required": [
              "wolfram_xact",
              "sympy",
              "sage_singular",
              "lean"
            ],
            "additionalProperties": {
              "$ref": "#/$defs/axis"
            },
            "minProperties": 4,
            "maxProperties": 4
          },
          "aggregate_status": {
            "enum": [
              "NOT_RUN",
              "CAS_4AXIS_PASS",
              "CAS_PASS_WITH_REGISTERED_EXCEPTION",
              "CAS_CONFLICT",
              "CAS_BLOCKED",
              "CAS_FAIL"
            ]
          },
          "closed_mathematical_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remaining_analytical_obligations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterexamples": {
            "type": "array"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "failure_class": {
            "enum": [
              "none",
              "mathematical",
              "numerical",
              "implementation",
              "runtime_environment",
              "resource",
              "license",
              "missing_input",
              "assumption_misalignment",
              "multiple"
            ]
          }
        }
      }
    },
    "preserved_scientific_status": {
      "type": "object",
      "required": [
        "novelty_promoted",
        "observational_fit_performed",
        "bianchi_identification_promoted",
        "historical_holds_preserved"
      ],
      "properties": {
        "novelty_promoted": {
          "const": false
        },
        "observational_fit_performed": {
          "const": false
        },
        "bianchi_identification_promoted": {
          "const": false
        },
        "historical_holds_preserved": {
          "type": "boolean"
        }
      }
    },
    "publication": {
      "type": "object",
      "required": [
        "committed",
        "pushed",
        "remote_verification_tier"
      ],
      "properties": {
        "committed": {
          "type": "boolean"
        },
        "pushed": {
          "type": "boolean"
        },
        "remote_verification_tier": {
          "enum": [
            "NOT_APPLICABLE",
            "UNVERIFIED",
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "axis": {
      "type": "object",
      "required": [
        "status",
        "observed_toolchain",
        "argv",
        "exit_code",
        "raw_log",
        "statement_alignment",
        "formal_axioms"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_RUN",
            "PASS",
            "FAIL",
            "MISALIGNED_ASSUMPTIONS",
            "BLOCKED_PLATFORM_OR_LICENSE",
            "BLOCKED_PACKAGE_UNAVAILABLE",
            "BLOCKED_RESOURCE_LIMIT",
            "NOT_APPLICABLE_COMPUTATION_CLASS",
            "INCONCLUSIVE"
          ]
        },
        "observed_toolchain": {
          "type": [
            "object",
            "null"
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "raw_log": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement_alignment": {
          "enum": [
            "EXACT",
            "WEAKER",
            "MISALIGNED",
            "UNREVIEWED"
          ]
        },
        "formal_axioms": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
