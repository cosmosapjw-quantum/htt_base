'CAS11C02.finiteGramForward' depends on axioms: [propext, Classical.choice, Quot.sound]
theorem CAS11C02.finiteGramForward : ∀ {n : ℕ},
  0 < n →
    ∀ (R : Matrix (Fin n) (Fin n) ℝ) (hR : R.PosSemidef) (e : Fin n → ℝ) (ε : ℝ),
      0 ≤ ε →
        (∀ (a : Fin n → ℝ), (a ⬝ᵥ e) ^ 2 ≤ 2 * ε * a ⬝ᵥ R *ᵥ a) →
          R.PosSemidef ∧ e ∈ (toLin' R).range ∧ e ⬝ᵥ spectralPinvMatrix R ⋯ *ᵥ e ≤ 2 * ε :=
fun {n} _hn R hR e ε hε hbound =>
  let T := toEuclideanLin R;
  have hT := isSymmetric_toEuclideanLin_iff.mpr (PosSemidef.isHermitian hR);
  have hP := isPositive_toEuclideanLin_iff.mpr hR;
  have hbound' := fun a =>
    have ha := hbound a.ofLp;
    Eq.mpr
      (id
        (Eq.trans
          (congr (congrArg LE.le (congrFun' (congrArg HPow.hPow (congrArg (dotProduct e) (star_trivial a.ofLp))) 2))
            (congrArg (HMul.hMul (2 * ε))
              (Eq.trans (congrArg (dotProduct (R *ᵥ a.ofLp)) (star_trivial a.ofLp))
                (dotProduct_comm (R *ᵥ a.ofLp) a.ofLp))))
          ge_iff_le._simp_1))
      (Eq.mp
        (congrFun' (congrArg LE.le (congrFun' (congrArg HPow.hPow (dotProduct_comm a.ofLp e)) 2))
          (2 * ε * a.ofLp ⬝ᵥ R *ᵥ a.ofLp))
        ha);
  And.casesOn (finiteGramForwardAbstract hT (LinearMap.IsPositive.inner_nonneg_right hP) (WithLp.toLp 2 e) ε hε hbound')
    fun hrange henergy =>
    ⟨hR,
      ⟨Exists.casesOn hrange fun x hx =>
          Exists.intro x.ofLp
            (have hh := congrArg WithLp.ofLp hx;
            id hh),
        have hM :=
          of_eq_true
            (Eq.trans
              (congrFun'
                (congrArg Eq
                  (LinearEquiv.apply_symm_apply toEuclideanLin
                    (spectralPinvLin (spectralPinvMatrix._proof_3 R (PosSemidef.isHermitian hR)))))
                (spectralPinvLin hT))
              (eq_self (spectralPinvLin (spectralPinvMatrix._proof_3 R (PosSemidef.isHermitian hR)))));
        have hvec :=
          have hh := congrArg WithLp.ofLp (congrArg (fun f => f (WithLp.toLp 2 e)) hM);
          id
            (Eq.mp
              (congrArg (Eq (spectralPinvMatrix R (PosSemidef.isHermitian hR) *ᵥ e))
                (congrArg WithLp.ofLp (spectralPinvLin_apply hT (WithLp.toLp 2 e))))
              hh);
        Eq.mpr (id (congrArg (fun _a => e ⬝ᵥ _a ≤ 2 * ε) hvec))
          (Eq.mpr (id ge_iff_le._simp_1)
            (Eq.mp
              (congrFun'
                (congrArg LE.le
                  (Eq.trans (congrArg (dotProduct (spectralPinvVec hT (WithLp.toLp 2 e)).ofLp) (star_trivial e))
                    (dotProduct_comm (spectralPinvVec hT (WithLp.toLp 2 e)).ofLp e)))
                (2 * ε))
              henergy))⟩⟩
