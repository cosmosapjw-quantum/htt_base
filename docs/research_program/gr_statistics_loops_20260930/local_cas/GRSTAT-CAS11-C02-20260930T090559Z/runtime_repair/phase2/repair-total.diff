+        launch = self.store.register_launch(repo_root=self.f.repo, worktree_root=self.f.repo,
+            run_id='same-run', task_id='same-task', session_id='s', task_name='author',
+            profile={'model': 'gpt-6-sol', 'effort': 'high',
+                     'profile_id': 'cuhg_gpt6_sol_worker',
+                     'sandbox_policy': {'type': 'danger-full-access'}})
+        self.id = launch['launch_id']
+        self.store.claim_launch(self.id, session_id='s', tool_use_id='original-spawn')
+        self.transcript = self.f.root / 'author.jsonl'
+        self.rows = [
+            {'type': 'session_meta', 'payload': {'id': 'child', 'source': {'subagent': {
+                'thread_spawn': {'parent_thread_id': 's', 'agent_path': '/root/author',
+                                 'agent_role': 'cuhg_gpt6_sol_worker'}}}}},
+            {'type': 'turn_context', 'payload': {'turn_id': 'old', 'model': 'gpt-6-sol',
+                'effort': 'high', 'cwd': str(self.f.repo),
+                'sandbox_policy': {'type': 'danger-full-access'}}},
