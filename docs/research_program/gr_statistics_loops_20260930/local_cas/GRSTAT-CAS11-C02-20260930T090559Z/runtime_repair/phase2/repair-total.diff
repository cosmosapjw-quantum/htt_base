+    def test_one_consumption_until_real_stop_preserves_all_history(self):
+        self.consume()
+        for tool in ('followup-1', 'followup-2'):
+            with self.assertRaises(CuhError):
+                self.consume(tool)
+        self.finish(stop=False)
+        with self.assertRaisesRegex(CuhError, 'NOT_ENDED'):
+            self.consume('followup-2')
+        self.store.child_exit(session_id='s', child_id='child', event=self.stop_event('new'))
+        returned = author.record_return(**self.args())
+        before = self.store.path.read_bytes()
+        self.assertEqual(author.record_return(**self.args()), returned)
+        self.assertEqual(self.store.path.read_bytes(), before)
+        self.assertEqual(returned['return']['additional_tokens'], 10000)
+        self.consume('followup-2')
+        state = json.loads(self.store.path.read_text())
+        history = state['direct_author_continuations'][self.id]
+        self.assertEqual(len(history), 2)
