+    def finish(self, tokens=580219, turn='new', stop=True):
+        context = copy.deepcopy(self.rows[1])
+        context['payload']['turn_id'] = turn
+        self.rows.extend([context,
+            {'type': 'event_msg', 'payload': {'type': 'task_started', 'turn_id': turn}},
+            {'type': 'event_msg', 'payload': {'type': 'token_count',
+                'info': {'total_token_usage': {'total_tokens': tokens}}}},
+            {'type': 'event_msg', 'payload': {'type': 'task_complete', 'turn_id': turn}}])
+        self.write()
+        if stop:
+            self.store.child_exit(session_id='s', child_id='child', event=self.stop_event(turn))
