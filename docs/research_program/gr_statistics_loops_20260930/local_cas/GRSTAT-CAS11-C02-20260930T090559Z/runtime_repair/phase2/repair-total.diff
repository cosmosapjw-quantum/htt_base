+        self.write()
+        event = self.stop_event('old')
+        self.store.bind_child(session_id='s', child_id='child', event=event)
+        self.store.child_exit(session_id='s', child_id='child', event=event)
+        self.original = self.store.get_launch(self.id)
+
+    def write(self):
+        self.transcript.write_text('\n'.join(json.dumps(row) for row in self.rows) + '\n')
+
+    def stop_event(self, turn):
+        return {'cwd': str(self.f.repo), 'turn_id': turn,
+                'transcript_path': str(self.transcript), 'model': 'gpt-6-sol', 'effort': 'high'}
+
+    def event(self, **updates):
+        event = self.f.event('PreToolUse', tool_name='collaborationfollowup_task',
+            tool_use_id='followup-1', tool_input={'target': '/root/author',
+                'message': 'Continue the same bounded registered author task.'})
+        return {**event, **updates}
+
+    def args(self, **updates):
+        return dict(root=self.f.state, launch_id=self.id, session_id='s', child_id='child',
+                    client_cwd=str(self.f.repo), **updates)
