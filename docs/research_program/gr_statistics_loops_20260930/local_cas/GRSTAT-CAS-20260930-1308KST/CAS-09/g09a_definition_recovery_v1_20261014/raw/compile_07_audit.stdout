        ∀ᶠ (x : G09A.PhysPar) in nhds xstar,
          x ∈ S ∧
            G09A.Omega5 P c dir x r (G09A.rhoOf dir r c (G09A.nativeZ dir r c xstar ρstar) x) ∧
              G09A.nativeZ dir r c x (G09A.rhoOf dir r c (G09A.nativeZ dir r c xstar ρstar) x) =
                G09A.nativeZ dir r c xstar ρstar
'G09A.strict_slack_local_identification' depends on axioms: [propext, Classical.choice, Quot.sound]
G09A.slack_boundary_no_neighbourhood : (∀ (i : Fin 1),
    |G09A.ρ0 i| = G09A.E5 G09A.P0 1 (G09A.Hval G09A.x0.2 (G09A.dir0 i)) (G09A.r0 i)) ∧
  ¬∀ᶠ (x : G09A.PhysPar) in nhds G09A.x0,
      G09A.Omega5 G09A.P0 1 G09A.dir0 x G09A.r0
        (G09A.rhoOf G09A.dir0 G09A.r0 1 (G09A.nativeZ G09A.dir0 G09A.r0 1 G09A.x0 G09A.ρ0) x)
'G09A.slack_boundary_no_neighbourhood' depends on axioms: [propext, Classical.choice, Quot.sound]
