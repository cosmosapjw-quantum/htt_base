    Trans.trans
      (Trans.trans
        (Eq.mpr
          (id
            (congrArg (fun _a => Polynomial.eval x ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n)) = _a)
              (Eq.symm
                (mul_assoc ((-4) ^ n) ((-1 / 4) ^ n)
                  (Polynomial.eval x ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n)))))))
          (Eq.mpr
            (id
              (congrArg
                (fun _a =>
                  Polynomial.eval x ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n)) =
                    _a * Polynomial.eval x ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n)))
                hc))
            (Eq.mpr
              (id
                (congrArg (fun _a => Polynomial.eval x ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n)) = _a)
                  (one_mul (Polynomial.eval x ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n))))))
              (Eq.refl (Polynomial.eval x ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n)))))))
        (Eq.mpr
          (eq_of_heq
            ((fun α a a_1 a' e'_3 =>
                Eq.casesOn (motive := fun a_2 x => a' = a_2 → e'_3 ≍ x → (a = a_1) ≍ (a = a')) e'_3
                  (fun h =>
                    Eq.ndrec (motive := fun a' => ∀ (e_3 : a_1 = a'), e_3 ≍ Eq.refl a_1 → (a = a_1) ≍ (a = a'))
                      (fun e_3 h => HEq.refl (a = a_1)) (Eq.symm h) e'_3)
                  (Eq.refl a') (HEq.refl e'_3))
              ℝ
              ((-4) ^ n *
                ((-1 / 4) ^ n * Polynomial.eval x ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n))))
              ((-4) ^ n * ((1 / 2) ^ n * (↑n.factorial * Polynomial.eval ((x + 1) / 2) (CAS12Affine.shifted n))))
              ((-4) ^ n * ((1 / 2) ^ n * (↑n.factorial * Polynomial.eval (1 / 2 * x + 1 / 2) (CAS12Affine.shifted n))))
              (of_eq_true
                (Eq.trans
                  (congr
                    (congrArg Eq
                      (Eq.trans
                        (Mathlib.Tactic.Ring.Common.mul_congr
                          (Mathlib.Tactic.Ring.Common.pow_congr
                            (Mathlib.Tactic.Ring.Common.neg_congr
                              (Mathlib.Tactic.Ring.cast_pos (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 4)))
                              (Mathlib.Tactic.Ring.Common.neg_add
