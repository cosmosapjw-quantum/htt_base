CAS12ConventionalRodrigues.standardLift_eq_rodrigues (n : ℕ) (x : ℝ) :
  CAS12SignNormalization.standardLift n x =
    Polynomial.eval x ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n)) / (2 ^ n * ↑n.factorial)
CAS12ConventionalRodrigues.scalar_thomson_rodrigues_moment (n : ℕ) :
  2 * Real.pi *
      ∫ (mu : ℝ) in -1..1,
        3 * (1 + mu ^ 2) / (16 * Real.pi) *
          (Polynomial.eval mu ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n)) / (2 ^ n * ↑n.factorial)) =
    if n = 0 then 1 else if n = 2 then 1 / 10 else 0
theorem CAS12ConventionalRodrigues.standardLift_eq_rodrigues : ∀ (n : ℕ) (x : ℝ),
  CAS12SignNormalization.standardLift n x =
    Polynomial.eval x ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n)) / (2 ^ n * ↑n.factorial) :=
fun n x =>
  have h :=
    CAS12ConventionalRodrigues.iterate_derivative_comp_affine✝ (Polynomial.X ^ n * (1 - Polynomial.X) ^ n) (1 / 2)
      (1 / 2) n;
  have he :=
    congrArg (fun p => Polynomial.eval x p)
      (Eq.mp
        (congrArg
          (fun _a =>
            Polynomial.C ((-1 / 4) ^ n) * (⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n) =
              Polynomial.C ((1 / 2) ^ n) * _a.comp (Polynomial.C (1 / 2) * Polynomial.X + Polynomial.C (1 / 2)))
          (Eq.symm (CAS12ConventionalRodrigues.shifted_rodrigues✝ n)))
        (Eq.mp
          (congrArg
            (fun _a =>
              _a =
                Polynomial.C ((1 / 2) ^ n) *
                  ((⇑Polynomial.derivative)^[n] (Polynomial.X ^ n * (1 - Polynomial.X) ^ n)).comp
                    (Polynomial.C (1 / 2) * Polynomial.X + Polynomial.C (1 / 2)))
            (Polynomial.iterate_derivative_C_mul ((-1 / 4) ^ n) ((Polynomial.X ^ 2 - 1) ^ n) n))
          (Eq.mp
            (congrArg
              (fun _a =>
                (⇑Polynomial.derivative)^[n] _a =
                  Polynomial.C ((1 / 2) ^ n) *
                    ((⇑Polynomial.derivative)^[n] (Polynomial.X ^ n * (1 - Polynomial.X) ^ n)).comp
                      (Polynomial.C (1 / 2) * Polynomial.X + Polynomial.C (1 / 2)))
              (CAS12ConventionalRodrigues.rodrigues_seed_comp✝ n))
            h)));
  have hc :=
    Eq.mpr (id (congrArg (fun _a => _a = 1) (Eq.symm (mul_pow (-4) (-1 / 4) n))))
      (of_eq_true
        (Eq.trans
          (Eq.trans
            (congrFun'
              (congrArg Eq
                (Eq.trans
                  (congrFun'
                    (congrArg HPow.hPow
                      (Mathlib.Meta.NormNum.IsNat.to_eq
                        (Mathlib.Meta.NormNum.IsInt.to_isNat
                          (Mathlib.Meta.NormNum.IsRat.to_isInt
                            (Mathlib.Meta.NormNum.isRat_mul (Eq.refl HMul.hMul)
                              (Mathlib.Meta.NormNum.IsInt.to_isRat
                                (Mathlib.Meta.NormNum.isInt_neg (Eq.refl Neg.neg)
                                  (Mathlib.Meta.NormNum.IsNat.to_isInt (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 4)))
                                  (Eq.refl (Int.negOfNat 4))))
                              (Mathlib.Meta.NormNum.isRat_div
                                (Mathlib.Meta.NormNum.isRat_mul (Eq.refl HMul.hMul)
                                  (Mathlib.Meta.NormNum.IsInt.to_isRat
                                    (Mathlib.Meta.NormNum.isInt_neg (Eq.refl Neg.neg)
                                      (Mathlib.Meta.NormNum.IsNat.to_isInt
                                        (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one))
                                      (Eq.refl (Int.negOfNat 1))))
                                  (Mathlib.Meta.NormNum.IsNNRat.to_isRat
                                    (Mathlib.Meta.NormNum.isNNRat_inv_pos
                                      (Mathlib.Meta.NormNum.IsNat.to_isNNRat
                                        (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 4)))))
                                  (Eq.refl ((Int.negOfNat 1).mul (Int.ofNat 1))) (Eq.refl 4)))
                              (Eq.refl ((Int.negOfNat 4).mul (Int.negOfNat 1))) (Eq.refl 4))))
                        Nat.cast_one))
                    n)
                  (one_pow n)))
              1)
            (eq_self 1))
          (eq_true True.intro)));
  have hs :=
    Eq.mpr (id (congrArg (fun _a => _a = (-1) ^ n * 2 ^ n) (Eq.symm (mul_pow (-4) (1 / 2) n))))
      (Eq.mpr (id (congrArg (fun _a => (-4 * (1 / 2)) ^ n = _a) (Eq.symm (mul_pow (-1) 2 n))))
        (of_eq_true
          (Eq.trans
            (Eq.trans
              (congr
                (congrArg Eq
                  (congrFun'
                    (congrArg HPow.hPow
                      (Mathlib.Meta.NormNum.IsInt.neg_to_eq
                        (Mathlib.Meta.NormNum.IsRat.to_isInt
                          (Mathlib.Meta.NormNum.isRat_mul (Eq.refl HMul.hMul)
                            (Mathlib.Meta.NormNum.IsInt.to_isRat
                              (Mathlib.Meta.NormNum.isInt_neg (Eq.refl Neg.neg)
                                (Mathlib.Meta.NormNum.IsNat.to_isInt (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 4)))
                                (Eq.refl (Int.negOfNat 4))))
                            (Mathlib.Meta.NormNum.IsNNRat.to_isRat
                              (Mathlib.Meta.NormNum.isNNRat_div
                                (Mathlib.Meta.NormNum.isNNRat_mul (Eq.refl HMul.hMul)
                                  (Mathlib.Meta.NormNum.IsNat.to_isNNRat
                                    (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one))
                                  (Mathlib.Meta.NormNum.isNNRat_inv_pos
                                    (Mathlib.Meta.NormNum.IsNat.to_isNNRat
                                      (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2))))
                                  (Eq.refl (Nat.mul 1 1)) (Eq.refl 2))))
                            (Eq.refl ((Int.negOfNat 4).mul (Int.ofNat 1))) (Eq.refl 2)))
                        (Eq.refl 2)))
                    n))
                (congrFun'
                  (congrArg HPow.hPow
                    (Mathlib.Meta.NormNum.IsInt.neg_to_eq
                      (Mathlib.Meta.NormNum.isInt_mul (Eq.refl HMul.hMul)
                        (Mathlib.Meta.NormNum.isInt_neg (Eq.refl Neg.neg)
                          (Mathlib.Meta.NormNum.IsNat.to_isInt (Mathlib.Meta.NormNum.isNat_ofNat ℝ Nat.cast_one))
                          (Eq.refl (Int.negOfNat 1)))
                        (Mathlib.Meta.NormNum.IsNat.to_isInt (Mathlib.Meta.NormNum.isNat_ofNat ℝ (Eq.refl 2)))
                        (Eq.refl (Int.negOfNat 2)))
                      (Eq.refl 2)))
                  n))
              (eq_self ((-2) ^ n)))
            (eq_true True.intro))));
  have hm :=
    congrArg (fun y => (-4) ^ n * y)
      (Eq.mp
        (congr
          (congrArg Eq
            (Eq.trans Polynomial.eval_mul
              (congrFun' (congrArg HMul.hMul Polynomial.eval_C)
                (Polynomial.eval x ((⇑Polynomial.derivative)^[n] ((Polynomial.X ^ 2 - 1) ^ n))))))
          (Eq.trans Polynomial.eval_mul
            (congr (congrArg HMul.hMul Polynomial.eval_C)
              (Eq.trans Polynomial.eval_comp
                (Eq.trans
                  (Eq.trans
                    (congrFun'
                      (congrArg Polynomial.eval
                        (Eq.trans Polynomial.eval_add
                          (congr
                            (congrArg HAdd.hAdd
                              (Eq.trans Polynomial.eval_mul
                                (congr (congrArg HMul.hMul Polynomial.eval_C) Polynomial.eval_X)))
                            Polynomial.eval_C)))
                      (Polynomial.C ↑n.factorial * CAS12Affine.shifted n))
                    Polynomial.eval_mul)
