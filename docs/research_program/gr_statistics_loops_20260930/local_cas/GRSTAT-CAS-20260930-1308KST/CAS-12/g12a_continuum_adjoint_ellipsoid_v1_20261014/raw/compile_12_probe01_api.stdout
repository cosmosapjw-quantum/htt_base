G12DClosure.between_states_weight_bound : G12DClosure.between_states_weight_bound_type
def G12DClosure.between_states_weight_bound_type : Prop :=
∀ (b E f g z : ℝ),
  0 < b →
    0 < E →
      0 ≤ f →
        f ≤ G12D.occupation b 0 E →
          0 ≤ g → g ≤ G12D.occupation b 0 E → min f g ≤ z → z ≤ max f g → z * (1 + z) ≤ CAS12PlanckIR.weight b E
@G11C.weighted_residual_ellipsoid : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : Measure X) (s : G11A.Stat)
  (f g W : X → ℝ),
  Measurable f →
    Measurable g →
      (∀ᵐ (x : X) ∂μ, f x ∈ G11A.cdom s) →
        (∀ᵐ (x : X) ∂μ, g x ∈ G11A.dom s) →
          G11A.WEnvelope μ s W f g →
            ∀ {ε : ℝ},
              0 ≤ ε →
                G11A.Dext μ (G11A.hS s) (G11A.hS' s) f g ≤ ENNReal.ofReal ε →
                  ∀ {m n : ℕ} (φ : Fin m → X → ℝ) (hφ : ∀ (a : Fin m), MemLp (φ a) 2 (G11C.wmeas μ W)),
                    (∀ (a : Fin m), ∫ (x : X), φ a x * (f x - g x) ∂μ = 0) →
                      ∀ (K : Fin n → X → ℝ) (hK : ∀ (j : Fin n), MemLp (K j) 2 (G11C.wmeas μ W)),
                        (G11C.gramR μ W φ hφ K hK).PosSemidef ∧
                          G11C.evec μ K f g ∈ (Matrix.toLin' (G11C.gramR μ W φ hφ K hK)).range ∧
                            G11C.evec μ K f g ⬝ᵥ
                                (CAS11C02.spectralPinvMatrix (G11C.gramR μ W φ hφ K hK) ⋯).mulVec (G11C.evec μ K f g) ≤
                              2 * ε
@G11C.all_retained : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : Measure X) (s : G11A.Stat) (f g W : X → ℝ),
  Measurable f →
    Measurable g →
      (∀ᵐ (x : X) ∂μ, f x ∈ G11A.cdom s) →
        (∀ᵐ (x : X) ∂μ, g x ∈ G11A.dom s) →
          G11A.WEnvelope μ s W f g →
            ∀ {ε : ℝ},
              0 ≤ ε →
                G11A.Dext μ (G11A.hS s) (G11A.hS' s) f g ≤ ENNReal.ofReal ε →
                  ∀ {m n : ℕ} (φ : Fin m → X → ℝ) (hφ : ∀ (a : Fin m), MemLp (φ a) 2 (G11C.wmeas μ W)),
                    (∀ (a : Fin m), ∫ (x : X), φ a x * (f x - g x) ∂μ = 0) →
                      ∀ (K : Fin n → X → ℝ) (hK : ∀ (j : Fin n), MemLp (K j) 2 (G11C.wmeas μ W)),
                        (∀ (j : Fin n), MemLp.toLp (K j) ⋯ ∈ G11C.retainedSpan μ W φ hφ) →
                          G11C.gramR μ W φ hφ K hK = 0 ∧ G11C.evec μ K f g = 0
