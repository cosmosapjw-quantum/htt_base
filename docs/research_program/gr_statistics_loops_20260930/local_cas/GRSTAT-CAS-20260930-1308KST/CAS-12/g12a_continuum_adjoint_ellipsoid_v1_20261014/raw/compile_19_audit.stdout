@G12A.collision_ellipsoid : ∀ {Y : Type u_1} {S : Type u_2} [inst : MeasurableSpace Y] [inst_1 : MeasurableSpace S]
  (ρ : MeasureTheory.Measure Y) (σ : MeasureTheory.Measure S) [MeasureTheory.SFinite ρ] [MeasureTheory.SFinite σ]
  (s : G11A.Stat) (f g W : Y × S → ℝ),
  Measurable f →
    Measurable g →
      (∀ᵐ (x : Y × S) ∂ρ.prod σ, f x ∈ G11A.cdom s) →
        (∀ᵐ (x : Y × S) ∂ρ.prod σ, g x ∈ G11A.dom s) →
          G11A.WEnvelope (ρ.prod σ) s W f g →
            ∀ {ε : ℝ},
              0 ≤ ε →
                G11A.Dext (ρ.prod σ) (G11A.hS s) (G11A.hS' s) f g ≤ ENNReal.ofReal ε →
                  ∀ {m n : ℕ} (φ : Fin m → Y × S → ℝ)
                    (hφ : ∀ (a : Fin m), MeasureTheory.MemLp (φ a) 2 (G11C.wmeas (ρ.prod σ) W)),
                    (∀ (a : Fin m), ∫ (x : Y × S), φ a x * (f x - g x) ∂ρ.prod σ = 0) →
                      ∀ (τ : Y → ℝ) (P : S → S → ℝ) (K : Fin n → Y × S → ℝ)
                        (hLK :
                          ∀ (j : Fin n), MeasureTheory.MemLp (G12A.collAdj σ τ P (K j)) 2 (G11C.wmeas (ρ.prod σ) W)),
                        (∀ (j : Fin n),
                            MeasureTheory.Integrable (G12A.fubKernel τ P (K j) fun y => f y - g y)
                              ((ρ.prod σ).prod σ)) →
                          (∀ (j : Fin n), MeasureTheory.Integrable (fun x => τ x.1 * K j x * (f x - g x)) (ρ.prod σ)) →
                            G12A.collEvec ρ σ τ P K f g = G11C.evec (ρ.prod σ) (fun j => G12A.collAdj σ τ P (K j)) f g ∧
                              (G11C.gramR (ρ.prod σ) W φ hφ (fun j => G12A.collAdj σ τ P (K j)) hLK).PosSemidef ∧
                                G12A.collEvec ρ σ τ P K f g ∈
                                    (Matrix.toLin'
                                        (G11C.gramR (ρ.prod σ) W φ hφ (fun j => G12A.collAdj σ τ P (K j)) hLK)).range ∧
                                  G12A.collEvec ρ σ τ P K f g ⬝ᵥ
                                      (CAS11C02.spectralPinvMatrix
                                            (G11C.gramR (ρ.prod σ) W φ hφ (fun j => G12A.collAdj σ τ P (K j)) hLK)
                                            ⋯).mulVec
                                        (G12A.collEvec ρ σ τ P K f g) ≤
                                    2 * ε
