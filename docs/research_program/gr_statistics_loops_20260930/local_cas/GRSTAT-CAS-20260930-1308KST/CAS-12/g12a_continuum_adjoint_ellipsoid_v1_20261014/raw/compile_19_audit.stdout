                                              MeasureTheory.MemLp (K j) 2 (G11C.wmeas (ρ.prod σ) fun x => w x.1)) →
                                            (∀ (j : Fin n),
                                                MeasureTheory.MemLp (G12A.collAdj σ τ P (K j)) 2
                                                  (G11C.wmeas (ρ.prod σ) fun x => w x.1)) ∧
                                              (∀ (j : Fin n),
                                                  MeasureTheory.Integrable (G12A.fubKernel τ P (K j) fun y => f y - g y)
                                                      ((ρ.prod σ).prod σ) ∧
                                                    MeasureTheory.Integrable (fun x => τ x.1 * K j x * (f x - g x))
                                                      (ρ.prod σ)) ∧
                                                ∀
                                                  (hLK :
                                                    ∀ (j : Fin n),
                                                      MeasureTheory.MemLp (G12A.collAdj σ τ P (K j)) 2
                                                        (G11C.wmeas (ρ.prod σ) fun x => w x.1)),
                                                  G12A.collEvec ρ σ τ P K f g =
                                                      G11C.evec (ρ.prod σ) (fun j => G12A.collAdj σ τ P (K j)) f g ∧
                                                    (G11C.gramR (ρ.prod σ) (fun x => w x.1) φ hφ
                                                          (fun j => G12A.collAdj σ τ P (K j)) hLK).PosSemidef ∧
                                                      G12A.collEvec ρ σ τ P K f g ∈
                                                          (Matrix.toLin'
                                                              (G11C.gramR (ρ.prod σ) (fun x => w x.1) φ hφ
                                                                (fun j => G12A.collAdj σ τ P (K j)) hLK)).range ∧
                                                        G12A.collEvec ρ σ τ P K f g ⬝ᵥ
                                                            (CAS11C02.spectralPinvMatrix
                                                                  (G11C.gramR (ρ.prod σ) (fun x => w x.1) φ hφ
                                                                    (fun j => G12A.collAdj σ τ P (K j)) hLK)
                                                                  ⋯).mulVec
                                                              (G12A.collEvec ρ σ τ P K f g) ≤
                                                          2 * ε
