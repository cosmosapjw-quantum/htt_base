G12A.photon_thomson_collision_ellipsoid : ∀ (C b : ℝ),
  0 < b →
    ∀ (f g : ℝ × ↑G11A.Sphere2 → ℝ),
      Measurable f →
        Measurable g →
          (∀ᵐ (x : ℝ × ↑G11A.Sphere2) ∂G11A.nu C, 0 ≤ f x ∧ f x ≤ G12D.occupation b 0 x.1) →
            (∀ᵐ (x : ℝ × ↑G11A.Sphere2) ∂G11A.nu C, 0 < g x ∧ g x ≤ G12D.occupation b 0 x.1) →
              ∀ {ε : ℝ},
                0 ≤ ε →
                  G11A.Dext (G11A.nu C) (G11A.hS G11A.Stat.BE) (G11A.hS' G11A.Stat.BE) f g ≤ ENNReal.ofReal ε →
                    ∀ (τ : ℝ → ℝ),
                      Measurable τ →
                        ∀ {τmax : ℝ},
                          (∀ (E : ℝ), |τ E| ≤ τmax) →
                            ∀ {m n : ℕ} (φ : Fin m → ℝ × ↑G11A.Sphere2 → ℝ)
                              (hφ :
                                ∀ (a : Fin m), MeasureTheory.MemLp (φ a) 2 (G11C.wmeas (G11A.nu C) (G12A.photonW b))),
                              (∀ (a : Fin m), ∫ (x : ℝ × ↑G11A.Sphere2), φ a x * (f x - g x) ∂G11A.nu C = 0) →
                                ∀ (K : Fin n → ℝ × ↑G11A.Sphere2 → ℝ),
                                  (∀ (j : Fin n),
                                      MeasureTheory.MemLp (K j) 2 (G11C.wmeas (G11A.nu C) (G12A.photonW b))) →
                                    G12A.collAdj G11A.dOmega τ G12A.thomsonP = G12A.collOp G11A.dOmega τ G12A.thomsonP ∧
                                      (∀ (j : Fin n),
                                          MeasureTheory.MemLp (G12A.collOp G11A.dOmega τ G12A.thomsonP (K j)) 2
                                            (G11C.wmeas (G11A.nu C) (G12A.photonW b))) ∧
                                        ∀
                                          (hLK :
                                            ∀ (j : Fin n),
                                              MeasureTheory.MemLp (G12A.collOp G11A.dOmega τ G12A.thomsonP (K j)) 2
                                                (G11C.wmeas (G11A.nu C) (G12A.photonW b))),
                                          G12A.collEvec (G12A.energyMeasure C) G11A.dOmega τ G12A.thomsonP K f g =
                                              G11C.evec (G11A.nu C)
                                                (fun j => G12A.collOp G11A.dOmega τ G12A.thomsonP (K j)) f g ∧
                                            (G11C.gramR (G11A.nu C) (G12A.photonW b) φ hφ
                                                  (fun j => G12A.collOp G11A.dOmega τ G12A.thomsonP (K j))
                                                  hLK).PosSemidef ∧
                                              G12A.collEvec (G12A.energyMeasure C) G11A.dOmega τ G12A.thomsonP K f g ∈
                                                  (Matrix.toLin'
                                                      (G11C.gramR (G11A.nu C) (G12A.photonW b) φ hφ
                                                        (fun j => G12A.collOp G11A.dOmega τ G12A.thomsonP (K j))
                                                        hLK)).range ∧
                                                G12A.collEvec (G12A.energyMeasure C) G11A.dOmega τ G12A.thomsonP K f
                                                      g ⬝ᵥ
                                                    (CAS11C02.spectralPinvMatrix
                                                          (G11C.gramR (G11A.nu C) (G12A.photonW b) φ hφ
                                                            (fun j => G12A.collOp G11A.dOmega τ G12A.thomsonP (K j))
                                                            hLK)
                                                          ⋯).mulVec
                                                      (G12A.collEvec (G12A.energyMeasure C) G11A.dOmega τ G12A.thomsonP
                                                        K f g) ≤
                                                  2 * ε
'G12A.photon_thomson_collision_ellipsoid' depends on axioms: [propext, Classical.choice, Quot.sound]
