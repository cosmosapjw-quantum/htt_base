  Measurable f ∧
    Measurable g ∧
      Measurable w ∧
        Measurable τ ∧
          Measurable (Function.uncurry P) ∧
            (∀ᵐ (x : Bool × Bool) ∂MeasureTheory.Measure.count.prod MeasureTheory.Measure.count,
                f x ∈ G11A.cdom G11A.Stat.MB) ∧
              (∀ᵐ (x : Bool × Bool) ∂MeasureTheory.Measure.count.prod MeasureTheory.Measure.count,
                  g x ∈ G11A.dom G11A.Stat.MB) ∧
                G11A.WEnvelope (MeasureTheory.Measure.count.prod MeasureTheory.Measure.count) G11A.Stat.MB
                    (fun x => w x.1) f g ∧
                  0 ≤ ε ∧
                    G11A.Dext (MeasureTheory.Measure.count.prod MeasureTheory.Measure.count) (G11A.hS G11A.Stat.MB)
                          (G11A.hS' G11A.Stat.MB) f g ≤
                        ENNReal.ofReal ε ∧
                      (∀ (E : Bool), |τ E| ≤ 1) ∧
                        (∀ (e e' : Bool), |P e e'| ≤ 1) ∧
                          (∀ (j : Fin 1),
                              MeasureTheory.MemLp (K j) 2
                                (G11C.wmeas (MeasureTheory.Measure.count.prod MeasureTheory.Measure.count) fun x =>
                                  w x.1)) ∧
                            f ≠ g ∧ G12A.collEvec MeasureTheory.Measure.count MeasureTheory.Measure.count τ P K f g ≠ 0
'G12A.nonvacuity_bounded_witness' depends on axioms: [propext, Classical.choice, Quot.sound]
