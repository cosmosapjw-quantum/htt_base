                    ∀ (τ : Y → ℝ),
                      Measurable τ →
                        ∀ {τmax : ℝ},
                          (∀ (E : Y), |τ E| ≤ τmax) →
                            ∀ (P : S → S → ℝ),
                              Measurable (Function.uncurry P) →
                                ∀ {Pmax : ℝ},
                                  (∀ (e e' : S), |P e e'| ≤ Pmax) →
                                    ∀ {m n : ℕ} (φ : Fin m → Y × S → ℝ)
                                      (hφ :
