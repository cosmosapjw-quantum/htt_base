G12A.energy_dependent_tau_counterexample : ∃ τ P K f g p,
  τ true ≠ τ false ∧
    (∀ (e e' : Bool), P e e' = P e' e) ∧
      (∀ (x : Bool × Bool), 0 < f x ∧ 0 < g x) ∧
        (∀ (x : Bool × Bool), ∫ (e' : Bool), P e' x.2 * K (x.1, e') ∂MeasureTheory.Measure.count = p * K x) ∧
          MeasureTheory.Integrable (G12A.fubKernel τ P K fun y => f y - g y)
              ((MeasureTheory.Measure.count.prod MeasureTheory.Measure.count).prod MeasureTheory.Measure.count) ∧
            MeasureTheory.Integrable (fun x => τ x.1 * K x * (f x - g x))
                (MeasureTheory.Measure.count.prod MeasureTheory.Measure.count) ∧
              ∫ (x : Bool × Bool), K x * (f x - g x) ∂MeasureTheory.Measure.count.prod MeasureTheory.Measure.count = 0 ∧
                G12A.collEvec MeasureTheory.Measure.count MeasureTheory.Measure.count τ P (fun x => K) f g 0 ≠ 0 ∧
                  G12A.collEvec MeasureTheory.Measure.count MeasureTheory.Measure.count (fun x => τ true) P (fun x => K)
                      f g 0 =
                    0
