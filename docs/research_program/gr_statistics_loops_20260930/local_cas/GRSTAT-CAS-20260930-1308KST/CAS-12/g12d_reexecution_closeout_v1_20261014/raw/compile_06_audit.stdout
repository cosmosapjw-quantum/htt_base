@G12D.temperature_mixture_and_reference_envelope : ∀ {S : Type u_1} [inst : MeasurableSpace S]
  (μ : MeasureTheory.Measure S) [MeasureTheory.IsProbabilityMeasure μ] (T : S → ℝ) (kB Tmax eta0 E betaRef etaRef : ℝ),
  0 < kB →
    0 < Tmax →
      0 < E →
        (∀ᵐ (s : S) ∂μ, 0 < T s ∧ T s ≤ Tmax) →
          eta0 ≤ 0 →
            MeasureTheory.Integrable (fun s => G12D.occupation (G12D.inverseTemperature kB (T s)) eta0 E) μ →
              G12D.inverseTemperature kB Tmax ≤ betaRef →
                etaRef ≤ 0 →
                  0 ≤ G12D.mixtureOccupation μ (fun s => G12D.inverseTemperature kB (T s)) (fun x => eta0) E ∧
                    G12D.mixtureOccupation μ (fun s => G12D.inverseTemperature kB (T s)) (fun x => eta0) E ≤
                        G12D.occupation (G12D.inverseTemperature kB Tmax) 0 E ∧
                      0 ≤ G12D.occupation betaRef etaRef E ∧
                        G12D.occupation betaRef etaRef E ≤ G12D.occupation (G12D.inverseTemperature kB Tmax) 0 E
