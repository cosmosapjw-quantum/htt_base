Real.HolderConjugate.two_two : Real.HolderConjugate 2 2
@ENNReal.lintegral_mul_le_Lp_mul_Lq : ∀ {α : Type u_1} [inst : MeasurableSpace α] (μ : Measure α) {p q : ℝ},
  p.HolderConjugate q →
    ∀ {f g : α → ENNReal},
      AEMeasurable f μ →
        AEMeasurable g μ →
          ∫⁻ (a : α), (f * g) a ∂μ ≤ (∫⁻ (a : α), f a ^ p ∂μ) ^ (1 / p) * (∫⁻ (a : α), g a ^ q ∂μ) ^ (1 / q)
@hasDerivAt_integral_of_dominated_loc_of_deriv_le : ∀ {α : Type u_1} [inst : MeasurableSpace α] {μ : Measure α}
  {𝕜 : Type u_2} [inst_1 : RCLike 𝕜] {E : Type u_3} [inst_2 : NormedAddCommGroup E] [inst_3 : NormedSpace ℝ E]
  [inst_4 : NormedSpace 𝕜 E] {bound : α → ℝ} {F : 𝕜 → α → E} {x₀ : 𝕜} {s : Set 𝕜},
  s ∈ nhds x₀ →
    (∀ᶠ (x : 𝕜) in nhds x₀, AEStronglyMeasurable (F x) μ) →
      Integrable (F x₀) μ →
        ∀ {F' : 𝕜 → α → E},
          AEStronglyMeasurable (F' x₀) μ →
            (∀ᵐ (a : α) ∂μ, ∀ x ∈ s, ‖F' x a‖ ≤ bound a) →
              Integrable bound μ →
                (∀ᵐ (a : α) ∂μ, ∀ x ∈ s, HasDerivAt (fun x => F x a) (F' x a) x) →
                  Integrable (F' x₀) μ ∧ HasDerivAt (fun n => ∫ (a : α), F n a ∂μ) (∫ (a : α), F' x₀ a ∂μ) x₀
@ofReal_integral_eq_lintegral_ofReal : ∀ {α : Type u_1} {m : MeasurableSpace α} {μ : Measure α} {f : α → ℝ},
  Integrable f μ → 0 ≤ᵐ[μ] f → ENNReal.ofReal (∫ (x : α), f x ∂μ) = ∫⁻ (x : α), ENNReal.ofReal (f x) ∂μ
@ae_lt_top : ∀ {α : Type u_1} {mα : MeasurableSpace α} {μ : Measure α} {f : α → ENNReal},
  Measurable f → ∫⁻ (x : α), f x ∂μ ≠ ⊤ → ∀ᵐ (x : α) ∂μ, f x < ⊤
@ENNReal.ofReal_rpow_of_nonneg : ∀ {x p : ℝ}, 0 ≤ x → 0 ≤ p → ENNReal.ofReal x ^ p = ENNReal.ofReal (x ^ p)
Real.sqrt_eq_rpow : ∀ (x : ℝ), √x = x ^ (1 / 2)
@norm_integral_le_lintegral_norm : ∀ {α : Type u_1} {G : Type u_2} [inst : NormedAddCommGroup G]
  [inst_1 : NormedSpace ℝ G] {m : MeasurableSpace α} {μ : Measure α} (f : α → G),
  ‖∫ (a : α), f a ∂μ‖ ≤ (∫⁻ (a : α), ENNReal.ofReal ‖f a‖ ∂μ).toReal
@norm_integral_le_of_norm_le : ∀ {α : Type u_1} {G : Type u_2} [inst : NormedAddCommGroup G] [inst_1 : NormedSpace ℝ G]
  {m : MeasurableSpace α} {μ : Measure α} {f : α → G} {g : α → ℝ},
  Integrable g μ → (∀ᵐ (x : α) ∂μ, ‖f x‖ ≤ g x) → ‖∫ (x : α), f x ∂μ‖ ≤ ∫ (x : α), g x ∂μ
@IsLocalMin.hasDerivAt_eq_zero : ∀ {f : ℝ → ℝ} {f' a : ℝ}, IsLocalMin f a → HasDerivAt f f' a → f' = 0
@measurableSet_eq_fun : ∀ {α : Type u_1} {β : Type u_2} {m : MeasurableSpace α} [inst : MeasurableSpace β]
  [MeasurableEq β] {f g : α → β}, Measurable f → Measurable g → MeasurableSet {x | f x = g x}
@G12DClosure.angular_bounded_rpow_kernel_integrable : G12DClosure.angular_bounded_rpow_kernel_integrable_type
G12DClosure.between_states_weight_bound : G12DClosure.between_states_weight_bound_type
@G12DClosure.no_nonpositive_energy_mass : G12DClosure.no_nonpositive_energy_mass_type
G12E.fisher_unbounded : ∀ (C : ℝ),
  0 < C →
    ∀ (s : G11A.Stat) (g q : ℝ → ℝ) {E1 E2 : ℝ},
      Measurable g →
        ContinuousOn g (Set.Icc E1 E2) →
          (∀ (E : ℝ), 0 < E → g E ∈ G11A.dom s) →
            Continuous q →
              0 < E1 →
                (∀ E ∉ Set.Icc E1 E2, q E = 0) →
                  (∃ E0, q E0 ≠ 0) →
                    ∀ (a : ℝ),
                      a ≠ 0 →
                        Filter.Tendsto
                          (fun n =>
                            ∫ (z : ℝ × ↑G11A.Sphere2),
                              (a * ↑n * q z.1) ^ 2 * G11A.hess s (G12E.family g q a n 0 z) ∂G11A.nu C)
                          Filter.atTop Filter.atTop
G12E.nu_facts : ∀ (C : ℝ), (G11A.nu C) {z | z.1 ≤ 0} = 0 ∧ ∀ (E1 E2 : ℝ), 0 < E1 → (G11A.nu C) (G12E.patchE E1 E2) ≠ ⊤
@EuclideanSpace.norm_eq : ∀ {𝕜 : Type u_1} [inst : RCLike 𝕜] {n : Type u_2} [inst_1 : Fintype n]
  (x : EuclideanSpace 𝕜 n), ‖x‖ = √(∑ i, ‖x.ofLp i‖ ^ 2)
inferInstance : IsFiniteMeasure G11A.dOmega
