statWeight_nonneg : ∀ (s : Stat) {f : ℝ}, f ∈ cdom s → 0 ≤ statWeight s f
fisherDens_of_dom : ∀ (s : Stat) {f : ℝ},
  f ∈ dom s → ∀ (d : ℝ), fisherDens d (statWeight s f) = ENNReal.ofReal (d ^ 2 * hess s f)
@weighted_cauchy_schwarz : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : Measure X) (K d w ρ : X → ℝ) (J : ℝ),
  Measurable K →
    Measurable d →
      Measurable w →
        Measurable ρ →
          (∀ᵐ (z : X) ∂μ, 0 ≤ w z) →
            (∀ᵐ (z : X) ∂μ, 0 ≤ ρ z) →
              Integrable (fun z => K z ^ 2 * w z * ρ z) μ →
                ∫⁻ (z : X), ENNReal.ofReal (ρ z) * fisherDens (d z) (w z) ∂μ ≤ ENNReal.ofReal J →
                  Integrable (fun z => K z * d z * ρ z) μ ∧
                    |∫ (z : X), K z * d z * ρ z ∂μ| ≤ √J * √(∫ (z : X), K z ^ 2 * w z * ρ z ∂μ)
@real_budget_le : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : Measure X) (s : Stat) (d f ρ : X → ℝ) (J : ℝ),
  (∀ᵐ (z : X) ∂μ, f z ∈ dom s) →
    (∀ᵐ (z : X) ∂μ, 0 ≤ ρ z) →
      Integrable (fun z => d z ^ 2 * hess s (f z) * ρ z) μ →
        ∫ (z : X), d z ^ 2 * hess s (f z) * ρ z ∂μ ≤ J →
          ∫⁻ (z : X), ENNReal.ofReal (ρ z) * fisherDens (d z) (statWeight s (f z)) ∂μ ≤ ENNReal.ofReal J
@zero_weight_null : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : Measure X) (d w ρ : X → ℝ) (J : ℝ),
  Measurable d →
    Measurable w →
      Measurable ρ →
        ∫⁻ (z : X), ENNReal.ofReal (ρ z) * fisherDens (d z) (w z) ∂μ ≤ ENNReal.ofReal J →
          ∀ᵐ (z : X) ∂μ, w z ≤ 0 → 0 < ρ z → d z = 0
zero_occupation_derivative : ∀ (s : Stat) (φ : ℝ → ℝ) (x0 d : ℝ),
  (∀ᶠ (t : ℝ) in 𝓝 x0, φ t ∈ cdom s) →
    HasDerivAt φ d x0 → statWeight s (φ x0) = 0 → d = 0 ∧ fisherDens d (statWeight s (φ x0)) = 0
@parallel_derivative_bound : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : Measure X) (s : Stat) (K ρ : X → ℝ)
  (f f' : ℝ → X → ℝ) (x0 J : ℝ) (bound : X → ℝ),
  ∀ U ∈ 𝓝 x0,
    (∀ᶠ (t : ℝ) in 𝓝 x0, AEStronglyMeasurable (fun z => K z * f t z * ρ z) μ) →
      Integrable (fun z => K z * f x0 z * ρ z) μ →
        (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, |K z * f' t z * ρ z| ≤ bound z) →
          Integrable bound μ →
            (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, HasDerivAt (fun t => f t z) (f' t z) t) →
              Measurable K →
                Measurable ρ →
                  Measurable (f x0) →
                    Measurable (f' x0) →
                      (∀ᵐ (z : X) ∂μ, 0 ≤ ρ z) →
                        (∀ᵐ (z : X) ∂μ, f x0 z ∈ cdom s) →
                          Integrable (fun z => K z ^ 2 * statWeight s (f x0 z) * ρ z) μ →
                            ∫⁻ (z : X), ENNReal.ofReal (ρ z) * fisherDens (f' x0 z) (statWeight s (f x0 z)) ∂μ ≤
                                ENNReal.ofReal J →
                              HasDerivAt (fun t => ∫ (z : X), K z * f t z * ρ z ∂μ) (∫ (z : X), K z * f' x0 z * ρ z ∂μ)
                                  x0 ∧
                                |∫ (z : X), K z * f' x0 z * ρ z ∂μ| ≤
                                  √J * √(∫ (z : X), K z ^ 2 * statWeight s (f x0 z) * ρ z ∂μ)
@teff_a4_derivative_bound_BE : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : Measure X) (K : X → ℝ)
  (f f' : ℝ → X → ℝ) (x0 J : ℝ) (bound : X → ℝ),
  ∀ U ∈ 𝓝 x0,
    (∀ᶠ (t : ℝ) in 𝓝 x0, AEStronglyMeasurable (fun z => K z * f t z) μ) →
      Integrable (fun z => K z * f x0 z) μ →
        (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, |K z * f' t z| ≤ bound z) →
          Integrable bound μ →
            (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, HasDerivAt (fun t => f t z) (f' t z) t) →
              Measurable K →
                Measurable (f x0) →
                  Measurable (f' x0) →
                    (∀ᵐ (z : X) ∂μ, 0 ≤ f x0 z) →
                      Integrable (fun z => K z ^ 2 * (f x0 z * (1 + f x0 z))) μ →
                        ∫⁻ (z : X), fisherDens (f' x0 z) (f x0 z * (1 + f x0 z)) ∂μ ≤ ENNReal.ofReal J →
                          HasDerivAt (fun t => ∫ (z : X), K z * f t z ∂μ) (∫ (z : X), K z * f' x0 z ∂μ) x0 ∧
                            |∫ (z : X), K z * f' x0 z ∂μ| ≤ √J * √(∫ (z : X), K z ^ 2 * (f x0 z * (1 + f x0 z)) ∂μ)
@general_derivative_bound : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : Measure X) (s : Stat)
  (K K' f f' ρ ρ' : ℝ → X → ℝ) (x0 J : ℝ) (bound : X → ℝ),
  ∀ U ∈ 𝓝 x0,
    (∀ᶠ (t : ℝ) in 𝓝 x0, AEStronglyMeasurable (fun z => K t z * f t z * ρ t z) μ) →
      Integrable (fun z => K x0 z * f x0 z * ρ x0 z) μ →
        (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, |K t z * f' t z * ρ t z + K' t z * f t z * ρ t z + K t z * f t z * ρ' t z| ≤ bound z) →
          Integrable bound μ →
            (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, HasDerivAt (fun t => K t z) (K' t z) t) →
              (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, HasDerivAt (fun t => f t z) (f' t z) t) →
                (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, HasDerivAt (fun t => ρ t z) (ρ' t z) t) →
                  Measurable (K x0) →
                    Measurable (K' x0) →
                      Measurable (f x0) →
                        Measurable (f' x0) →
                          Measurable (ρ x0) →
                            Measurable (ρ' x0) →
                              (∀ᵐ (z : X) ∂μ, 0 ≤ ρ x0 z) →
                                (∀ᵐ (z : X) ∂μ, f x0 z ∈ cdom s) →
                                  Integrable (fun z => K x0 z ^ 2 * statWeight s (f x0 z) * ρ x0 z) μ →
                                    ∫⁻ (z : X),
                                          ENNReal.ofReal (ρ x0 z) * fisherDens (f' x0 z) (statWeight s (f x0 z)) ∂μ ≤
                                        ENNReal.ofReal J →
                                      Integrable (fun z => K' x0 z * f x0 z * ρ x0 z) μ →
                                        Integrable (fun z => K x0 z * f x0 z * ρ' x0 z) μ ∧
                                          HasDerivAt (fun t => ∫ (z : X), K t z * f t z * ρ t z ∂μ)
                                              (∫ (z : X), K x0 z * f' x0 z * ρ x0 z ∂μ +
                                                  ∫ (z : X), K' x0 z * f x0 z * ρ x0 z ∂μ +
                                                ∫ (z : X), K x0 z * f x0 z * ρ' x0 z ∂μ)
                                              x0 ∧
                                            |∫ (z : X), K x0 z * f' x0 z * ρ x0 z ∂μ +
                                                    ∫ (z : X), K' x0 z * f x0 z * ρ x0 z ∂μ +
                                                  ∫ (z : X), K x0 z * f x0 z * ρ' x0 z ∂μ| ≤
                                              √J * √(∫ (z : X), K x0 z ^ 2 * statWeight s (f x0 z) * ρ x0 z ∂μ) +
                                                  |∫ (z : X), K' x0 z * f x0 z * ρ x0 z ∂μ| +
                                                |∫ (z : X), K x0 z * f x0 z * ρ' x0 z ∂μ|
@general_derivative_bound_envelope : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : Measure X) (s : Stat)
  (K K' f f' ρ ρ' : ℝ → X → ℝ) (x0 J : ℝ) (bound F : X → ℝ),
  ∀ U ∈ 𝓝 x0,
    (∀ᶠ (t : ℝ) in 𝓝 x0, AEStronglyMeasurable (fun z => K t z * f t z * ρ t z) μ) →
      Integrable (fun z => K x0 z * f x0 z * ρ x0 z) μ →
        (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, |K t z * f' t z * ρ t z + K' t z * f t z * ρ t z + K t z * f t z * ρ' t z| ≤ bound z) →
          Integrable bound μ →
            (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, HasDerivAt (fun t => K t z) (K' t z) t) →
              (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, HasDerivAt (fun t => f t z) (f' t z) t) →
                (∀ᵐ (z : X) ∂μ, ∀ t ∈ U, HasDerivAt (fun t => ρ t z) (ρ' t z) t) →
                  Measurable (K x0) →
                    Measurable (K' x0) →
                      Measurable (f x0) →
                        Measurable (f' x0) →
                          Measurable (ρ x0) →
                            Measurable (ρ' x0) →
                              (∀ᵐ (z : X) ∂μ, 0 ≤ ρ x0 z) →
                                (∀ᵐ (z : X) ∂μ, f x0 z ∈ cdom s) →
                                  Integrable (fun z => K x0 z ^ 2 * statWeight s (f x0 z) * ρ x0 z) μ →
                                    ∫⁻ (z : X),
                                          ENNReal.ofReal (ρ x0 z) * fisherDens (f' x0 z) (statWeight s (f x0 z)) ∂μ ≤
                                        ENNReal.ofReal J →
                                      Integrable (fun z => K' x0 z * f x0 z * ρ x0 z) μ →
                                        (∀ᵐ (z : X) ∂μ, |f x0 z| ≤ F z) →
                                          Integrable (fun z => |K' x0 z| * F z * ρ x0 z) μ →
                                            Integrable (fun z => |K x0 z| * F z * |ρ' x0 z|) μ →
                                              |∫ (z : X), K x0 z * f' x0 z * ρ x0 z ∂μ +
                                                      ∫ (z : X), K' x0 z * f x0 z * ρ x0 z ∂μ +
                                                    ∫ (z : X), K x0 z * f x0 z * ρ' x0 z ∂μ| ≤
                                                √J * √(∫ (z : X), K x0 z ^ 2 * statWeight s (f x0 z) * ρ x0 z ∂μ) +
                                                    ∫ (z : X), |K' x0 z| * F z * ρ x0 z ∂μ +
                                                  ∫ (z : X), |K x0 z| * F z * |ρ' x0 z| ∂μ
sharp_witness : ∫⁻ (z : Unit), ENNReal.ofReal 1 * fisherDens 1 (statWeight Stat.BE 1) ∂Measure.dirac () =
    ENNReal.ofReal (1 / 2) ∧
  ∫ (z : Unit), 1 ^ 2 * statWeight Stat.BE 1 * 1 ∂Measure.dirac () = 2 ∧
    HasDerivAt (fun t => ∫ (z : Unit), 1 * (1 + t) * 1 ∂Measure.dirac ()) 1 0 ∧ |1| = √(1 / 2) * √2
junk_hess_control : ∫ (z : Unit), 1 ^ 2 * hess Stat.BE 0 ∂Measure.dirac () = 0 ∧
  ¬|∫ (z : Unit), 1 * 1 * 1 ∂Measure.dirac ()| ≤
        √0 * √(∫ (z : Unit), 1 ^ 2 * statWeight Stat.BE 0 * 1 ∂Measure.dirac ()) ∧
    fisherDens 1 (statWeight Stat.BE 0) = ∞
measure_term_necessary : HasDerivAt (fun t => ∫ (z : Unit), 1 * 1 * (1 + t) ∂Measure.dirac ()) 1 0 ∧
  ∫⁻ (z : Unit), ENNReal.ofReal 1 * fisherDens 0 (statWeight Stat.BE 1) ∂Measure.dirac () = 0 ∧
    ¬|1| ≤ √0 * √(∫ (z : Unit), 1 ^ 2 * statWeight Stat.BE 1 * 1 ∂Measure.dirac ())
kernel_term_necessary : HasDerivAt (fun t => ∫ (z : Unit), (1 + t) * 1 * 1 ∂Measure.dirac ()) 1 0 ∧
  ∫⁻ (z : Unit), ENNReal.ofReal 1 * fisherDens 0 (statWeight Stat.BE 1) ∂Measure.dirac () = 0 ∧
    ¬|1| ≤ √0 * √(∫ (z : Unit), 1 ^ 2 * statWeight Stat.BE 1 * 1 ∂Measure.dirac ())
stress_weighted_norm : ∀ (C b : ℝ),
  0 < C →
    0 < b →
      ∀ (f : ℝ × ↑Sphere2 → ℝ),
        Measurable f →
          (∀ (z : ℝ × ↑Sphere2), 0 < z.1 → 0 ≤ f z ∧ f z ≤ G12D.occupation b 0 z.1) →
            ∀ (a c : Fin 4),
              Integrable (fun z => stressKernel a c z ^ 2 * statWeight Stat.BE (f z) * (C * z.1 ^ 2))
                  (G12D.energyAngularMeasure dOmega) ∧
                ∫ (z : ℝ × ↑Sphere2),
                    stressKernel a c z ^ 2 * statWeight Stat.BE (f z) *
                      (C * z.1 ^ 2) ∂G12D.energyAngularMeasure dOmega ≤
                  ∫ (z : ℝ × ↑Sphere2),
                    G12D.kernelDensity b C z.1 * stressKernel a c z ^ 2 ∂G12D.energyAngularMeasure dOmega
stress_derivative_bound : ∀ (C b : ℝ),
  0 < C →
    0 < b →
      ∀ (a c : Fin 4) (f f' : ℝ → ℝ × ↑Sphere2 → ℝ) (x0 J : ℝ) (bound : ℝ × ↑Sphere2 → ℝ),
        ∀ U ∈ 𝓝 x0,
          (∀ᶠ (t : ℝ) in 𝓝 x0,
              AEStronglyMeasurable (fun z => stressKernel a c z * f t z * (C * z.1 ^ 2))
                (G12D.energyAngularMeasure dOmega)) →
            Integrable (fun z => stressKernel a c z * f x0 z * (C * z.1 ^ 2)) (G12D.energyAngularMeasure dOmega) →
              (∀ᵐ (z : ℝ × ↑Sphere2) ∂G12D.energyAngularMeasure dOmega,
                  ∀ t ∈ U, |stressKernel a c z * f' t z * (C * z.1 ^ 2)| ≤ bound z) →
                Integrable bound (G12D.energyAngularMeasure dOmega) →
                  (∀ᵐ (z : ℝ × ↑Sphere2) ∂G12D.energyAngularMeasure dOmega,
                      ∀ t ∈ U, HasDerivAt (fun t => f t z) (f' t z) t) →
                    Measurable (f x0) →
                      Measurable (f' x0) →
                        (∀ (z : ℝ × ↑Sphere2), 0 < z.1 → 0 ≤ f x0 z ∧ f x0 z ≤ G12D.occupation b 0 z.1) →
                          ∫⁻ (z : ℝ × ↑Sphere2),
                                ENNReal.ofReal (C * z.1 ^ 2) *
                                  fisherDens (f' x0 z) (statWeight Stat.BE (f x0 z)) ∂G12D.energyAngularMeasure dOmega ≤
                              ENNReal.ofReal J →
                            HasDerivAt
                                (fun t =>
                                  ∫ (z : ℝ × ↑Sphere2),
                                    stressKernel a c z * f t z * (C * z.1 ^ 2) ∂G12D.energyAngularMeasure dOmega)
                                (∫ (z : ℝ × ↑Sphere2),
                                  stressKernel a c z * f' x0 z * (C * z.1 ^ 2) ∂G12D.energyAngularMeasure dOmega)
                                x0 ∧
                              |∫ (z : ℝ × ↑Sphere2),
                                      stressKernel a c z * f' x0 z * (C * z.1 ^ 2) ∂G12D.energyAngularMeasure dOmega| ≤
                                  √J *
                                    √(∫ (z : ℝ × ↑Sphere2),
                                        stressKernel a c z ^ 2 * statWeight Stat.BE (f x0 z) *
                                          (C * z.1 ^ 2) ∂G12D.energyAngularMeasure dOmega) ∧
                                ∫ (z : ℝ × ↑Sphere2),
                                    stressKernel a c z ^ 2 * statWeight Stat.BE (f x0 z) *
                                      (C * z.1 ^ 2) ∂G12D.energyAngularMeasure dOmega ≤
                                  ∫ (z : ℝ × ↑Sphere2),
                                    G12D.kernelDensity b C z.1 *
                                      stressKernel a c z ^ 2 ∂G12D.energyAngularMeasure dOmega
stress_nonvacuity : ∀ (C b : ℝ),
  0 < C →
    0 < b →
      ∀ (a c : Fin 4),
        ∃ J,
          HasDerivAt
              (fun t =>
                ∫ (z : ℝ × ↑Sphere2),
                  stressKernel a c z * ((1 + t) * G12D.occupation (2 * b) 0 z.1) *
                    (C * z.1 ^ 2) ∂G12D.energyAngularMeasure dOmega)
              (∫ (z : ℝ × ↑Sphere2),
                stressKernel a c z * G12D.occupation (2 * b) 0 z.1 * (C * z.1 ^ 2) ∂G12D.energyAngularMeasure dOmega)
              0 ∧
            |∫ (z : ℝ × ↑Sphere2),
                  stressKernel a c z * G12D.occupation (2 * b) 0 z.1 *
                    (C * z.1 ^ 2) ∂G12D.energyAngularMeasure dOmega| ≤
              √J *
                √(∫ (z : ℝ × ↑Sphere2),
                    stressKernel a c z ^ 2 * statWeight Stat.BE ((1 + 0) * G12D.occupation (2 * b) 0 z.1) *
                      (C * z.1 ^ 2) ∂G12D.energyAngularMeasure dOmega)
g12e_family_violates_budget : ∀ (C : ℝ),
  0 < C →
    ∀ (s : Stat) (g q : ℝ → ℝ) {E1 E2 : ℝ},
      Measurable g →
        ContinuousOn g (Icc E1 E2) →
          (∀ (E : ℝ), 0 < E → g E ∈ dom s) →
            Continuous q →
              0 < E1 →
                (∀ E ∉ Icc E1 E2, q E = 0) →
                  (∃ E0, q E0 ≠ 0) →
                    ∀ (a : ℝ),
                      a ≠ 0 →
                        ∀ (J : ℝ),
                          ∀ᶠ (n : ℕ) in atTop,
                            ¬∫⁻ (z : ℝ × ↑Sphere2),
                                  fisherDens (a * ↑n * q z.1) (statWeight s (G12E.family g q a n 0 z)) ∂nu C ≤
                                ENNReal.ofReal J
