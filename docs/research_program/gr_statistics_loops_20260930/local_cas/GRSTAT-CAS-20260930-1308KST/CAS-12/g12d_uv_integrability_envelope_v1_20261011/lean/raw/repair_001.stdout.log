G12D.temperature_mixture_and_reference_envelope.{u} {S : Type u} [MeasurableSpace S] (μ : Measure S)
  [IsProbabilityMeasure μ] (T : S → ℝ) (kB Tmax eta0 E betaRef etaRef : ℝ) (hkB : 0 < kB) (hTmax : 0 < Tmax)
  (hE : 0 < E) (hT : ∀ᵐ (s : S) ∂μ, 0 < T s ∧ T s ≤ Tmax) (heta0 : eta0 ≤ 0)
  (hint : Integrable (fun s => G12D.occupation (G12D.inverseTemperature kB (T s)) eta0 E) μ)
  (href : G12D.inverseTemperature kB Tmax ≤ betaRef) (hetaRef : etaRef ≤ 0) :
  0 ≤ G12D.mixtureOccupation μ (fun s => G12D.inverseTemperature kB (T s)) (fun x => eta0) E ∧
    G12D.mixtureOccupation μ (fun s => G12D.inverseTemperature kB (T s)) (fun x => eta0) E ≤
        G12D.occupation (G12D.inverseTemperature kB Tmax) 0 E ∧
      0 ≤ G12D.occupation betaRef etaRef E ∧
        G12D.occupation betaRef etaRef E ≤ G12D.occupation (G12D.inverseTemperature kB Tmax) 0 E
'G12D.temperature_mixture_and_reference_envelope' depends on axioms: [propext, Classical.choice, Quot.sound]
