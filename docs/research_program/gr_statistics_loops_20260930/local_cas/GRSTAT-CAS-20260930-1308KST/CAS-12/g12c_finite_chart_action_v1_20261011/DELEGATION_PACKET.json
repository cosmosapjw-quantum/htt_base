  "theorem_signature": "G12CFiniteChart.sigmaChart_univ : sigmaChart Set.univ = ENNReal.ofReal (4 * Real.pi); G12CFiniteChart.chart_monomial_bridge (a b c : Nat) : (1 / (4 * Real.pi)) * (∫ u : S2, u.1 0 ^ a * u.1 1 ^ b * u.1 2 ^ c ∂sigmaChart) = CAS16C03.sphereMean a b c; G12CFiniteChart.scatter_affine_traceless_quadratic (c : Real) (b : Vec3) (A : Matrix (Fin 3) (Fin 3) Real) (htrace : ∑ i, A i i = 0) (e : S2) : scatter (fun u => c + linearMode b u + quadraticMode A u) e = c + (1 / 10 : Real) * quadraticMode A e; G12CFiniteChart.scatter_affine_traceless_quadratic_moments (c : Real) (b : Vec3) (A : Matrix (Fin 3) (Fin 3) Real) (htrace : ∑ i, A i i = 0) (e : S2) : scatter (fun u => c + linearMode b u + quadraticMode A u) e = CAS12ScalarWrapper.moment 0 * c + CAS12ScalarWrapper.moment 1 * linearMode b e + CAS12ScalarWrapper.moment 2 * quadraticMode A e",
  "accepted_lemma_signatures": [
    "CAS16C03.fullMonomialTheorem : ∀ a b c : Nat, a+b+c≤8 → CAS16C03.productRule a b c = CAS16C03.sphereMean a b c",
