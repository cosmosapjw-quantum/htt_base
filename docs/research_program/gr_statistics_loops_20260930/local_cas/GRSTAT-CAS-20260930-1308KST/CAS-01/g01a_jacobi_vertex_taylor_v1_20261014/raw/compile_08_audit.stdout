  ((J.D 0) v = 0 ∧ (J.D1 0) v = v) ∧
    ∀ t ∈ Set.Icc 0 L,
      HasDerivWithinAt (fun u => (J.D u) v) ((J.D1 t) v) (Set.Icc 0 L) t ∧
        HasDerivWithinAt (fun u => (J.D1 u) v) (-(J.R t) ((J.D t) v)) (Set.Icc 0 L) t
'G01A.column_jacobi_field' depends on axioms: [propext, Classical.choice, Quot.sound]
G01A.field_lipschitz : ∀ (R : ℝ → Cas07M04.Op) (t : ℝ) {K : ℝ},
