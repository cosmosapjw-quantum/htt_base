'G01A.eta_rescale_invariant' depends on axioms: [propext, Classical.choice, Quot.sound]
@G01A.observer_normalization : ∀ {V : Type u_1} [inst : AddCommGroup V] [inst_1 : Module ℝ V]
  (B : LinearMap.BilinForm ℝ V),
  B.IsSymm →
    ∀ (o n : V),
      (B o) o = -1 →
        (B n) n = 1 →
          (B o) n = 0 → (B (-o + n)) (-o + n) = 0 ∧ (B o) (-o + n) = 1 ∧ ∀ (c : ℝ), (B o) (c • (-o + n)) = 1 ↔ c = 1
'G01A.observer_normalization' depends on axioms: [propext, Classical.choice, Quot.sound]
@G01A.frame_determinant_distance : ∀ {K L s : ℝ} (F : G01A.ScreenFrameData K L),
  0 ≤ K →
    0 < L →
      0 < s →
        s ≤ L →
          CAS07M01.eta K L < 1 →
            ∃ J,
              J.R = F.R ∧
                0 < Matrix.det (CAS07M05.matrixOf (J.D s)) ∧
                  s * (1 - CAS07M01.eta K s) ≤ √(Matrix.det (CAS07M05.matrixOf (J.D s))) ∧
                    √(Matrix.det (CAS07M05.matrixOf (J.D s))) ≤ s * (1 + CAS07M01.eta K s)
'G01A.frame_determinant_distance' depends on axioms: [propext, Classical.choice, Quot.sound]
