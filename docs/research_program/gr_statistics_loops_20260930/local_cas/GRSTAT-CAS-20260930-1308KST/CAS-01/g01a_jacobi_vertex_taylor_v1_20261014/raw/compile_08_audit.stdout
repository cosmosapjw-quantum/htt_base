'G01A.field_lipschitz' depends on axioms: [propext, Classical.choice, Quot.sound]
@G01A.ode_extend : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [CompleteSpace E]
  (F : ℝ → E → E) (M : NNReal),
  0 < M →
    (∀ (t : ℝ), LipschitzWith M (F t)) →
      (∀ (x : E), Continuous fun t => F t x) →
        (∀ (t : ℝ), F t 0 = 0) →
          ∀ {T : ℝ},
            0 ≤ T →
              ∀ (α : ℝ → E),
                (∀ t ∈ Set.Icc 0 T, HasDerivWithinAt α (F t (α t)) (Set.Icc 0 T) t) →
                  ∃ β,
                    β 0 = α 0 ∧
                      ∀ t ∈ Set.Icc 0 (T + 1 / (2 * ↑M)),
                        HasDerivWithinAt β (F t (β t)) (Set.Icc 0 (T + 1 / (2 * ↑M))) t
'G01A.ode_extend' depends on axioms: [propext, Classical.choice, Quot.sound]
@G01A.ode_global : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [CompleteSpace E]
  (F : ℝ → E → E) (M : NNReal),
  0 < M →
    (∀ (t : ℝ), LipschitzWith M (F t)) →
      (∀ (x : E), Continuous fun t => F t x) →
        (∀ (t : ℝ), F t 0 = 0) →
          ∀ (y0 : E) (L : ℝ), ∃ α, α 0 = y0 ∧ ∀ t ∈ Set.Icc 0 L, HasDerivWithinAt α (F t (α t)) (Set.Icc 0 L) t
'G01A.ode_global' depends on axioms: [propext, Classical.choice, Quot.sound]
