'G01A.norm_D_le_linear' depends on axioms: [propext, Classical.choice, Quot.sound]
@G01A.cubic_bound : ∀ {K L : ℝ} (J : CAS07M05.JacobiPremises K L),
  0 ≤ K → ∃ C, 0 ≤ C ∧ ∀ s ∈ Set.Icc 0 L, ‖J.D s - s • ContinuousLinearMap.id ℝ Cas07M04.Plane‖ ≤ C * s ^ 3
'G01A.cubic_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
@G01A.cubic_jet_identity : ∀ {K L : ℝ} (J : CAS07M05.JacobiPremises K L),
  ∀ s ∈ Set.Icc 0 L,
    J.D s - s • ContinuousLinearMap.id ℝ Cas07M04.Plane + (s ^ 3 / 6) • J.R 0 =
      -∫ (t : ℝ) in 0..s, (s - t) • (J.R t ∘SL J.D t - t • J.R 0)
