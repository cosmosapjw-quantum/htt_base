@G01A.cubic_jet : ∀ {K L : ℝ} (J : CAS07M05.JacobiPremises K L),
  0 ≤ K →
    0 < L →
      ∀ ε > 0,
        ∃ δ > 0,
          ∀ s ∈ Set.Icc 0 L,
            s < δ → ‖J.D s - s • ContinuousLinearMap.id ℝ Cas07M04.Plane + (s ^ 3 / 6) • J.R 0‖ ≤ ε * s ^ 3
'G01A.cubic_jet' depends on axioms: [propext, Classical.choice, Quot.sound]
@G01A.area_distance_vertex : ∀ {K L : ℝ} (J : CAS07M05.JacobiPremises K L),
