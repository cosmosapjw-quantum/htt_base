@G01A.first_order_iff : ∀ {L : ℝ} (R D D1 : ℝ → Cas07M04.Op),
  (∀ t ∈ Set.Icc 0 L, HasDerivWithinAt D (D1 t) (Set.Icc 0 L) t ∧ HasDerivWithinAt D1 (-R t ∘SL D t) (Set.Icc 0 L) t) ↔
    ∀ t ∈ Set.Icc 0 L, HasDerivWithinAt (fun u => (D u, D1 u)) (G01A.jacobiField R t (D t, D1 t)) (Set.Icc 0 L) t
'G01A.first_order_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
