@g10c_main : ∀ {a : ℝ},
  0 < a →
    ∃ χ,
      (∃ ρ,
          IsMollifier a ρ ∧
            χ = smoothCutoff a ρ ∧
              ∀ (r : ℝ),
                -(a / 8) ≤ r →
                  χ r = MeasureTheory.convolution ρ (q0 a) (ContinuousLinearMap.mul ℝ ℝ) MeasureTheory.volume r) ∧
        ContDiff ℝ (↑⊤) χ ∧
          (∀ (r : ℝ), 0 ≤ χ r ∧ χ r ≤ 1) ∧
            (∀ (r : ℝ), |r| ≤ a / 8 → χ r = 1) ∧
              (∀ (r : ℝ), 7 * a / 8 ≤ |r| → χ r = 0) ∧
                (∀ (r : ℝ), |deriv χ r| ≤ 15 / (4 * a)) ∧
                  (∀ (r : ℝ), |deriv (deriv χ) r| ≤ 40 / (√3 * a ^ 2)) ∧
                    (∀ (E : Type) [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E],
                        (ContDiff ℝ ↑⊤ fun x => χ ‖x‖) ∧
                          (∀ (x : E), ‖x‖ ≤ a / 8 → χ ‖x‖ = 1) ∧ ∀ (x : E), 7 * a / 8 ≤ ‖x‖ → χ ‖x‖ = 0) ∧
                      ¬ContDiff ℝ 3 (q0 a) ∧ ContDiff ℝ 2 (q0 a)
'G10C.g10c_main' depends on axioms: [propext, Classical.choice, Quot.sound]
'G10C.exists_mollifier' depends on axioms: [propext, Classical.choice, Quot.sound]
