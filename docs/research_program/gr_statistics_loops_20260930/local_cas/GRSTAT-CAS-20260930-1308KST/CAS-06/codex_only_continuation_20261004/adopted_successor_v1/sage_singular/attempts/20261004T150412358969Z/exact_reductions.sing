ideal I_C01_G22=1/3*r^3*lam + r*F - r + 2*m,-1/2*r^2*ep*kap + m1,-1/2*r^3*ep*kap*al + r^2*F*N + 1/3*r^3*lam - m,N*ep*al + N*ep + ep1*al,2/3*r^3*lam + r^2*F1 + 2*r*m1 - 2*m,-1/2*r^2*ep1*kap - r*ep*kap + m2,1/2*r^4*F1*ep*kap*al - 1/2*r^4*F*ep1*kap*al - 1/2*r^3*F*ep*kap*al + r^3*F^2*N1 - 1/3*r^4*F1*lam + 1/3*r^3*F*lam + r*F1*m - r*F*m1 + 2*F*m;
ideal G_C01_G22=std(I_C01_G22);
