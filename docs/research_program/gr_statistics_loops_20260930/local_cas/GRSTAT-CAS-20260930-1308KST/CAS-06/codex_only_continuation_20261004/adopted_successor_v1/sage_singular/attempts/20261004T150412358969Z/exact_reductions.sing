ideal G_C01_G11=std(I_C01_G11);
poly P_C01_G11=8388608*r^2*ep*kap*al - 16777216*r*F*N - 8388608*r^2*lam - 8388608*F + 8388608;
poly Z_C01_G11=reduce(P_C01_G11,G_C01_G11);
