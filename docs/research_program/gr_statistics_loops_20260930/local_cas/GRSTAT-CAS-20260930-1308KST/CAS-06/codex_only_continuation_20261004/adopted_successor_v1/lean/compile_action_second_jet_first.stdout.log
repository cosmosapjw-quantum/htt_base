hνder : deriv ν r = CAS06Adopted.tovNuJet (μ * r ^ 3) κ α ε₀ Λ r (CAS06Adopted.massLapse m Λ r)
hPder :
  HasDerivAt (actionRadialPressure Pstar (CAS06Scalar.exponent α) ν q)
    (-(actionRadialEnergy Pstar (CAS06Scalar.exponent α) ν q r +
          actionRadialPressure Pstar (CAS06Scalar.exponent α) ν q r) *
      deriv ν r)
    r
hPder' :
  HasDerivAt (actionRadialPressure Pstar (CAS06Scalar.exponent α) ν q)
    (-(ε₀ + p₀) * CAS06Adopted.tovNuJet (μ * r ^ 3) κ α ε₀ Λ r (CAS06Adopted.massLapse m Λ r)) r
hFder :
  HasDerivAt (CAS06Adopted.massLapse m Λ)
    (CAS06Adopted.massLapseJet (m r) (κ * r ^ 2 * actionRadialEnergy Pstar (CAS06Scalar.exponent α) ν q r / 2) Λ r) r
⊢ HasDerivAt (deriv ν)
    (CAS06Adopted.tovNuSecondJet (μ * r ^ 3) (κ * r ^ 2 * ε₀ / 2) κ p₀
      (-(ε₀ + p₀) * CAS06Adopted.tovNuJet (μ * r ^ 3) κ α ε₀ Λ r (CAS06Adopted.massLapse m Λ r)) Λ
      (CAS06Adopted.massLapse m Λ r) (CAS06Adopted.massLapseJet (μ * r ^ 3) (κ * r ^ 2 * ε₀ / 2) Λ r) r)
    r
