CoefficientMatrixBridge.coefficientMatrix_eq (D : M3) (beta : V3) :
  coefficientMatrix D beta = timeCoefficient D beta • 1 + spatialBlock D beta
'CoefficientMatrixBridge.coefficientMatrix_eq' depends on axioms: [propext, Classical.choice, Quot.sound]
CoefficientMatrixBridge.quadrupoleCoefficient_trace (D : M3) (beta : V3) :
  Matrix.trace (quadrupoleCoefficient D beta) = 0
'CoefficientMatrixBridge.quadrupoleCoefficient_trace' depends on axioms: [propext, Classical.choice, Quot.sound]
CoefficientMatrixBridge.quadrupoleCoefficient_symmetric (D : M3) (hD : ∀ (i j : Fin 3), D i j = D j i) (beta : V3)
  (i j : Fin 3) : quadrupoleCoefficient D beta i j = quadrupoleCoefficient D beta j i
'CoefficientMatrixBridge.quadrupoleCoefficient_symmetric' depends on axioms: [propext, Classical.choice, Quot.sound]
CoefficientMatrixBridge.algebraic_sky_expansion (D : M3) (hD : ∀ (i j : Fin 3), D i j = D j i) (beta n : V3)
  (hn : q n = 1) :
  observerNull n ⬝ᵥ Matrix.mulVec (boostedB D beta) (observerNull n) =
    monopoleCoefficient D beta + dot3 (dipoleMap D beta) n + dot3 n (Matrix.mulVec (quadrupoleCoefficient D beta) n)
'CoefficientMatrixBridge.algebraic_sky_expansion' depends on axioms: [propext, Classical.choice, Quot.sound]
CoefficientMatrixBridge.coefficientMatrix_zero (D : M3) : coefficientMatrix D 0 = D
'CoefficientMatrixBridge.coefficientMatrix_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
CoefficientMatrixBridge.coefficientMatrix_perturbation_exact (D : M3) (hD : ∀ (i j : Fin 3), D i j = D j i)
  (beta : V3) :
  coefficientMatrix D beta - D =
    (gamma beta ^ 2 * sourceQuadratic D beta) • 1 +
        boostA beta • (outer beta (Matrix.mulVec D beta) + outer (Matrix.mulVec D beta) beta) +
      (boostA beta ^ 2 * sourceQuadratic D beta) • outer beta beta
'CoefficientMatrixBridge.coefficientMatrix_perturbation_exact' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
CoefficientMatrixBridge.coefficientMatrix_perturbation_norm_pointwise (D : M3) (hD : ∀ (i j : Fin 3), D i j = D j i)
  (beta : V3) (hbeta : q beta < 1) :
  opNorm (coefficientMatrix D beta - D) ≤ 2 * opNorm D / (1 - q beta) * eNorm beta ^ 2
'CoefficientMatrixBridge.coefficientMatrix_perturbation_norm_pointwise' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
CoefficientMatrixBridge.coefficientMatrix_perturbation_norm_ball (D : M3) (hD : ∀ (i j : Fin 3), D i j = D j i)
  (beta : V3) (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1) (hbeta : eNorm beta ≤ r) :
  opNorm (coefficientMatrix D beta - D) ≤ 2 * opNorm D / (1 - r ^ 2) * eNorm beta ^ 2
