        (beta : V3) :
        coefficientMatrix D beta - D =
          (gamma beta ^ 2 * sourceQuadratic D beta) • (1 : M3) +
              boostA beta • (outer beta (D.mulVec beta) + outer (D.mulVec beta) beta) +
