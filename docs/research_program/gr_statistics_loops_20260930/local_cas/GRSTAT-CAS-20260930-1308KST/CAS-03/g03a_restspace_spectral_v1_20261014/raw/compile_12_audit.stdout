G03A.axis_limit : ∀ (v : GRSTATCAS04.Vec4 → GRSTATCAS04.Vec4),
  ContinuousAt v 0 →
    ∀ (P : GRSTATCAS04.Vec4 → Prop),
      (∀ᶠ (q : GRSTATCAS04.Vec4) in nhds 0, P q) →
        ∀ (a : Fin 4) (F : GRSTATCAS04.Vec4 → ℝ),
          Continuous F → (∀ (t : ℝ), t ≠ 0 → P (t • G04A.coordVec a) → F (v (t • G04A.coordVec a)) = 0) → F (v 0) = 0
