@G03A.D3_branch_simple : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E] [CompleteSpace E]
  (n : ℕ),
  1 ≤ n →
    ∀ (D : Set E),
      IsOpen D →
        ∀ (Sfam : E → GRSTATCAS04.Mat4),
          ContDiffOn ℝ (↑n) Sfam D →
            (∀ q ∈ D, G04A.EtaSelfAdjoint (Sfam q)) →
              ∀ q0 ∈ D,
                ∀ (u0 : GRSTATCAS04.Vec4) (s0 : ℝ),
                  GRSTATCAS04.matVec (Sfam q0) u0 = s0 • u0 →
                    GRSTATCAS04.lorentzDot u0 u0 = -1 →
                      0 < u0 0 →
                        Module.finrank ℝ ↥(Module.End.eigenspace (G03A.matVecL (Sfam q0)) s0) = 1 →
                          ∃ V u s, q0 ∈ V ∧ V ⊆ D ∧ u q0 = u0 ∧ s q0 = s0 ∧ G03A.TimelikeBranch n Sfam V u s
'G03A.D3_branch_simple' depends on axioms: [propext, Classical.choice, Quot.sound]
G03A.e0v_apply : ∀ (a : Fin 4), G03A.e0v a = if a = 0 then 1 else 0
