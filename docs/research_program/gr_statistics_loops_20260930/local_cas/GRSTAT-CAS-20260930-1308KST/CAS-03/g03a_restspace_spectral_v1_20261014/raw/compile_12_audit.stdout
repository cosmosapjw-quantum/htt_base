  ContDiff ℝ (↑n) G03A.Srot ∧
    (∀ (q : GRSTATCAS04.Vec4), G04A.EtaSelfAdjoint (G03A.Srot q)) ∧
      GRSTATCAS04.matVec (G03A.Srot 0) G03A.e0v = 0 • G03A.e0v ∧
        GRSTATCAS04.lorentzDot G03A.e0v G03A.e0v = -1 ∧
