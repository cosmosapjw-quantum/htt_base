            (Mathlib.Tactic.Ring.Common.add_pf_add_zero (b ^ Nat.rawCast 2 * (o ^ Nat.rawCast 1 * Nat.rawCast 1) + 0))))
        (Mathlib.Tactic.Ring.Common.mul_congr
