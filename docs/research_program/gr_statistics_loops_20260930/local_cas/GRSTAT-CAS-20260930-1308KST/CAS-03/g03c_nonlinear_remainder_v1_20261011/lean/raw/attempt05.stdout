'NonlinearRemainder.remainder_norm_le_quadratic_ball' depends on axioms: [propext,
 sorryAx,
 Classical.choice,
 Quot.sound]
NonlinearRemainder.remainder_norm_le_half (D : M3) (hD : ∀ (i j : Fin 3), D i j = D j i) (beta : V3)
  (hbeta : eNorm beta ≤ 1 / 2) :
  eNorm (remainder D beta) ≤ 8 / 3 * opNorm D * eNorm beta ^ 3 ∧
    eNorm (remainder D beta) ≤ 4 / 3 * opNorm D * eNorm beta ^ 2
theorem NonlinearRemainder.remainder_norm_le_half : ∀ (D : M3),
  (∀ (i j : Fin 3), D i j = D j i) →
    ∀ (beta : V3),
      eNorm beta ≤ 1 / 2 →
        eNorm (remainder D beta) ≤ 8 / 3 * opNorm D * eNorm beta ^ 3 ∧
          eNorm (remainder D beta) ≤ 4 / 3 * opNorm D * eNorm beta ^ 2 :=
fun D hD beta hbeta => ⟨sorry, sorry⟩
