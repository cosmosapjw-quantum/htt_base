'NonlinearRemainder.remainder_factorization' depends on axioms: [propext, Classical.choice, Quot.sound]
NonlinearRemainder.remainder_norm_le_pointwise (D : M3) (hD : ∀ (i j : Fin 3), D i j = D j i) (beta : V3)
  (hbeta : q beta < 1) : eNorm (remainder D beta) ≤ 2 * opNorm D / (1 - q beta) * eNorm beta ^ 3
theorem NonlinearRemainder.remainder_norm_le_pointwise : ∀ (D : M3),
  (∀ (i j : Fin 3), D i j = D j i) →
    ∀ (beta : V3), q beta < 1 → eNorm (remainder D beta) ≤ 2 * opNorm D / (1 - q beta) * eNorm beta ^ 3 :=
fun D hD beta hbeta =>
  let b := eNorm beta;
  let a := boostA beta;
  let g := gamma beta;
  let o := opNorm D;
  have hb := norm_nonneg (toE beta);
  have ho := norm_nonneg (matrixOp D);
  have hq := Eq.symm (eNorm_sq beta);
  have hqn := Eq.mpr (id (congrArg (fun _a => 0 ≤ _a) hq)) (Even.pow_nonneg (even_two_mul 1) b);
  have hg := gamma_pos beta hbeta;
  have ha := boostA_nonneg beta hbeta;
  have hden := sub_pos.mpr hbeta;
  have hsource :=
