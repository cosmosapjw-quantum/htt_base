InverseTruncationSynthesis.exact_inverse_linear (D : M3) (beta : V3) (hdet : Matrix.det D ≠ 0) :
  beta = exactEstimate D (linearSignal D beta)
'InverseTruncationSynthesis.exact_inverse_linear' depends on axioms: [propext, Classical.choice, Quot.sound]
InverseTruncationSynthesis.exact_inverse_nonlinear_defect (D : M3) (beta : V3) (hdet : Matrix.det D ≠ 0) :
  beta - exactEstimate D (dipoleMap D beta) = (1 / 2) • Matrix.mulVec D⁻¹ (remainder D beta)
'InverseTruncationSynthesis.exact_inverse_nonlinear_defect' depends on axioms: [propext,
 sorryAx,
 Classical.choice,
 Quot.sound]
InverseTruncationSynthesis.exact_inverse_error_le_remainder (D : M3) (beta : V3) (hdet : Matrix.det D ≠ 0) :
  eNorm (beta - exactEstimate D (dipoleMap D beta)) ≤ opNorm D⁻¹ / 2 * eNorm (remainder D beta)
'InverseTruncationSynthesis.exact_inverse_error_le_remainder' depends on axioms: [propext,
 sorryAx,
 Classical.choice,
 Quot.sound]
InverseTruncationSynthesis.exact_inverse_error_pointwise (D : M3) (hD : ∀ (i j : Fin 3), D i j = D j i)
  (hdet : Matrix.det D ≠ 0) (beta : V3) (hbeta : q beta < 1) :
  eNorm (beta - exactEstimate D (dipoleMap D beta)) ≤ opNorm D⁻¹ * opNorm D / (1 - q beta) * eNorm beta ^ 3
'InverseTruncationSynthesis.exact_inverse_error_pointwise' depends on axioms: [propext,
 sorryAx,
 Classical.choice,
 Quot.sound]
InverseTruncationSynthesis.exact_inverse_error_ball (D : M3) (hD : ∀ (i j : Fin 3), D i j = D j i)
  (hdet : Matrix.det D ≠ 0) (beta : V3) (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1) (hbeta : eNorm beta ≤ r) :
  eNorm (beta - exactEstimate D (dipoleMap D beta)) ≤ opNorm D⁻¹ * opNorm D / (1 - r ^ 2) * eNorm beta ^ 3 ∧
    eNorm (beta - exactEstimate D (dipoleMap D beta)) ≤ r * opNorm D⁻¹ * opNorm D / (1 - r ^ 2) * eNorm beta ^ 2
'InverseTruncationSynthesis.exact_inverse_error_ball' depends on axioms: [propext,
 sorryAx,
 Classical.choice,
 Quot.sound]
InverseTruncationSynthesis.trunc_linear_defect (D : M3) (beta : V3) (hH : H D ≠ 0) :
  beta - truncEstimate D hH (linearSignal D beta) = linearDefect D hH beta
'InverseTruncationSynthesis.trunc_linear_defect' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
InverseTruncationSynthesis.trunc_nonlinear_defect (D : M3) (beta : V3) (hH : H D ≠ 0) :
  beta - truncEstimate D hH (dipoleMap D beta) =
    linearDefect D hH beta + (1 / (2 * H D)) • Matrix.mulVec (1 - (1 / H D) • sigma D) (remainder D beta)
'InverseTruncationSynthesis.trunc_nonlinear_defect' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
InverseTruncationSynthesis.trunc_nonlinear_residual_le_remainder (D : M3) (beta : V3) (hH : H D ≠ 0) :
  eNorm (beta - truncEstimate D hH (dipoleMap D beta) - linearDefect D hH beta) ≤
    truncGain D hH * eNorm (remainder D beta)
'InverseTruncationSynthesis.trunc_nonlinear_residual_le_remainder' depends on axioms: [propext,
 sorryAx,
 Classical.choice,
 Quot.sound]
InverseTruncationSynthesis.trunc_error_ball (D : M3) (hD : ∀ (i j : Fin 3), D i j = D j i) (hH : H D ≠ 0) (beta : V3)
  (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1) (hbeta : eNorm beta ≤ r) :
  eNorm (beta - truncEstimate D hH (dipoleMap D beta)) ≤
      opNorm (sigma D) ^ 2 / H D ^ 2 * eNorm beta + truncGain D hH * (2 * opNorm D / (1 - r ^ 2)) * eNorm beta ^ 3 ∧
    eNorm (beta - truncEstimate D hH (dipoleMap D beta)) ≤
      opNorm (sigma D) ^ 2 / H D ^ 2 * eNorm beta + truncGain D hH * (2 * r * opNorm D / (1 - r ^ 2)) * eNorm beta ^ 2
'InverseTruncationSynthesis.trunc_error_ball' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
InverseTruncationSynthesis.zeroH_exact_only_control :
  H CAS03C03.zeroHD = 0 ∧ Matrix.det CAS03C03.zeroHD = -2 ∧ ¬H CAS03C03.zeroHD ≠ 0
'InverseTruncationSynthesis.zeroH_exact_only_control' depends on axioms: [propext, Classical.choice, Quot.sound]
InverseTruncationSynthesis.zeroH_exact_error_ball (beta : V3) (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1)
  (hbeta : eNorm beta ≤ r) :
  eNorm (beta - exactEstimate CAS03C03.zeroHD (dipoleMap CAS03C03.zeroHD beta)) ≤
