G05BGerm.EF3_local_germ : ∀ (b Λ κ : ℝ),
  0 < b →
    Λ < 3 * b →
      0 < κ →
        ∀ (k : G05AConformalDEC.I → G05AConformalDEC.I → ℝ) (n : ℕ),
          1 ≤ n →
            ∃ r u ε,
              0 < r ∧
                G05BCubicDEC.gCub b k 0 = G05AConformalDEC.gConf b 0 0 ∧
                  (∀ (c a e : G05AConformalDEC.I),
                      G05AConformalDEC.dg (G05BCubicDEC.gCub b k) c a e 0 =
                        G05AConformalDEC.dg (G05AConformalDEC.gConf b 0) c a e 0) ∧
                    (∀ (d c a e : G05AConformalDEC.I),
                        G05AConformalDEC.pd (fun y => G05AConformalDEC.dg (G05BCubicDEC.gCub b k) c a e y) d 0 =
                          G05AConformalDEC.pd (fun y => G05AConformalDEC.dg (G05AConformalDEC.gConf b 0) c a e y) d 0) ∧
                      (∀ (x : G05AConformalDEC.I → ℝ),
                          ‖x‖ < r →
                            G05BCubicDEC.Lorentzian (G05BCubicDEC.gCub b k x) ∧
                              G05AConformalDEC.StrictDEC (G05BCubicDEC.gCub b k x)
                                  (G05AConformalDEC.stress (G05BCubicDEC.gCub b k) Λ κ x) ∧
                                G05BIFT.FutureUnitEigenG (G05BCubicDEC.gCub b k x) (G05BGerm.Tmix b k Λ κ x) (u x)
                                    (ε x) ∧
                                  G05BIFT.RestGapG (G05BCubicDEC.gCub b k x) (G05BGerm.Tmix b k Λ κ x) (u x) (ε x) ∧
                                    ContDiffAt ℝ (↑n) u x ∧ ContDiffAt ℝ (↑n) ε x) ∧
                        u 0 = G05BCubicDEC.e0 ∧
                          ε 0 = (6 * b - Λ) / κ ∧
                            G05AConformalDEC.stress (G05BCubicDEC.gCub b k) Λ κ 0 =
                                G05AConformalDEC.diagT ((6 * b - Λ) / κ) (Λ / κ) ∧
                              G05BGerm.stdFrame 0 = u 0 ∧
                                (∀ (μ ν : G05AConformalDEC.I),
                                    G05AConformalDEC.bil (G05BCubicDEC.gCub b k 0) (G05BGerm.stdFrame μ)
                                        (G05BGerm.stdFrame ν) =
                                      G05AConformalDEC.eta μ ν) ∧
                                  (∀ (μ i : G05AConformalDEC.I),
                                      i ≠ 0 →
                                        G05AConformalDEC.pd
                                            (fun y => G05AConformalDEC.stress (G05BCubicDEC.gCub b k) Λ κ y 0 i) μ 0 =
                                          (if μ = 0 then G05BCubicDEC.q b k i else G05BCubicDEC.M b k i μ) / κ) ∧
                                    (∀ (μ i : G05AConformalDEC.I),
                                        i ≠ 0 →
                                          G05BGerm.rate (G05BCubicDEC.gCub b k) u 0 G05BGerm.stdFrame μ i = k μ i) ∧
                                      ∀ᶠ (p : (G05AConformalDEC.I → ℝ) × (G05AConformalDEC.I → ℝ) × ℝ) in
                                        nhds (0, G05BCubicDEC.e0, -((6 * b - Λ) / κ)),
                                        G05BIFT.borderedG (G05BCubicDEC.gCub b k) (G05BGerm.Tmix b k Λ κ) p = 0 →
                                          p.2 = (u p.1, -ε p.1)
'G05BGerm.EF3_local_germ' depends on axioms: [propext, Classical.choice, Quot.sound]
G05BGerm.EF3_local_germ_unique : ∀ (b Λ κ : ℝ),
  0 < b →
    Λ < 3 * b →
      0 < κ →
        ∀ (k : G05AConformalDEC.I → G05AConformalDEC.I → ℝ) (n : ℕ),
          1 ≤ n →
            ∃ r u ε,
              0 < r ∧
                (∀ (x : G05AConformalDEC.I → ℝ),
                    ‖x‖ < r →
                      G05BCubicDEC.Lorentzian (G05BCubicDEC.gCub b k x) ∧
                        G05AConformalDEC.StrictDEC (G05BCubicDEC.gCub b k x)
                            (G05AConformalDEC.stress (G05BCubicDEC.gCub b k) Λ κ x) ∧
                          G05BIFT.FutureUnitEigenG (G05BCubicDEC.gCub b k x) (G05BGerm.Tmix b k Λ κ x) (u x) (ε x) ∧
                            G05BIFT.RestGapG (G05BCubicDEC.gCub b k x) (G05BGerm.Tmix b k Λ κ x) (u x) (ε x) ∧
                              ContDiffAt ℝ (↑n) u x ∧
                                ContDiffAt ℝ (↑n) ε x ∧
                                  ∀ (v : G05AConformalDEC.I → ℝ) (μ : ℝ),
                                    G05BIFT.FutureUnitEigenG (G05BCubicDEC.gCub b k x) (G05BGerm.Tmix b k Λ κ x) v μ →
                                      v = u x ∧ μ = ε x) ∧
                  u 0 = G05BCubicDEC.e0 ∧
                    ε 0 = (6 * b - Λ) / κ ∧
                      ∀ (μ i : G05AConformalDEC.I),
                        i ≠ 0 → G05BGerm.rate (G05BCubicDEC.gCub b k) u 0 G05BGerm.stdFrame μ i = k μ i
