  {Γ : G14A.Pt → Fin 4 → Fin 4 → Fin 4 → ℝ} {U : G14A.Pt → G14A.Pt} {p X : G14A.Pt}
  (ch : G14A.CalibratedDerivativeChannel g u Γ U p X),
  Filter.Tendsto (G14A.finiteBaselineMap g u ch.Tr U ch.q p) (nhdsWithin 0 {0}ᶜ) (nhds (G14A.Jchan g u Γ U p X))
'G14A.CalibratedDerivativeChannel.tendsto_J' depends on axioms: [propext, Classical.choice, Quot.sound]
G14A.gammaMat_Γ0 : ∀ (p X : G14A.Pt), G14A.gammaMat PORTCAS03VelocityJetDecomposition.Γ0 p X = 0
'G14A.gammaMat_Γ0' depends on axioms: [propext, Classical.choice, Quot.sound]
G14A.gammaOp_Γ0 : ∀ (p X : G14A.Pt), G14A.gammaOp PORTCAS03VelocityJetDecomposition.Γ0 p X = 0
