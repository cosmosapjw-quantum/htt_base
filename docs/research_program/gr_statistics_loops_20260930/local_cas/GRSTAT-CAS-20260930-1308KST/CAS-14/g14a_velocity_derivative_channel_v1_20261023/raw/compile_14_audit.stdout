  Nonempty
    (G14A.CalibratedDerivativeChannel PORTCAS03VelocityJetDecomposition.gMink PORTCAS03VelocityJetDecomposition.uEx
      PORTCAS03VelocityJetDecomposition.Γ0 (fun y => c • PORTCAS03VelocityJetDecomposition.uEx y) 0 (Pi.single 1 1))
'G14A.channel_nonvacuous' depends on axioms: [propext, Classical.choice, Quot.sound]
G14A.uRest_diff : ∀ (x : G14A.Pt),
  PORTCAS03VelocityJetDecomposition.FieldDiffAt PORTCAS03VelocityJetDecomposition.gMink
    PORTCAS03VelocityJetDecomposition.uRest x
'G14A.uRest_diff' depends on axioms: [propext, Classical.choice, Quot.sound]
G14A.zeroth_order_insufficient : ∀ (c : ℝ),
  c • PORTCAS03VelocityJetDecomposition.uRest 0 = c • PORTCAS03VelocityJetDecomposition.uEx 0 ∧
    G14A.Jchan PORTCAS03VelocityJetDecomposition.gMink PORTCAS03VelocityJetDecomposition.uRest
          PORTCAS03VelocityJetDecomposition.Γ0 (fun y => c • PORTCAS03VelocityJetDecomposition.uRest y) 0
          (Pi.single 1 1) =
        0 ∧
      G14A.Jchan PORTCAS03VelocityJetDecomposition.gMink PORTCAS03VelocityJetDecomposition.uEx
          PORTCAS03VelocityJetDecomposition.Γ0 (fun y => c • PORTCAS03VelocityJetDecomposition.uEx y) 0
          (Pi.single 1 1) =
        ![0, 3 * c, 0, 0]
'G14A.zeroth_order_insufficient' depends on axioms: [propext, Classical.choice, Quot.sound]
@G14A.zeroth_order_functional_insufficient : ∀ {α : Type u_1} (Obs : G14A.Pt → G14A.Pt → α) (c : ℝ),
  c ≠ 0 →
    Obs 0 (c • PORTCAS03VelocityJetDecomposition.uRest 0) = Obs 0 (c • PORTCAS03VelocityJetDecomposition.uEx 0) ∧
      G14A.Jchan PORTCAS03VelocityJetDecomposition.gMink PORTCAS03VelocityJetDecomposition.uRest
          PORTCAS03VelocityJetDecomposition.Γ0 (fun y => c • PORTCAS03VelocityJetDecomposition.uRest y) 0
          (Pi.single 1 1) ≠
        G14A.Jchan PORTCAS03VelocityJetDecomposition.gMink PORTCAS03VelocityJetDecomposition.uEx
          PORTCAS03VelocityJetDecomposition.Γ0 (fun y => c • PORTCAS03VelocityJetDecomposition.uEx y) 0 (Pi.single 1 1)
'G14A.zeroth_order_functional_insufficient' depends on axioms: [propext, Classical.choice, Quot.sound]
