{ sourceIdentification := G14A.SupplyStatus.notSupplied, transportRule := G14A.SupplyStatus.notSupplied,
  tangentDirections := G14A.SupplyStatus.notSupplied, baselineLength := G14A.SupplyStatus.notSupplied,
  clockCalibration := G14A.SupplyStatus.notSupplied, lengthCalibration := G14A.SupplyStatus.notSupplied,
  nonrotatingFrame := G14A.SupplyStatus.notSupplied, opticalSymmetricRate := G14A.SupplyStatus.notSupplied,
  finiteBaselineRemainder := G14A.SupplyStatus.notSupplied }
