// Exact independent Singular polynomial reductions over Q.
ring r=0,(x1,x2,x3,z1,z2,z3,o1,o2,o3,v1,v2,v3,a,b,d1,d2,d3),dp;
ideal unit=x1^2+x2^2+x3^2-1,z1^2+z2^2+z3^2-1;
ideal gb=std(unit);
poly wx1=o3*x2-o2*x3;
poly wx2=-o3*x1+o1*x3;
poly wx3=o2*x1-o1*x2;
poly y1=-wx1;poly y2=-wx2;poly y3=-wx3;
poly proj1=(x2*y3-x3*y2)-(o1-x1*(x1*o1+x2*o2+x3*o3));
poly proj2=(x3*y1-x1*y3)-(o2-x2*(x1*o1+x2*o2+x3*o3));
poly proj3=(x1*y2-x2*y1)-(o3-x3*(x1*o1+x2*o2+x3*o3));
print("C01_projection_remainders:");
print(reduce(proj1,gb));print(reduce(proj2,gb));print(reduce(proj3,gb));
poly cx1=x2*z3-x3*z2;poly cx2=x3*z1-x1*z3;poly cx3=x1*z2-x2*z1;
poly crosssq=cx1^2+cx2^2+cx3^2;
poly dot=x1*z1+x2*z2+x3*z3;
print("C02_cross_norm_remainder:");
print(reduce(crosssq-(1-dot^2),gb));
poly g11=a*(1-x1^2)+b*(1-z1^2);
poly g22=a*(1-x2^2)+b*(1-z2^2);
poly g33=a*(1-x3^2)+b*(1-z3^2);
poly g12=-a*x1*x2-b*z1*z2;
poly g13=-a*x1*x3-b*z1*z3;
poly g23=-a*x2*x3-b*z2*z3;
poly detg=g11*(g22*g33-g23^2)-g12*(g12*g33-g13*g23)+g13*(g12*g23-g13*g22);
print("C02_determinant_remainder:");
print(reduce(detg-a*b*(a+b)*crosssq,gb));
poly dw12=d3;poly dw21=-d3;
poly dw13=-d2;poly dw31=d2;
poly dw23=d1;poly dw32=-d1;
poly frob=dw12^2+dw21^2+dw13^2+dw31^2+dw23^2+dw32^2-2*(d1^2+d2^2+d3^2);
print("C03_frobenius_remainder:");
print(frob);
quit;
