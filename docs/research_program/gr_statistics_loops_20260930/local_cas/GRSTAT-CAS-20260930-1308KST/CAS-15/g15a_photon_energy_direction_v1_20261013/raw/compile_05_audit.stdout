@H1_null_L : ∀ {c : ℝ} {U e : V},
  mink U U = -c ^ 2 → mink e U = 0 → mink e e = 1 → mink (Lvec c U e) (Lvec c U e) = 0 ∧ mink (Lvec c U e) U = -c ^ 2
@H1_photon_energy : ∀ {c E : ℝ} {U e : V},
  0 < c →
    mink U U = -c ^ 2 →
      mink e U = 0 →
        mink e e = 1 →
          mink (pvec c E U e) (pvec c E U e) = 0 ∧ -mink (pvec c E U e) U = E ∧ hproj c U (pvec c E U e) = (E / c) • e
@H1_photon_decomposition : ∀ {c E : ℝ} {U p : V},
  0 < c →
    0 < E →
      mink U U = -c ^ 2 →
        mink p p = 0 →
          -mink p U = E →
            mink (restDir c E U p) U = 0 ∧
              mink (restDir c E U p) (restDir c E U p) = 1 ∧ p = pvec c E U (restDir c E U p)
@H2_energy_derivative : ∀ {c θ : ℝ} {σ W : LinearMap.BilinForm ℝ V} {A : V} {U e : ℝ → V} {E : ℝ → ℝ} {t : ℝ}
  {U' e' : V} {E' : ℝ},
  0 < c →
    0 < E t →
      mink (U t) (U t) = -c ^ 2 →
        (∀ᶠ (s : ℝ) in nhds t, mink (e s) (U s) = 0) →
          mink (e t) (e t) = 1 →
            (∀ (X Y : V), (σ X) Y = (σ Y) X) →
              (∀ (Y : V), (σ (U t)) Y = 0) →
                (∀ (X Y : V), (W X) Y = -(W Y) X) →
                  (∀ (X : V), (W X) (U t) = 0) →
                    mink A (U t) = 0 →
                      HasDerivAt U U' t →
                        HasDerivAt e e' t →
                          HasDerivAt E E' t →
                            (∀ (Y : V), mink U' Y = Qjet c θ σ W A (U t) (Lvec c (U t) (e t)) Y) →
                              HasDerivAt (fun s => pvec c (E s) (U s) (e s)) 0 t →
                                HasDerivAt (fun s => Real.log (E s)) (-Rrate c θ σ A (e t)) t
@H3_direction_derivative : ∀ {c θ : ℝ} {σ W : LinearMap.BilinForm ℝ V} {A : V} {U e : ℝ → V} {E : ℝ → ℝ} {t : ℝ}
  {U' e' : V} {E' : ℝ},
  0 < c →
    0 < E t →
      mink (U t) (U t) = -c ^ 2 →
        (∀ᶠ (s : ℝ) in nhds t, mink (e s) (U s) = 0) →
          mink (e t) (e t) = 1 →
            (∀ (X Y : V), (σ X) Y = (σ Y) X) →
              (∀ (Y : V), (σ (U t)) Y = 0) →
                (∀ (X Y : V), (W X) Y = -(W Y) X) →
                  (∀ (X : V), (W X) (U t) = 0) →
                    mink A (U t) = 0 →
                      HasDerivAt U U' t →
                        HasDerivAt e e' t →
                          HasDerivAt E E' t →
                            (∀ (Y : V), mink U' Y = Qjet c θ σ W A (U t) (Lvec c (U t) (e t)) Y) →
                              HasDerivAt (fun s => pvec c (E s) (U s) (e s)) 0 t →
                                ∀ (Y : V), mink (hproj c (U t) e') Y = -Fcov c σ A (e t) Y + (W Y) (e t)
@H4_W_convention_flip : ∀ {c θ : ℝ} {σ W : LinearMap.BilinForm ℝ V} {A : V} {U e : ℝ → V} {E : ℝ → ℝ} {t : ℝ}
  {U' e' : V} {E' : ℝ},
  0 < c →
    0 < E t →
      mink (U t) (U t) = -c ^ 2 →
        (∀ᶠ (s : ℝ) in nhds t, mink (e s) (U s) = 0) →
          mink (e t) (e t) = 1 →
            (∀ (X Y : V), (σ X) Y = (σ Y) X) →
              (∀ (Y : V), (σ (U t)) Y = 0) →
                (∀ (X Y : V), (W X) Y = -(W Y) X) →
                  (∀ (X : V), (W X) (U t) = 0) →
                    mink A (U t) = 0 →
                      HasDerivAt U U' t →
                        HasDerivAt e e' t →
                          HasDerivAt E E' t →
                            (∀ (Y : V), mink U' Y = Qjet c θ σ W A (U t) (Lvec c (U t) (e t)) Y) →
                              HasDerivAt (fun s => pvec c (E s) (U s) (e s)) 0 t →
                                (∃ Y, (W Y) (e t) ≠ 0) →
                                  ¬∀ (Y : V), mink (hproj c (U t) e') Y = -Fcov c σ A (e t) Y - (W Y) (e t)
@H4_direction_flip : ∀ {c θ : ℝ} {σ W : LinearMap.BilinForm ℝ V} {A : V} {U e : ℝ → V} {E : ℝ → ℝ} {t : ℝ} {U' e' : V}
  {E' : ℝ},
  0 < c →
    0 < E t →
      mink (U t) (U t) = -c ^ 2 →
        (∀ᶠ (s : ℝ) in nhds t, mink (e s) (U s) = 0) →
          mink (e t) (e t) = 1 →
            (∀ (X Y : V), (σ X) Y = (σ Y) X) →
              (∀ (Y : V), (σ (U t)) Y = 0) →
                (∀ (X Y : V), (W X) Y = -(W Y) X) →
                  (∀ (X : V), (W X) (U t) = 0) →
                    mink A (U t) = 0 →
                      HasDerivAt U U' t →
                        HasDerivAt e e' t →
                          HasDerivAt E E' t →
                            (∀ (Y : V), mink U' Y = Qjet c θ σ W A (U t) (Lvec c (U t) (e t)) Y) →
                              HasDerivAt (fun s => pvec c (E s) (U s) (e s)) 0 t →
                                mink A (e t) ≠ 0 → ¬HasDerivAt (fun s => Real.log (E s)) (-Rrate c θ σ A (-e t)) t
H4_concrete_controls : HasDerivAt (fun s => Real.log (Ew s)) (-Rrate 1 3 0 Aw (ew 0)) 0 ∧
  (∀ (Y : V), mink (hproj 1 (Uw 0) 0) Y = -Fcov 1 0 Aw (ew 0) Y + (Ww Y) (ew 0)) ∧
    (¬∀ (Y : V), mink (hproj 1 (Uw 0) 0) Y = -Fcov 1 0 Aw (ew 0) Y - (Ww Y) (ew 0)) ∧
      ¬HasDerivAt (fun s => Real.log (Ew s)) (-Rrate 1 3 0 Aw (-ew 0)) 0
'G15A.H1_null_L' depends on axioms: [propext, Classical.choice, Quot.sound]
