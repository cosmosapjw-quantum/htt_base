@ContDiffOn.fderiv_of_isOpen : ∀ {𝕜 : Type u_1} [inst : NontriviallyNormedField 𝕜] {E : Type u_2}
  [inst_1 : NormedAddCommGroup E] [inst_2 : NormedSpace 𝕜 E] {F : Type u_3} [inst_3 : NormedAddCommGroup F]
  [inst_4 : NormedSpace 𝕜 F] {s : Set E} {f : E → F} {m n : WithTop ℕ∞},
  ContDiffOn 𝕜 n f s → IsOpen s → m + 1 ≤ n → ContDiffOn 𝕜 m (fderiv 𝕜 f) s
