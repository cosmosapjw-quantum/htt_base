CAS13MeasureComposition.integral_hermite : ∀ (μ : Measure ℝ) [IsProbabilityMeasure μ] {c0 c3 c4 m3 m4 : ℝ},
  Integrable (fun x => x ^ 3) μ →
    Integrable (fun x => x ^ 4) μ →
      CAS13MeasureComposition.moment μ 3 = m3 →
        CAS13MeasureComposition.moment μ 4 = m4 →
          ∫ (x : ℝ), CAS13MeasureComposition.hermite c0 c3 c4 x ∂μ = c0 + c3 * m3 + c4 * m4
CAS13MeasureComposition.moment_twoDirac : ∀ (p : ℕ) {w a u : ℝ},
  0 ≤ w →
    w ≤ 1 → CAS13MeasureComposition.moment (CAS13MeasureComposition.twoDirac w a u) p = (1 - w) * a ^ p + w * u ^ p
