  "semantics": {
    "exact_statement": {
      "definition": "For p=5,6 independently solve Q=c0+c3*y^3+c4*y^4 from Q(A)=A^p, Q(U)=U^p, Q'(U)=p U^(p-1).",
      "factorization": "y^p-Q=(y-A)(y-U)^2 P_p(y;A,U)/Delta(A,U).",
      "P5": "Delta*y^2+(2*A^2*U+A*U^2)*y+A^2*U^2",
      "P6": "Delta*y^3+(3*A^3+8*A^2*U+5*A*U^2+2*U^3)*y^2+(2*A^3*U+5*A^2*U^2+2*A*U^3)*y+A^3*U^2+2*A^2*U^3",
      "lower_sign": "A=a,U=u gives y^p-Q>=0 on [a,b]",
      "upper_sign": "A=b,U=d gives y^p-Q<=0 on [a,b]",
      "interpolation": "value at A,U and derivative at U; equality at support nodes",
      "moment_consequence": "Integrating Q against any probability measure with fixed m3,m4 gives c0+c3*m3+c4*m4; the two-node lower/upper measures attain equality if their weights are already admitted and match m3,m4."
    },
    "symbol_type_domain_map": {
      "lower": "0<a<u and y in [a,b] with b>=u",
      "upper": "0<d<b and y in [a,b] with a<=d",
      "powers": [
        5,
        6
      ],
      "delta": "Delta(A,U)=3 A^2+2 A U+U^2 >0"
    },
    "assumptions": [
      "positive ordered real nodes and interval membership exactly as stated"
    ],
    "positivity_nonzero_conditions": "Delta>0; retain node order before division",
    "branches": [],
    "exclusions": [
