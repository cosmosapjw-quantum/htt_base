ring r = 0,(A,U,y),dp;
option(redSB);
poly divisor = (y-A)*(y-U)^2;
poly n5 = -A^3*U^4 + 4*A^3*U*y^3 + 3*A^2*U^2*y^3 + 2*A*U^3*y^3 + U^4*y^3 - 3*A^3*y^4 - 6*A^2*U*y^4 - 4*A*U^2*y^4 - 2*U^3*y^4 + 3*A^2*y^5 + 2*A*U*y^5 + U^2*y^5;
poly target5 = A^2*U^2 + 2*A^2*U*y + A*U^2*y + 3*A^2*y^2 + 2*A*U*y^2 + U^2*y^2;
ideal i5 = divisor;
ideal gb5 = std(i5);
poly rem5 = reduce(n5,gb5);
poly qpoly5 = n5/divisor;
print("P5_NF_ZERO");
print(rem5==0);
print("P5_DIVISION_ZERO");
print(n5-qpoly5*divisor==0);
print("P5_TARGET_EQUAL");
print(qpoly5-target5==0);
print("P5_QUOTIENT");
print(qpoly5);
poly n6 = -A^4*U^4 - 2*A^3*U^5 + 4*A^4*U*y^3 + 8*A^3*U^2*y^3 + 6*A^2*U^3*y^3 + 4*A*U^4*y^3 + 2*U^5*y^3 - 3*A^4*y^4 - 6*A^3*U*y^4 - 9*A^2*U^2*y^4 - 6*A*U^3*y^4 - 3*U^4*y^4 + 3*A^2*y^6 + 2*A*U*y^6 + U^2*y^6;
poly target6 = A^3*U^2 + 2*A^2*U^3 + 2*A^3*U*y + 5*A^2*U^2*y + 2*A*U^3*y + 3*A^3*y^2 + 8*A^2*U*y^2 + 5*A*U^2*y^2 + 2*U^3*y^2 + 3*A^2*y^3 + 2*A*U*y^3 + U^2*y^3;
ideal i6 = divisor;
ideal gb6 = std(i6);
poly rem6 = reduce(n6,gb6);
poly qpoly6 = n6/divisor;
print("P6_NF_ZERO");
print(rem6==0);
print("P6_DIVISION_ZERO");
print(n6-qpoly6*divisor==0);
print("P6_TARGET_EQUAL");
print(qpoly6-target6==0);
print("P6_QUOTIENT");
print(qpoly6);
quit;
