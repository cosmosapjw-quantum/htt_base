CAS13MeasureExtremizerBridge.strictInterior_measure_extremizers {a b m3 m4 : ℝ}
  (h : CAS13C02.StrictInterior a b m3 m4) :
  ∃ u d,
    (CAS13C02.positiveCubeRoot m3 < u ∧ u < b ∧ (u ^ 4 - a ^ 4) / (u ^ 3 - a ^ 3) = (m4 - a ^ 4) / (m3 - a ^ 3)) ∧
      (a < d ∧ d < CAS13C02.positiveCubeRoot m3 ∧ (b ^ 4 - d ^ 4) / (b ^ 3 - d ^ 3) = (b ^ 4 - m4) / (b ^ 3 - m3)) ∧
        CAS13MeasureExtremizerBridge.LowerResult 5 a b u (CAS13C02.lowerWeight a m3 u) (CAS13C03.c05 a u)
            (CAS13C03.c35 a u) (CAS13C03.c45 a u) m3 m4 ∧
          CAS13MeasureExtremizerBridge.UpperResult 5 a b d (CAS13C02.upperWeight b m3 d) (CAS13C03.c05 b d)
              (CAS13C03.c35 b d) (CAS13C03.c45 b d) m3 m4 ∧
            CAS13MeasureExtremizerBridge.LowerResult 6 a b u (CAS13C02.lowerWeight a m3 u) (CAS13C03.c06 a u)
                (CAS13C03.c36 a u) (CAS13C03.c46 a u) m3 m4 ∧
              CAS13MeasureExtremizerBridge.UpperResult 6 a b d (CAS13C02.upperWeight b m3 d) (CAS13C03.c06 b d)
                (CAS13C03.c36 b d) (CAS13C03.c46 b d) m3 m4
'CAS13MeasureExtremizerBridge.strictInterior_measure_extremizers' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
