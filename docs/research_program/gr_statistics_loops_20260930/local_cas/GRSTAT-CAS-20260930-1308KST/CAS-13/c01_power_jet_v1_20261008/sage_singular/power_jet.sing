ring r = 0,(p,y),dp;
poly c0 = (p-3)*(p-4)/12;
poly c3 = p*(4-p)/3;
poly c4 = p*(p-3)/4;
poly q = c0+c3*y3+c4*y4;
poly q1 = subst(q,y,1);
poly qd1 = subst(diff(q,y),y,1);
poly qd2 = subst(diff(diff(q,y),y),y,1);
poly qd3 = diff(diff(diff(q,y),y),y);
poly third = 2*p*(4-p)+6*p*(p-3)*y;
poly unit = p*(p-1)*(p-2)-subst(qd3,y,1);
print("jet_value="+string(q1-1));
print("jet_first="+string(qd1-p));
print("jet_second="+string(qd2-p*(p-1)));
print("q_third="+string(qd3-third));
print("unit_factor="+string(unit-p*(p-3)*(p-4)));
print("unit_mismatch="+string(unit));
print("factorization=p*(p-3)*(p-4)");
quit;
