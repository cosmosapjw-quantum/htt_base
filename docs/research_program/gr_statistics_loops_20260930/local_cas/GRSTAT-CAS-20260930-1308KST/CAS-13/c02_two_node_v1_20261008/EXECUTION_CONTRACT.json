    "exact_statement": {
      "lower_node": "unique u in (r,b) with F_a(u)=target_lower",
      "upper_node": "unique d in (a,r) with G_b(d)=target_upper",
      "monotonicity": "F_a'(u)=u^2(3a^2+2au+u^2)/(a^2+au+u^2)^2>0 and G_b'(d)=d^2(3b^2+2bd+d^2)/(b^2+bd+d^2)^2>0",
      "weights": "0<w_u<1 and 0<w_b<1",
      "moment_matching": "(1-w_u)a^3+w_u u^3=m3 and (1-w_u)a^4+w_u u^4=m4; similarly (1-w_b)d^3+w_b b^3=m3 and fourth moment=m4",
      "normalization": "two weights in each measure sum to 1",
      "degeneracies": "Dirac boundary m4=m3^(4/3) is delta_r; chord boundary is endpoint mixture delta_a/delta_b; m3=a^3 or b^3 are endpoint Dirac limits. Do not substitute 0/0 node/weight formulas."
    },
    "symbol_type_domain_map": {
      "a_b": "0<a<b",
      "m3_m4": "a^3<m3<b^3 and m3^(4/3)<m4<a^4+(m3-a^3)(b^4-a^4)/(b^3-a^3)",
      "r": "positive cube root r=m3^(1/3)",
      "F_a(u)": "(u^4-a^4)/(u^3-a^3)",
      "G_b(d)": "(b^4-d^4)/(b^3-d^3)",
      "target_lower": "(m4-a^4)/(m3-a^3)",
      "target_upper": "(b^4-m4)/(b^3-m3)",
      "w_u": "(m3-a^3)/(u^3-a^3)",
      "w_b": "(m3-d^3)/(b^3-d^3)"
    },
