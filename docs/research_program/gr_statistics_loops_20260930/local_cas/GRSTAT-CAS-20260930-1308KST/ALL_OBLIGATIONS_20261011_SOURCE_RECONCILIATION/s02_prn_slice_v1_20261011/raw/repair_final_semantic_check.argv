python3 -c 'import json,pathlib,hashlib,zipfile; b=pathlib.Path("docs/research_program/gr_statistics_loops_20260930/local_cas/GRSTAT-CAS-20260930-1308KST/ALL_OBLIGATIONS_20261011_SOURCE_RECONCILIATION/s02_prn_slice_v1_20261011"); d=json.loads((b/"MAPPING.json").read_text()); e={x["original_id"]:x for x in d["entries"]}; assert len(e)==19 and len(d["candidate_followons"])==19; assert all(set(x["covered_gates"]).isdisjoint(x["missing_gates"]) and set(x["covered_gates"]+x["missing_gates"])==set(x["required_gates"]) for x in e.values()); assert e["PR-N11"]["covered_gates"]==[] and e["PR-N11"]["disposition"]=="UNCOVERED_PRODUCER" and "sky_selection" in e["PR-N11"]["missing_gates"]; assert "full_cross_probe_covariance" in e["PR-N20"]["missing_gates"]; assert "held_out_validation" in e["PR-N21"]["covered_gates"]; assert "full_covariance" in e["PR-N22"]["missing_gates"] and "full_covariance" in e["PR-N31"]["missing_gates"] and "full_covariance" in e["PR-N32"]["missing_gates"]; assert e["PR-N31"]["disposition"]=="UNCOVERED_PRODUCER" and e["PR-N32"]["disposition"]=="UNCOVERED_PRODUCER"; assert "scalar_non_identification" in e["PR-N40"]["missing_gates"]; assert len(e["PR-N51"]["required_gates"])==13 and e["PR-N51"]["source_status"]=="blocked_until_native_solver" and "native-domain equivalence producer is absent" in e["PR-N51"]["source_supported_reason"]; assert d["counts"]=={"source_entries":19,"PARTIAL_METADATA":1,"PARTIAL_SUBSTANTIVE":7,"UNCOVERED_PRODUCER":10,"EXTERNAL_BLOCKED_PRODUCER":1}; z=zipfile.ZipFile("HTT_ALL_OBLIGATIONS_20261011_PACKAGE.zip"); print("FINAL_REPAIR_SCOPE_PASS"); print("coverage_sha256="+hashlib.sha256(z.read("HTT_ALL_OBLIGATIONS_20261011/UPPER_BACKLOG_COVERAGE.json")).hexdigest()); print("destination_sha256="+json.dumps({k:hashlib.sha256(z.read("HTT_ALL_OBLIGATIONS_20261011/tasks/"+k+".json")).hexdigest() for k in ["U-151","U-155","U-156","U-159","U-166"]},sort_keys=True))'
