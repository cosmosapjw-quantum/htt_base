V : Type u_1
inst✝¹ : NormedAddCommGroup V
inst✝ : InnerProductSpace ℝ V
N : ℕ
w : Fin N → ℝ
n vel δ : Fin N → V
ε : Fin N → ℝ
v0 : V
Ainv : V →L[ℝ] V
hA : Ainv ∘SL ∑ i, cf4G w n i = ContinuousLinearMap.id ℝ V
hv : ∀ (i : Fin N), vel i = v0 + δ i
h1 : ∀ (i : Fin N), (w i * (⟪n i, vel i⟫_ℝ + ε i)) • n i = (cf4G w n i) v0 + (cf4G w n i) (δ i) + (w i * ε i) • n i
h2 : Ainv (∑ i, (cf4G w n i) v0) = v0
⊢ ∑ x, Ainv ((cf4G w n x) v0) + ∑ x, Ainv ((cf4G w n x) (δ x)) + ∑ x, Ainv ((w x * ε x) • n x) =
    v0 + ∑ i, (Ainv ∘SL cf4G w n i) (δ i) + ∑ x, Ainv ((w x * ε x) • n x)
