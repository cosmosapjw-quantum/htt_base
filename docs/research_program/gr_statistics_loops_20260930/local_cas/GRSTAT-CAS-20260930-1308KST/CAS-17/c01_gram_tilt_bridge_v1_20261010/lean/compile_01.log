CAS17C01.c01_gram_tilt_bridge (a b c u : Vec) (hG : (gram a b c).PosDef) (hu : FutureUnit u) :
  lorentz (wedge a b c) a = 0 ∧
    lorentz (wedge a b c) b = 0 ∧
      lorentz (wedge a b c) c = 0 ∧
        lorentz (wedge a b c) (wedge a b c) = -(gram a b c).det ∧
          FutureUnit (normal a b c) ∧
            1 ≤ gamma u (normal a b c) ∧
              lorentz (relativeSpatial u (normal a b c)) (normal a b c) = 0 ∧
                betaSq u (normal a b c) = 1 - (gamma u (normal a b c))⁻¹ ^ 2 ∧
                  0 ≤ betaSq u (normal a b c) ∧ betaSq u (normal a b c) < 1
'CAS17C01.wedge_orthogonal' depends on axioms: [propext, Classical.choice, Quot.sound]
'CAS17C01.wedge_norm' depends on axioms: [propext, sorryAx, Classical.choice, Quot.sound]
