CAS17C04.finite_coordinate_contraction_invariant {n p q : ℕ} (L : (Fin n → ℝ) ≃ₗ[ℝ] Fin n → ℝ)
  (T : CAS17C04.Tensor (Fin n → ℝ) p q) (a : (i : Fin p ⊕ Fin q) → CAS17C04.Slot (Fin n → ℝ) i) :
  (CAS17C04.tensorChange L T) (CAS17C04.argumentChange L a) = T a
CAS17C04.complete_internal_contraction_invariant {n r : ℕ} (L : (Fin n → ℝ) ≃ₗ[ℝ] Fin n → ℝ)
  (T : CAS17C04.Tensor (Fin n → ℝ) r r) (e : Module.Basis (Fin n) ℝ (Fin n → ℝ)) (σ : Fin r ≃ Fin r) :
  ∑ f, (CAS17C04.tensorChange L T) (CAS17C04.argumentChange L (CAS17C04.pairedBasisSlots e σ f)) =
    ∑ f, T (CAS17C04.pairedBasisSlots e σ f)
CAS17C04.endomorphism_trace_contraction_invariant {n : ℕ} (L : (Fin n → ℝ) ≃ₗ[ℝ] Fin n → ℝ)
  (T : (Fin n → ℝ) →ₗ[ℝ] Fin n → ℝ) : (LinearMap.trace ℝ (Fin n → ℝ)) (L.conj T) = (LinearMap.trace ℝ (Fin n → ℝ)) T
CAS17C04.physical_observer_replacement_counterexample :
  CAS17C04.minkowski CAS17C04.observer CAS17C04.observer = -1 ∧
    CAS17C04.minkowski CAS17C04.replacedObserver CAS17C04.replacedObserver = -1 ∧
      CAS17C04.observer 0 > 0 ∧
        CAS17C04.replacedObserver 0 > 0 ∧
          CAS17C04.minkowski CAS17C04.sourcewardNull CAS17C04.sourcewardNull = 0 ∧
            CAS17C04.minkowski CAS17C04.observer CAS17C04.sourcewardNull = 1 ∧
              CAS17C04.minkowski CAS17C04.replacedObserver CAS17C04.sourcewardNull = 3 ∧
                CAS17C04.minkowski CAS17C04.observer CAS17C04.sourcewardNull ≠
                  CAS17C04.minkowski CAS17C04.replacedObserver CAS17C04.sourcewardNull
