def G17D.g17dOperationalWitness : G17D.OperationalWitness :=
{ abT6Calibration := G17D.SupplyStatus.notSupplied }
structure G17D.IndependentOrbitInput : Type
number of parameters: 0
fields:
  G17D.IndependentOrbitInput.X1 : CAS17C01.Vec
  G17D.IndependentOrbitInput.X2 : CAS17C01.Vec
  G17D.IndependentOrbitInput.X3 : CAS17C01.Vec
  G17D.IndependentOrbitInput.gram_posDef : (CAS17C01.gram self.X1 self.X2 self.X3).PosDef
  G17D.IndependentOrbitInput.u : CAS17C01.Vec
  G17D.IndependentOrbitInput.u_future : CAS17C01.FutureUnit self.u
constructor:
  G17D.IndependentOrbitInput.mk (X1 X2 X3 : CAS17C01.Vec) (gram_posDef : (CAS17C01.gram X1 X2 X3).PosDef)
    (u : CAS17C01.Vec) (u_future : CAS17C01.FutureUnit u) : G17D.IndependentOrbitInput
def G17D.passiveChange : {V : Type} →
  [inst : AddCommGroup V] → [inst_1 : Module ℝ V] → (V ≃ₗ[ℝ] V) → G17D.TiltConfig V → G17D.TiltConfig V :=
fun {V} [AddCommGroup V] [Module ℝ V] L c => { g := c.g.compl₁₂ ↑L.symm ↑L.symm, u := L c.u, N := L c.N }
def G17D.observerReplacement : {V : Type} →
  [inst : AddCommGroup V] → [inst_1 : Module ℝ V] → V → G17D.TiltConfig V → G17D.TiltConfig V :=
fun {V} [AddCommGroup V] [Module ℝ V] u' c => { g := c.g, u := u', N := c.N }
