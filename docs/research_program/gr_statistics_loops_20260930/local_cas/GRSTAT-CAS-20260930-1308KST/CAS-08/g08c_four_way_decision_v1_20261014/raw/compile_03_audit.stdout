@size_control_of_coverage : ∀ {Θ : Type u_1} {X : Type u_2} {Y : Type u_3} [inst : MeasurableSpace Y]
  (μ : MeasureTheory.Measure Y) (α : ENNReal) (Ω : Set Θ) (Q : Y → Θ → ℝ) (q : ℝ) (xmap : Θ → X) (G : Set X) {θs : Θ},
  xmap θs ∈ G →
    ∀ (cC : (y : Y) → Cert (confSet Ω (Q y) q)) (cG : (y : Y) → Cert (nullConfSet Ω (Q y) q xmap G)),
      μ {y | θs ∉ confSet Ω (Q y) q} ≤ α →
        μ
            {y |
              fourWayReport (cC y) (cG y) = Report.geodesicityRejected ∨
                fourWayReport (cC y) (cG y) = Report.modelIncompatible} ≤
          α
