@certified_null_errors_subset : ∀ {Θ : Type u_1} {X : Type u_2} {Y : Type u_3} (Ω : Set Θ) (Q : Y → Θ → ℝ) (q : ℝ)
  (xmap : Θ → X) (G : Set X) {θs : Θ},
  xmap θs ∈ G →
