@G08D.gaussian_robust_union_coverage : ∀ {n k : ℕ} {Θ : Type u_1} (Ω : Set Θ) (m : Θ → EuclideanSpace ℝ (Fin n)),
  ∀ θs ∈ Ω,
    ∀ (C : Matrix (Fin n) (Fin n) ℝ) (F : Matrix (Fin n) (Fin k) ℝ),
      C.PosDef →
        ∀ {ι : Type} (S : Set ι),
          ∀ cs ∈ S,
            ∀ (Wc : ι → Matrix (Fin n) (Fin n) ℝ) (Xc : ι → Matrix (Fin k) (Fin n) ℝ),
              IsUnit (Wc cs) ∧ Wc cs * C * (Wc cs)ᵀ = 1 →
                G08AWhitening.IsMoorePenrose (Wc cs * F) (Xc cs) →
                  ∀ (β : Fin k → ℝ) {α : ℝ},
                    0 < α →
                      α < 1 →
                        0 < n - F.rank →
                          ENNReal.ofReal (1 - α) ≤
                            (multivariateGaussian (m θs + toLp 2 (F *ᵥ β)) C)
                              {y |
                                θs ∈
                                  ⋃ c ∈ S,
                                    confSet Ω (fun θ => G08BGaussianLaw.Qstat (Wc c) F (Xc c) (m θ) y)
                                      (G08BGaussianLaw.threshold (n - F.rank) α)}
'G08D.gaussian_robust_union_coverage' depends on axioms: [propext, Classical.choice, Quot.sound]
@G08D.gaussian_robust_union_delta : ∀ {n k : ℕ} {Θ : Type u_1} (Ω : Set Θ) (m : Θ → EuclideanSpace ℝ (Fin n)),
  ∀ θs ∈ Ω,
    ∀ (C : Matrix (Fin n) (Fin n) ℝ) (F : Matrix (Fin n) (Fin k) ℝ),
      C.PosDef →
        ∀ {ι : Type} (Sy : EuclideanSpace ℝ (Fin n) → Set ι) (cs : ι) (Wc : ι → Matrix (Fin n) (Fin n) ℝ)
          (Xc : ι → Matrix (Fin k) (Fin n) ℝ),
          IsUnit (Wc cs) ∧ Wc cs * C * (Wc cs)ᵀ = 1 →
            G08AWhitening.IsMoorePenrose (Wc cs * F) (Xc cs) →
              ∀ (β : Fin k → ℝ) {α : ℝ},
                0 < α →
                  α < 1 →
                    0 < n - F.rank →
                      ∀ (δ : ENNReal),
                        (multivariateGaussian (m θs + toLp 2 (F *ᵥ β)) C) {y | cs ∉ Sy y} ≤ δ →
                          (multivariateGaussian (m θs + toLp 2 (F *ᵥ β)) C)
                              {y |
                                θs ∉
                                  ⋃ c ∈ Sy y,
                                    confSet Ω (fun θ => G08BGaussianLaw.Qstat (Wc c) F (Xc c) (m θ) y)
                                      (G08BGaussianLaw.threshold (n - F.rank) α)} ≤
                            δ + ENNReal.ofReal α
