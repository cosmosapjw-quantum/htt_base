  (R : Θ → Set Y) (p : ENNReal), (∀ (θ : Θ), p ≤ (μ θ) (R θ)) → ∀ (θs : Θ), p ≤ (μ θs) {y | θs ∈ {θ | y ∈ R θ}}
'G08D.general_inversion_coverage' depends on axioms: [propext, Classical.choice, Quot.sound]
@G08D.general_inversion_projection : ∀ {Θ : Type u_1} {Y : Type u_2} [inst : MeasurableSpace Y] (μ : Θ → Measure Y)
  (R : Θ → Set Y) (p : ENNReal),
  (∀ (θ : Θ), p ≤ (μ θ) (R θ)) →
    ∀ (θs : Θ) {ι : Type} {β : ι → Type} (f : (i : ι) → Θ → β i),
      p ≤ (μ θs) {y | ∀ (i : ι), f i θs ∈ f i '' {θ | y ∈ R θ}}
'G08D.general_inversion_projection' depends on axioms: [propext, Classical.choice, Quot.sound]
@G08D.gaussian_reports_measurable : ∀ {n k : ℕ} {Θ : Type u_1} {P : Type u_2} [inst : TopologicalSpace Θ]
  [SecondCountableTopology Θ] [T2Space Θ] [inst_3 : TopologicalSpace P] (W : Matrix (Fin n) (Fin n) ℝ)
  (F : Matrix (Fin n) (Fin k) ℝ) (X : Matrix (Fin k) (Fin n) ℝ) (m : Θ → EuclideanSpace ℝ (Fin n)) {Ω : Set Θ}
  (Kn : ℕ → Set Θ),
  (∀ (i : ℕ), IsCompact (Kn i)) →
    Ω = ⋃ i, Kn i →
      ContinuousOn m Ω →
        ∀ {xmap : Θ → P},
          ContinuousOn xmap Ω →
            ∀ {G : Set P},
              IsClosed G →
                ∀ (q : ℝ),
                  MeasurableSet
                      {y |
                        RejectsGeodesicity (confSet Ω (fun θ => G08BGaussianLaw.Qstat W F X (m θ) y) q)
                          (nullConfSet Ω (fun θ => G08BGaussianLaw.Qstat W F X (m θ) y) q xmap G)} ∧
                    MeasurableSet
                        {y |
                          NotExcluded (confSet Ω (fun θ => G08BGaussianLaw.Qstat W F X (m θ) y) q)
                            (nullConfSet Ω (fun θ => G08BGaussianLaw.Qstat W F X (m θ) y) q xmap G)} ∧
                      MeasurableSet {y | ModelIncompatible (confSet Ω (fun θ => G08BGaussianLaw.Qstat W F X (m θ) y) q)}
'G08D.gaussian_reports_measurable' depends on axioms: [propext, Classical.choice, Quot.sound]
@G08D.gaussian_noncoverage_eq : ∀ {n k : ℕ} {Θ : Type u_1} (Ω : Set Θ) (m : Θ → EuclideanSpace ℝ (Fin n)),
  ∀ θs ∈ Ω,
    ∀ (C W : Matrix (Fin n) (Fin n) ℝ) (F : Matrix (Fin n) (Fin k) ℝ) (X : Matrix (Fin k) (Fin n) ℝ),
      C.PosDef →
        IsUnit W ∧ W * C * Wᵀ = 1 →
          G08AWhitening.IsMoorePenrose (W * F) X →
            ∀ (β : Fin k → ℝ) {α : ℝ},
              0 < α →
                α < 1 →
                  0 < n - F.rank →
                    (multivariateGaussian (m θs + toLp 2 (F *ᵥ β)) C)
                        {y |
                          θs ∉
                            confSet Ω (fun θ => G08BGaussianLaw.Qstat W F X (m θ) y)
                              (G08BGaussianLaw.threshold (n - F.rank) α)} =
                      ENNReal.ofReal α
'G08D.gaussian_noncoverage_eq' depends on axioms: [propext, Classical.choice, Quot.sound]
@G08D.gaussian_size_control : ∀ {n k : ℕ} {Θ : Type u_1} {P : Type u_2} (Ω : Set Θ) (m : Θ → EuclideanSpace ℝ (Fin n)),
  ∀ θs ∈ Ω,
    ∀ (C W : Matrix (Fin n) (Fin n) ℝ) (F : Matrix (Fin n) (Fin k) ℝ) (X : Matrix (Fin k) (Fin n) ℝ),
      C.PosDef →
        IsUnit W ∧ W * C * Wᵀ = 1 →
          G08AWhitening.IsMoorePenrose (W * F) X →
            ∀ (β : Fin k → ℝ) {α : ℝ},
              0 < α →
                α < 1 →
                  0 < n - F.rank →
                    ∀ (xmap : Θ → P) (G : Set P),
                      xmap θs ∈ G →
                        ∀
                          (cC :
                            (y : EuclideanSpace ℝ (Fin n)) →
                              Cert
                                (confSet Ω (fun θ => G08BGaussianLaw.Qstat W F X (m θ) y)
                                  (G08BGaussianLaw.threshold (n - F.rank) α)))
                          (cG :
                            (y : EuclideanSpace ℝ (Fin n)) →
                              Cert
                                (nullConfSet Ω (fun θ => G08BGaussianLaw.Qstat W F X (m θ) y)
                                  (G08BGaussianLaw.threshold (n - F.rank) α) xmap G)),
                          (multivariateGaussian (m θs + toLp 2 (F *ᵥ β)) C)
                              {y |
                                fourWayReport (cC y) (cG y) = Report.geodesicityRejected ∨
                                  fourWayReport (cC y) (cG y) = Report.modelIncompatible} ≤
                            ENNReal.ofReal α
'G08D.gaussian_size_control' depends on axioms: [propext, Classical.choice, Quot.sound]
@G08D.gaussian_semantic_size : ∀ {n k : ℕ} {Θ : Type u_1} {P : Type u_2} (Ω : Set Θ) (m : Θ → EuclideanSpace ℝ (Fin n)),
  ∀ θs ∈ Ω,
    ∀ (C W : Matrix (Fin n) (Fin n) ℝ) (F : Matrix (Fin n) (Fin k) ℝ) (X : Matrix (Fin k) (Fin n) ℝ),
      C.PosDef →
        IsUnit W ∧ W * C * Wᵀ = 1 →
          G08AWhitening.IsMoorePenrose (W * F) X →
            ∀ (β : Fin k → ℝ) {α : ℝ},
              0 < α →
                α < 1 →
                  0 < n - F.rank →
