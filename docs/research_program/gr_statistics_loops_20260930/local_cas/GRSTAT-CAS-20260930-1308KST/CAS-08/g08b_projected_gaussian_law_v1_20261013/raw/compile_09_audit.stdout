@G08BGaussianLaw.coverage : ∀ {n k : ℕ} {Θ : Type u_1} (Ωd : Set Θ) (m : Θ → EuclideanSpace ℝ (Fin n)),
  ∀ θs ∈ Ωd,
    ∀ (C W : Matrix (Fin n) (Fin n) ℝ) (F : Matrix (Fin n) (Fin k) ℝ) (X : Matrix (Fin k) (Fin n) ℝ),
      C.PosDef →
        IsUnit W ∧ W * C * W.transpose = 1 →
          G08AWhitening.IsMoorePenrose (W * F) X →
            ∀ (β : Fin k → ℝ) {α : ℝ},
              0 < α →
                α < 1 →
                  0 < n - F.rank →
                    (ProbabilityTheory.multivariateGaussian (m θs + WithLp.toLp 2 (F.mulVec β)) C)
                        {y | θs ∈ G08BGaussianLaw.confSet Ωd m W F X (G08BGaussianLaw.threshold (n - F.rank) α) y} =
                      ENNReal.ofReal (1 - α)
