  ∀ θs ∈ Ωd,
    ∀ {Ω : Type u_2} [inst : MeasurableSpace Ω] (ℙ : MeasureTheory.Measure Ω) (C W : Matrix (Fin n) (Fin n) ℝ)
      (F : Matrix (Fin n) (Fin k) ℝ) (X : Matrix (Fin k) (Fin n) ℝ),
      C.PosDef →
        IsUnit W ∧ W * C * W.transpose = 1 →
          G08AWhitening.IsMoorePenrose (W * F) X →
            ∀ (β : Fin k → ℝ) (ε : Ω → EuclideanSpace ℝ (Fin n)),
              Measurable ε →
                MeasureTheory.Measure.map ε ℙ = ProbabilityTheory.multivariateGaussian 0 C →
                  ∀ {α : ℝ},
