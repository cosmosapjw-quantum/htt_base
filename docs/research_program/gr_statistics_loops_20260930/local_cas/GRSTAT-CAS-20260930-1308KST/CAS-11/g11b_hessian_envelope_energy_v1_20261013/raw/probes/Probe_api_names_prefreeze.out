@intervalIntegral.integral_eq_sub_of_hasDerivAt : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : NormedSpace ℝ E] {a b : ℝ} [CompleteSpace E] {f f' : ℝ → E},
  (∀ x ∈ uIcc a b, HasDerivAt f (f' x) x) → IntervalIntegrable f' volume a b → ∫ (y : ℝ) in a..b, f' y = f b - f a
@intervalIntegral.integral_mono_on : ∀ {f g : ℝ → ℝ} {a b : ℝ} {μ : Measure ℝ},
  a ≤ b →
    IntervalIntegrable f μ a b →
      IntervalIntegrable g μ a b → (∀ x ∈ Icc a b, f x ≤ g x) → ∫ (u : ℝ) in a..b, f u ∂μ ≤ ∫ (u : ℝ) in a..b, g u ∂μ
@ContinuousOn.intervalIntegrable : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] {μ : Measure ℝ}
  [IsLocallyFiniteMeasure μ] {u : ℝ → E} {a b : ℝ}, ContinuousOn u (uIcc a b) → IntervalIntegrable u μ a b
@lintegral_liminf_le : ∀ {α : Type u_1} {m : MeasurableSpace α} {μ : Measure α} {ι : Type u_2} {f : ι → α → ENNReal}
  {u : Filter ι} [u.IsCountablyGenerated],
  (∀ (i : ι), Measurable (f i)) → ∫⁻ (a : α), liminf (fun i => f i a) u ∂μ ≤ liminf (fun i => ∫⁻ (a : α), f i a ∂μ) u
@lintegral_liminf_le' : ∀ {α : Type u_1} {m : MeasurableSpace α} {μ : Measure α} {ι : Type u_2} {f : ι → α → ENNReal}
  {u : Filter ι} [u.IsCountablyGenerated],
  (∀ (i : ι), AEMeasurable (f i) μ) →
    ∫⁻ (a : α), liminf (fun i => f i a) u ∂μ ≤ liminf (fun i => ∫⁻ (a : α), f i a ∂μ) u
@lintegral_const_mul' : ∀ {α : Type u_1} {m : MeasurableSpace α} {μ : Measure α} (r : ENNReal) (f : α → ENNReal),
  r ≠ ⊤ → ∫⁻ (a : α), r * f a ∂μ = r * ∫⁻ (a : α), f a ∂μ
@Ioo_mem_nhdsLT : ∀ {α : Type u_1} [inst : TopologicalSpace α] [inst_1 : LinearOrder α] [ClosedIicTopology α] {a b : α},
  a < b → Ioo a b ∈ 𝓝[<] b
@Tendsto.liminf_eq : ∀ {α : Type u_1} {β : Type u_2} [inst : ConditionallyCompleteLinearOrder α]
  [inst_1 : TopologicalSpace α] [OrderTopology α] {f : Filter β} {u : β → α} {a : α} [f.NeBot],
  Tendsto u f (𝓝 a) → liminf u f = a
@liminf_le_of_le : ∀ {α : Type u_1} {β : Type u_2} [inst : ConditionallyCompleteLattice α] {f : Filter β} {u : β → α}
  {a : α},
  autoParam (IsBoundedUnder (fun x1 x2 => x1 ≥ x2) f u) liminf_le_of_le._auto_1 →
    (∀ (b : α), (∀ᶠ (n : β) in f, b ≤ u n) → b ≤ a) → liminf u f ≤ a
@liminf_le_of_frequently_le' : ∀ {α : Type u_1} {β : Type u_2} [inst : CompleteLattice β] {f : Filter α} {u : α → β}
  {x : β}, (∃ᶠ (a : α) in f, u a ≤ x) → liminf u f ≤ x
@integral_mono_ae : ∀ {α : Type u_1} {E : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E]
  {m : MeasurableSpace α} {μ : Measure α} [inst_2 : PartialOrder E] [IsOrderedAddMonoid E] [IsOrderedModule ℝ E]
  [ClosedIciTopology E] {f g : α → E},
  Integrable f μ → Integrable g μ → f ≤ᵐ[μ] g → ∫ (x : α), f x ∂μ ≤ ∫ (x : α), g x ∂μ
@integral_const_mul : ∀ {α : Type u_1} {m : MeasurableSpace α} {μ : Measure α} {L : Type u_2} [inst : RCLike L] (r : L)
  (f : α → L), ∫ (a : α), r * f a ∂μ = r * ∫ (a : α), f a ∂μ
@le_of_tendsto_of_tendsto : ∀ {α : Type u_1} {β : Type u_2} [inst : TopologicalSpace α] [inst_1 : Preorder α]
  [t : OrderClosedTopology α] {f g : β → α} {b : Filter β} {a₁ a₂ : α} [b.NeBot],
  Tendsto f b (𝓝 a₁) → Tendsto g b (𝓝 a₂) → f ≤ᶠ[b] g → a₁ ≤ a₂
@G11A.WEnvelope_bounds_hessian : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : Measure X) (s : G11A.Stat)
  (W f g : X → ℝ),
  G11A.WEnvelope μ s W f g → ∀ᵐ (x : X) ∂μ, ∀ z ∈ uIcc (f x) (g x), z ∈ G11A.dom s → 1 / W x ≤ G11A.hess s z
