@G11C.duplicated_kernels : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : MeasureTheory.Measure X) (s : G11A.Stat)
  (f g W : X → ℝ),
  Measurable f →
    Measurable g →
      (∀ᵐ (x : X) ∂μ, f x ∈ G11A.cdom s) →
        (∀ᵐ (x : X) ∂μ, g x ∈ G11A.dom s) →
          G11A.WEnvelope μ s W f g →
            ∀ {ε : ℝ},
              0 ≤ ε →
                G11A.Dext μ (G11A.hS s) (G11A.hS' s) f g ≤ ENNReal.ofReal ε →
                  ∀ {m n : ℕ} (φ : Fin m → X → ℝ) (hφ : ∀ (a : Fin m), MeasureTheory.MemLp (φ a) 2 (G11C.wmeas μ W)),
                    (∀ (a : Fin m), ∫ (x : X), φ a x * (f x - g x) ∂μ = 0) →
                      ∀ (K : Fin n → X → ℝ) (hK : ∀ (j : Fin n), MeasureTheory.MemLp (K j) 2 (G11C.wmeas μ W))
                        {i j : Fin n},
                        i ≠ j →
                          K i = K j →
                            (G11C.gramR μ W φ hφ K hK).det = 0 ∧
                              (G11C.gramR μ W φ hφ K hK).mulVec (Pi.single i 1 - Pi.single j 1) = 0 ∧
                                G11C.evec μ K f g i = G11C.evec μ K f g j ∧
                                  G11C.evec μ K f g ∈ (Matrix.toLin' (G11C.gramR μ W φ hφ K hK)).range ∧
                                    G11C.evec μ K f g ⬝ᵥ
                                        (CAS11C02.spectralPinvMatrix (G11C.gramR μ W φ hφ K hK) ⋯).mulVec
                                          (G11C.evec μ K f g) ≤
                                      2 * ε
'G11C.duplicated_kernels' depends on axioms: [propext, Classical.choice, Quot.sound]
@G11C.mismatch_bound : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : MeasureTheory.Measure X) (s : G11A.Stat)
  (f g W : X → ℝ),
  Measurable f →
    Measurable g →
      (∀ᵐ (x : X) ∂μ, f x ∈ G11A.cdom s) →
        (∀ᵐ (x : X) ∂μ, g x ∈ G11A.dom s) →
          G11A.WEnvelope μ s W f g →
            ∀ {ε : ℝ},
              0 ≤ ε →
                G11A.Dext μ (G11A.hS s) (G11A.hS' s) f g ≤ ENNReal.ofReal ε →
                  ∀ {m : ℕ} (φ : Fin m → X → ℝ) (hφ : ∀ (a : Fin m), MeasureTheory.MemLp (φ a) 2 (G11C.wmeas μ W))
                    {k : X → ℝ} (hk : MeasureTheory.MemLp k 2 (G11C.wmeas μ W)) (c : Fin m → ℝ),
                    |∫ (x : X), k x * (f x - g x) ∂μ| ≤
                      √(2 * ε) * ‖MeasureTheory.MemLp.toLp k hk - ∑ a, c a • MeasureTheory.MemLp.toLp (φ a) ⋯‖ +
                        |∑ a, c a * ∫ (x : X), φ a x * (f x - g x) ∂μ|
'G11C.mismatch_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
G11C.weighted_residual_ellipsoid_nu : ∀ (s : G11A.Stat) (C : ℝ) (f g W : ℝ × ↑G11A.Sphere2 → ℝ),
  Measurable f →
    Measurable g →
      (∀ᵐ (y : ℝ × ↑G11A.Sphere2) ∂G11A.nu C, f y ∈ G11A.cdom s) →
        (∀ᵐ (y : ℝ × ↑G11A.Sphere2) ∂G11A.nu C, g y ∈ G11A.dom s) →
          G11A.WEnvelope (G11A.nu C) s W f g →
            ∀ {ε : ℝ},
              0 ≤ ε →
                G11A.Dext (G11A.nu C) (G11A.hS s) (G11A.hS' s) f g ≤ ENNReal.ofReal ε →
                  ∀ {m n : ℕ} (φ : Fin m → ℝ × ↑G11A.Sphere2 → ℝ)
                    (hφ : ∀ (a : Fin m), MeasureTheory.MemLp (φ a) 2 (G11C.wmeas (G11A.nu C) W)),
                    (∀ (a : Fin m), ∫ (y : ℝ × ↑G11A.Sphere2), φ a y * (f y - g y) ∂G11A.nu C = 0) →
                      ∀ (K : Fin n → ℝ × ↑G11A.Sphere2 → ℝ)
                        (hK : ∀ (j : Fin n), MeasureTheory.MemLp (K j) 2 (G11C.wmeas (G11A.nu C) W)),
                        (G11C.gramR (G11A.nu C) W φ hφ K hK).PosSemidef ∧
                          G11C.evec (G11A.nu C) K f g ∈ (Matrix.toLin' (G11C.gramR (G11A.nu C) W φ hφ K hK)).range ∧
                            G11C.evec (G11A.nu C) K f g ⬝ᵥ
                                (CAS11C02.spectralPinvMatrix (G11C.gramR (G11A.nu C) W φ hφ K hK) ⋯).mulVec
                                  (G11C.evec (G11A.nu C) K f g) ≤
                              2 * ε
'G11C.weighted_residual_ellipsoid_nu' depends on axioms: [propext, Classical.choice, Quot.sound]
G11C.dirac_wmeas_finite : ∀ (c : ℝ),
  MeasureTheory.IsFiniteMeasure (G11C.wmeas (MeasureTheory.Measure.dirac ()) fun x => c)
'G11C.dirac_wmeas_finite' depends on axioms: [propext, Classical.choice, Quot.sound]
G11C.memLp_const_dirac : ∀ (c w : ℝ),
  MeasureTheory.MemLp (fun x => c) 2 (G11C.wmeas (MeasureTheory.Measure.dirac ()) fun x => w)
'G11C.memLp_const_dirac' depends on axioms: [propext, Classical.choice, Quot.sound]
G11C.witness_budget : (Measurable fun x => 2) ∧
  (Measurable fun x => 1) ∧
    (∀ᵐ (x : Unit) ∂MeasureTheory.Measure.dirac (), (fun x => 2) x ∈ G11A.cdom G11A.Stat.MB) ∧
      (∀ᵐ (x : Unit) ∂MeasureTheory.Measure.dirac (), (fun x => 1) x ∈ G11A.dom G11A.Stat.MB) ∧
        (G11A.WEnvelope (MeasureTheory.Measure.dirac ()) G11A.Stat.MB (fun x => 2) (fun x => 2) fun x => 1) ∧
          (G11A.Dext (MeasureTheory.Measure.dirac ()) (G11A.hS G11A.Stat.MB) (G11A.hS' G11A.Stat.MB) (fun x => 2)
              fun x => 1) ≤
            ENNReal.ofReal 1
'G11C.witness_budget' depends on axioms: [propext, Classical.choice, Quot.sound]
G11C.negative_control_mismatch : ∃ f g W φ,
  ∃ (hφ : ∀ (a : Fin 1), MeasureTheory.MemLp (φ a) 2 (G11C.wmeas (MeasureTheory.Measure.dirac ()) W)),
    ∃ K,
      ∃ (hK : ∀ (j : Fin 1), MeasureTheory.MemLp (K j) 2 (G11C.wmeas (MeasureTheory.Measure.dirac ()) W)),
        Measurable f ∧
          Measurable g ∧
            (∀ᵐ (x : Unit) ∂MeasureTheory.Measure.dirac (), f x ∈ G11A.cdom G11A.Stat.MB) ∧
              (∀ᵐ (x : Unit) ∂MeasureTheory.Measure.dirac (), g x ∈ G11A.dom G11A.Stat.MB) ∧
                G11A.WEnvelope (MeasureTheory.Measure.dirac ()) G11A.Stat.MB W f g ∧
                  G11A.Dext (MeasureTheory.Measure.dirac ()) (G11A.hS G11A.Stat.MB) (G11A.hS' G11A.Stat.MB) f g ≤
                      ENNReal.ofReal 1 ∧
                    ∫ (x : Unit), φ 0 x * (f x - g x) ∂MeasureTheory.Measure.dirac () ≠ 0 ∧
                      G11C.gramR (MeasureTheory.Measure.dirac ()) W φ hφ K hK = 0 ∧
                        G11C.evec (MeasureTheory.Measure.dirac ()) K f g ∉
                          (Matrix.toLin' (G11C.gramR (MeasureTheory.Measure.dirac ()) W φ hφ K hK)).range
'G11C.negative_control_mismatch' depends on axioms: [propext, Classical.choice, Quot.sound]
G11C.nonvacuity_singular_witness : ∃ f g W φ,
  ∃ (hφ : ∀ (a : Fin 0), MeasureTheory.MemLp (φ a) 2 (G11C.wmeas (MeasureTheory.Measure.dirac ()) W)),
    ∃ K,
      ∃ (hK : ∀ (j : Fin 2), MeasureTheory.MemLp (K j) 2 (G11C.wmeas (MeasureTheory.Measure.dirac ()) W)),
        Measurable f ∧
          Measurable g ∧
            (∀ᵐ (x : Unit) ∂MeasureTheory.Measure.dirac (), f x ∈ G11A.cdom G11A.Stat.MB) ∧
              (∀ᵐ (x : Unit) ∂MeasureTheory.Measure.dirac (), g x ∈ G11A.dom G11A.Stat.MB) ∧
                G11A.WEnvelope (MeasureTheory.Measure.dirac ()) G11A.Stat.MB W f g ∧
                  G11A.Dext (MeasureTheory.Measure.dirac ()) (G11A.hS G11A.Stat.MB) (G11A.hS' G11A.Stat.MB) f g ≤
                      ENNReal.ofReal 1 ∧
                    (∀ (a : Fin 0), ∫ (x : Unit), φ a x * (f x - g x) ∂MeasureTheory.Measure.dirac () = 0) ∧
                      f ≠ g ∧
                        K 0 = K 1 ∧
                          G11C.gramR (MeasureTheory.Measure.dirac ()) W φ hφ K hK ≠ 0 ∧
                            (G11C.gramR (MeasureTheory.Measure.dirac ()) W φ hφ K hK).det = 0 ∧
                              G11C.evec (MeasureTheory.Measure.dirac ()) K f g ≠ 0
'G11C.nonvacuity_singular_witness' depends on axioms: [propext, Classical.choice, Quot.sound]
@G11C.repr_T : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  [inst_2 : FiniteDimensional ℝ E] {T : E →ₗ[ℝ] E} (hT : T.IsSymmetric) (v : E) (i : Fin (Module.finrank ℝ E)),
  ((hT.eigenvectorBasis ⋯).repr (T v)).ofLp i = hT.eigenvalues ⋯ i * ((hT.eigenvectorBasis ⋯).repr v).ofLp i
'G11C.repr_T' depends on axioms: [propext, Classical.choice, Quot.sound]
@G11C.repr_P : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  [inst_2 : FiniteDimensional ℝ E] {T : E →ₗ[ℝ] E} (hT : T.IsSymmetric) (v : E) (i : Fin (Module.finrank ℝ E)),
  ((hT.eigenvectorBasis ⋯).repr ((CAS11C02.spectralPinvLin hT) v)).ofLp i =
    (hT.eigenvalues ⋯ i)⁻¹ * ((hT.eigenvectorBasis ⋯).repr v).ofLp i
'G11C.repr_P' depends on axioms: [propext, Classical.choice, Quot.sound]
@G11C.diag_symm : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  [inst_2 : FiniteDimensional ℝ E] {T : E →ₗ[ℝ] E} (hT : T.IsSymmetric) (A : E →ₗ[ℝ] E)
  (d : Fin (Module.finrank ℝ E) → ℝ),
  (∀ (v : E) (i : Fin (Module.finrank ℝ E)),
      ((hT.eigenvectorBasis ⋯).repr (A v)).ofLp i = d i * ((hT.eigenvectorBasis ⋯).repr v).ofLp i) →
    A.IsSymmetric
'G11C.diag_symm' depends on axioms: [propext, Classical.choice, Quot.sound]
@G11C.abstract_penrose : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  [inst_2 : FiniteDimensional ℝ E] {T : E →ₗ[ℝ] E} (hT : T.IsSymmetric),
  (∀ (v : E), T ((CAS11C02.spectralPinvLin hT) (T v)) = T v) ∧
    (∀ (v : E), (CAS11C02.spectralPinvLin hT) (T ((CAS11C02.spectralPinvLin hT) v)) = (CAS11C02.spectralPinvLin hT) v) ∧
      (T ∘ₗ CAS11C02.spectralPinvLin hT).IsSymmetric ∧ (CAS11C02.spectralPinvLin hT ∘ₗ T).IsSymmetric
'G11C.abstract_penrose' depends on axioms: [propext, Classical.choice, Quot.sound]
@G11C.spectralPinv_penrose : ∀ {n : ℕ} (R : Matrix (Fin n) (Fin n) ℝ) (hR : R.IsHermitian),
  R * CAS11C02.spectralPinvMatrix R hR * R = R ∧
    CAS11C02.spectralPinvMatrix R hR * R * CAS11C02.spectralPinvMatrix R hR = CAS11C02.spectralPinvMatrix R hR ∧
      (R * CAS11C02.spectralPinvMatrix R hR).transpose = R * CAS11C02.spectralPinvMatrix R hR ∧
        (CAS11C02.spectralPinvMatrix R hR * R).transpose = CAS11C02.spectralPinvMatrix R hR * R
'G11C.spectralPinv_penrose' depends on axioms: [propext, Classical.choice, Quot.sound]
