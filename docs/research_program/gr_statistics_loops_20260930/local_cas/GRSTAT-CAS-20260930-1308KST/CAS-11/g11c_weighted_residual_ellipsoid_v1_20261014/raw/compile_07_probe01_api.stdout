@integrable_withDensity_iff : ∀ {α : Type u_1} {m : MeasurableSpace α} {μ : Measure α} {f : α → ENNReal},
  Measurable f →
    (∀ᵐ (x : α) ∂μ, f x < ⊤) →
      ∀ {g : α → ℝ}, Integrable g (μ.withDensity f) ↔ Integrable (fun x => g x * (f x).toReal) μ
@integral_withDensity_eq_integral_toReal_smul : ∀ {X : Type u_1} {E : Type u_2} [inst : MeasurableSpace X]
  {μ : Measure X} [inst_1 : NormedAddCommGroup E] [inst_2 : NormedSpace ℝ E] {f : X → ENNReal},
  Measurable f →
    (∀ᵐ (x : X) ∂μ, f x < ⊤) → ∀ (g : X → E), ∫ (x : X), g x ∂μ.withDensity f = ∫ (x : X), (f x).toReal • g x ∂μ
@L2.inner_def : ∀ {α : Type u_1} {E : Type u_2} {𝕜 : Type u_3} [inst : RCLike 𝕜] {m : MeasurableSpace α} {μ : Measure α}
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace 𝕜 E] (f g : ↥(Lp E 2 μ)),
  inner 𝕜 f g = ∫ (a : α), inner 𝕜 (↑↑f a) (↑↑g a) ∂μ
