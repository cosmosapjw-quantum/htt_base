@Metric.infDist : {α : Type u_1} → [PseudoMetricSpace α] → α → Set α → ℝ
@CAS11C02.finiteGramForward : ∀ {n : ℕ},
  0 < n →
    ∀ (R : Matrix (Fin n) (Fin n) ℝ) (hR : R.PosSemidef) (e : Fin n → ℝ) (ε : ℝ),
      0 ≤ ε →
        (∀ (a : Fin n → ℝ), (a ⬝ᵥ e) ^ 2 ≤ 2 * ε * a ⬝ᵥ R.mulVec a) →
          R.PosSemidef ∧ e ∈ (Matrix.toLin' R).range ∧ e ⬝ᵥ (CAS11C02.spectralPinvMatrix R ⋯).mulVec e ≤ 2 * ε
@CAS11C03.weighted_cauchy_schwarz : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  (x y : E), |inner ℝ x y| ^ 2 ≤ inner ℝ x x * inner ℝ y y
@G11B.B2_integral : ∀ {X : Type u_1} [inst : MeasurableSpace X] (μ : Measure X) (s : G11A.Stat) (f g W : X → ℝ),
  Measurable f →
    Measurable g →
      (∀ᵐ (x : X) ∂μ, f x ∈ G11A.cdom s) →
        (∀ᵐ (x : X) ∂μ, g x ∈ G11A.dom s) →
          G11A.WEnvelope μ s W f g →
            ∀ {ε : ℝ},
              0 ≤ ε →
                G11A.Dext μ (G11A.hS s) (G11A.hS' s) f g ≤ ENNReal.ofReal ε →
                  Integrable (fun x => (f x - g x) ^ 2 / W x) μ ∧
                    ∫ (x : X), (f x - g x) ^ 2 / W x ∂μ ≤ 2 * G11A.Dfin μ (G11A.hS s) (G11A.hS' s) f g ∧
                      ∫ (x : X), (f x - g x) ^ 2 / W x ∂μ ≤ 2 * ε
G11A.nu : ℝ → Measure (ℝ × ↑G11A.Sphere2)
@Matrix.star_dotProduct_gram_mulVec : ∀ {E : Type u_1} {n : Type u_2} {𝕜 : Type u_3} [inst : RCLike 𝕜]
  [inst_1 : SeminormedAddCommGroup E] [inst_2 : InnerProductSpace 𝕜 E] [inst_3 : Fintype n] (v : n → E) (x y : n → 𝕜),
  star x ⬝ᵥ (Matrix.gram 𝕜 v).mulVec y = inner 𝕜 (∑ i, x i • v i) (∑ i, y i • v i)
@Submodule.span_le : ∀ {R : Type u_1} {M : Type u_2} [inst : Semiring R] [inst_1 : AddCommMonoid M]
  [inst_2 : Module R M] {s : Set M} {p : Submodule R M}, Submodule.span R s ≤ p ↔ s ⊆ ↑p
@Submodule.starProjection_apply : ∀ {𝕜 : Type u_1} {E : Type u_2} [inst : RCLike 𝕜] [inst_1 : NormedAddCommGroup E]
  [inst_2 : InnerProductSpace 𝕜 E] (U : Submodule 𝕜 E) [inst_3 : U.HasOrthogonalProjection] (v : E),
  U.starProjection v = ↑(U.orthogonalProjectionOnto v)
