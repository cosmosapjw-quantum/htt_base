ring r=0,(p1,p2,p3),dp;
poly q=p1^2+p2^2+p3^2;
matrix G[3][3];
G[1,1]=q/2+(p1^2)/6;
G[1,2]=p1*p2/6;
G[1,3]=p1*p3/6;
G[2,1]=p2*p1/6;
G[2,2]=q/2+(p2^2)/6;
G[2,3]=p2*p3/6;
G[3,1]=p3*p1/6;
G[3,2]=p3*p2/6;
G[3,3]=q/2+(p3^2)/6;
poly delta=det(G)-(q^3)/6;
print(delta);
if (delta==0) { print("SINGULAR_TILT_GRAM_DET_PASS"); } else { print("SINGULAR_TILT_GRAM_DET_FAIL"); }
