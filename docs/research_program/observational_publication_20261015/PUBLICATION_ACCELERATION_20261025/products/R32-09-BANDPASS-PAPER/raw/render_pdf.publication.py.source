"""Generate paper assets from exact retained sufficient statistics; no upstream rerun."""
from __future__ import annotations
import argparse
import csv
import hashlib
import json
from pathlib import Path
import consumer


def load_inputs(root):
    bindings = json.loads((root / 'SOURCE_BINDINGS.json').read_text())
    inputs = {}
    for key, row in bindings.items():
        raw = (root / row['local_path']).read_bytes()
        if hashlib.sha256(raw).hexdigest() != row['sha256']:
            raise ValueError(f'source identity mismatch: {key}')
        if row['local_path'].endswith('.json'):
            inputs[key] = json.loads(raw)
    return inputs, bindings


def summarize(inputs):
    bounded = inputs['bounded_RESULT.json']
    r31 = inputs['R31_RESULT.json']
    rows = consumer.validate_selection(bounded, bounded['source_sha256'])
    # Exact original bytes are checked in load_inputs; the source-to-source
    # relationship is additionally checked against their retained original hash.
    for name in consumer.BRANCHES:
        branch = r31['branches'][name]
        for model, ranks in [('F1', (5, 6, 24)), ('F2', (7, 7, 0))]:
            item = branch[model]
            actual = (item['resolved_rank'], item['augmented_resolved_rank'],
                      item['full24_identified_target_rank'])
            if actual != ranks:
                raise ValueError(f'{name}/{model}: stored rank scope changed')
    comparison = []
    for branch, values in inputs['R33_check_RESULT.json']['branches'].items():
        for model in ('F12', 'F17'):
            item = values[model]
            if (item['nuisance_rank'], item['augmented_rank'],
                    item['full24_identified_target_rank']) != (9, 10, 24):
                raise ValueError('R33 finite extension rank scope changed')
            comparison.append({'branch': branch, 'row_model': model,
                'principal_angle_sine': float(item['principal_angle_sine']),
                'weight_norm': float(item['w_norm2'])})
    if len(comparison) != 24:
        raise ValueError('expected twelve paired R33 conventions and two row models')
    return {'budget_rows': rows,
            'common_min': min(r['common_reference']['minimum_budget_ell'] for r in rows),
            'common_max': max(r['common_reference']['minimum_budget_ell'] for r in rows),
            'raw_min': min(r['raw_identity']['minimum_budget_ell'] for r in rows),
            'raw_max': max(r['raw_identity']['minimum_budget_ell'] for r in rows),
            'nominal_F1_angle': r31['branches'][consumer.BRANCHES[0]]['F1']['principal_angle_sine'],
            'r33_min_angle': min(r['principal_angle_sine'] for r in comparison),
            'r33_max_weight': max(r['weight_norm'] for r in comparison),
            'r33_rows': comparison}


def tex_table(header, rows, alignment):
    return '\n'.join([r'\begin{tabular}{'+alignment+'}', r'\toprule',
        header + r' \\', r'\midrule'] + [' & '.join(map(str, r)) + r' \\' for r in rows]
        + [r'\bottomrule', r'\end{tabular}', ''])


def generate(root):
    inputs, bindings = load_inputs(root)
    bounded = inputs['bounded_RESULT.json']; r31 = inputs['R31_RESULT.json']
    if bounded['source_sha256'] != bindings['R31_RESULT.json']['sha256']:
        raise ValueError('bounded product does not reference the retained R31 bytes')
    summary = summarize(inputs)
    out = root / 'report/generated'; out.mkdir(exist_ok=True)
    figures = root / 'report/figures'; figures.mkdir(exist_ok=True)
    (out/'summary.json').write_text(json.dumps(summary, indent=2, allow_nan=False)+'\n')
    macros = [('CommonMin','common_min','.6f'), ('CommonMax','common_max','.6f'),
              ('RawMin','raw_min','.6f'), ('RawMax','raw_max','.6f'),
              ('NominalAngle','nominal_F1_angle','.5f'),
              ('ExtensionAngle','r33_min_angle','.4e'),
              ('ExtensionWeight','r33_max_weight','.2f')]
    macro_lines = []
    for name, key, fmt in macros:
        value = format(summary[key], fmt)
        if fmt.endswith('e'):
            mantissa, exponent = value.split('e')
            value = mantissa + r'\times10^{' + str(int(exponent)) + '}'
        macro_lines.append('\\newcommand{\\' + name + '}{' + value + '}')
    (out/'numbers.tex').write_text('\n'.join(macro_lines)+'\n')
    with (out/'budgets.csv').open('w',newline='') as f:
        w=csv.writer(f); w.writerow(['branch','metric','ell','one_radius_per_rho','pairwise_separation_per_rho'])
        for row in summary['budget_rows']:
            for metric in ('common_reference','raw_identity'):
                v=row[metric];w.writerow([row['branch'],metric,v['minimum_budget_ell'],v['one_compensator_radius_per_unit_rho'],v['pairwise_max_separation_per_unit_rho']])
    ranks=[]
    for name in consumer.BRANCHES:
        b=r31['branches'][name]
        ranks.append([name.replace('_',r'\_')]+[b[m][k] for m in ('F1','F2')
            for k in ('resolved_rank','augmented_resolved_rank','full24_identified_target_rank')])
    (out/'ranks.tex').write_text(tex_table(
        r'Branch & $r_1$ & $r_{1+a}$ & $q_1$ & $r_2$ & $r_{2+a}$ & $q_2$',ranks,'lrrrrrr'))
    nominal=bounded['branches'][consumer.BRANCHES[0]]
    coeffs=[[label.replace('_',r'\_'),f'{d:.6g}',f'{c:.6g}',f'{i:.6g}'] for label,d,c,i in zip(
        consumer.MOMENTS,bounded['common_reference_column_scales'],nominal['common_reference']['minimum_coefficients_c9'],nominal['raw_identity']['minimum_coefficients_c9'])]
    (out/'coefficients.tex').write_text(tex_table(
        r'Moment & $d_j$ & $(c_M)_j$ & $(c_I)_j$',coeffs,'lrrr'))
    with (out/'coefficients.csv').open('w',newline='') as f:
        w=csv.writer(f);w.writerow(['moment','d','c_common','c_raw'])
        for values in zip(consumer.MOMENTS,bounded['common_reference_column_scales'],nominal['common_reference']['minimum_coefficients_c9'],nominal['raw_identity']['minimum_coefficients_c9']):w.writerow(values)
    with (out/'R33_comparison.csv').open('w',newline='') as f:
        w=csv.DictWriter(f,fieldnames=list(summary['r33_rows'][0]));w.writeheader();w.writerows(summary['r33_rows'])
    import matplotlib
    matplotlib.use('Agg')
    import matplotlib.pyplot as plt
    plt.rcParams.update({'font.size':10,'axes.spines.top':False,'axes.spines.right':False,
                         'pdf.fonttype':42,'svg.fonttype':'none'})
    colors=['#0072B2','#009E73','#D55E00','#56B4E9','#CC79A7','#E69F00']
    fig,axes=plt.subplots(1,2,figsize=(10,3.7),layout='constrained')
    for ax,metric,title in zip(axes,('common_reference','raw_identity'),('Fixed common metric','Raw identity metric')):
        for name,color in zip(consumer.BRANCHES,colors):
            row=bounded['branches'][name][metric]
            rho=[0.,1.,2.,3.,4.]
            ax.plot(rho,[r*row['one_compensator_radius_per_unit_rho'] for r in rho],color=color,lw=1.3)
            ax.plot(rho,[r*row['pairwise_max_separation_per_unit_rho'] for r in rho],color=color,lw=1.3,ls='--')
        ax.set(xlabel=r'Joint moment budget $\rho$ [$\mu$K$_{\rm CMB}$]',ylabel=r'Target norm / separation [$\mu$K$_{\rm CMB}$]',title=title,xlim=(0,4),ylim=(0,None))
        ax.text(.04,.95,'Solid: one compensator\nDashed: two bounded foregrounds\nSix convention curves nearly coincide',transform=ax.transAxes,va='top',fontsize=8)
        ax.grid(alpha=.18)
    for extension in ('pdf','svg'):fig.savefig(figures/f'frontier.{extension}')
    plt.close(fig)
    fig,axes=plt.subplots(1,2,figsize=(10,3.7),layout='constrained')
    for name,color in zip(consumer.BRANCHES,colors):
        for ax,model in zip(axes,('F1','F2')):
            sigma=r31['branches'][name][model]['normalized_singular_values']
            ax.semilogy(range(1,len(sigma)+1),sigma,'o-',ms=3,color=color,label=name.replace('_BT_',' / '))
    for ax,model in zip(axes,('F1','F2')):
        ax.set(xlabel='Ordered singular direction',ylabel='Singular value (dimensionless)',title='Five-column first order' if model=='F1' else 'Nine-column second order')
        ax.grid(alpha=.18)
    axes[1].legend(fontsize=7,frameon=False)
    for extension in ('pdf','svg'):fig.savefig(figures/f'response_spectra.{extension}')
    plt.close(fig)
    fig,axes=plt.subplots(1,2,figsize=(10,3.7),layout='constrained')
    for ax,metric,title in zip(axes,('common_reference','raw_identity'),('Fixed common metric','Raw identity metric')):
        values=nominal[metric]['budget_squared_contributions_7']
        ax.bar(range(1,8),values,color='#0072B2');ax.set_yscale('log')
        ax.set(xlabel='Whitened singular direction',ylabel=r'Contribution to $\ell^2$ (dimensionless)',title=title,xticks=range(1,8));ax.grid(axis='y',alpha=.18)
    for extension in ('pdf','svg'):fig.savefig(figures/f'budget_contributions.{extension}')
    plt.close(fig)
    provenance={'owner':'obsstat','claim_tier':'C0','artifact_mode':'PUBLICATION_CANDIDATE',
        'allowed_use':'Conditional finite signed-moment spectral geometry and budget frontiers',
        'transfer_source':'none','null_status':'NOT_CALIBRATED','covariance_status':'NO_NOISE_LAW_CONSUMED',
        'frame':'Common retained signed24 source harmonic frame; no new frame transfer',
        'seed':'none; deterministic curves from stored slopes',
        'sources':bindings,'generator':'publication.py',
        'figures':{'frontier.pdf':'Declared rho grid 0..4 target-amplitude units; stored one/pair slopes, both metrics, all6 branches',
                   'response_spectra.pdf':'R31 stored branch-column-normalized nuisance spectra; not fixed common metric',
                   'budget_contributions.pdf':'Stored nominal A/1e-7 squared-budget contributions, both metrics'},
        'forbidden_uses':['actual sky amplitude','noise-calibrated confidence','physical moment prior','family identification']}
    (out/'ASSET_PROVENANCE.json').write_text(json.dumps(provenance,indent=2)+'\n')
    print(json.dumps({k:v for k,v in summary.items() if k not in ('budget_rows','r33_rows')},indent=2))

if __name__=='__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--root',type=Path,default=Path(__file__).resolve().parent)
    generate(parser.parse_args().root)
