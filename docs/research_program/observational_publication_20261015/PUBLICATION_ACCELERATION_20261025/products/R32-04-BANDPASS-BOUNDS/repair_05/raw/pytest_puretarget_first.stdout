        assert at_zero["status"] == "SINGLETON_EXACT_STRUCTURAL"
        assert at_zero["J0"] == at_zero["radius"] == 0.0
        assert np.array_equal(at_zero["center"], s)
        for rho in (scale * 1e-200, scale):
            result = candidate.identified(Y, F, a, d, sol, rho)
