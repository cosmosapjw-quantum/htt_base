+def output_geometry_error(high: dict, center: np.ndarray, radius: float,
+                          Y: np.ndarray, a: np.ndarray,
+                          residual: np.ndarray) -> dict | None:
+    """Homogeneous full24 image bound for serialized center/radius/witness.
+
+    Includes 24 center conversions, radius conversion, retained ell accuracy,
+    rho-square/J0 uncertainty and one final center-plus-direction rounding.
+    """
+    import mpmath as mp
+    j0, j_error, c_true, ell, ell_error, rho_mp, inverse_frobenius = high["mp_state"]
+    with mp.workdps(120):
+        eps = mp.mpf(float(np.finfo(float).eps))
+        radius_mp = mp.mpf(float(radius))
+        delta_center = (mp.sqrt(sum((mp.mpf(float(center[j])) - c_true[j])**2
+                                    for j in range(24)))
+                        + mp.mpf(float(high["center_error"])))
+        addition_roundoff = (2 * eps
+                             * (mp.sqrt(sum(mp.mpf(float(x))**2 for x in center))
+                                + radius_mp))
+        delta_center += addition_roundoff
+        gap = rho_mp**2 - j0
+        gap_error = j_error + mp.mpf(float(high["budget_roundoff"]))
+        if ell <= ell_error or gap <= 0 or radius_mp < 0:
+            return None
+        r_lower = (mp.sqrt(max(mp.mpf('0'), gap - gap_error))
+                   / (ell + ell_error))
+        r_upper = (mp.sqrt(gap + gap_error) / (ell - ell_error))
+        delta_radius = max(abs(radius_mp - r_lower), abs(r_upper - radius_mp))
+        delta_total = delta_center + delta_radius
+        ell2_error = 2 * ell * ell_error + ell_error**2
+        residual_relation_error = mp.sqrt(sum(
+            (mp.mpf(float(residual[i, j]))
+             - (mp.mpf(float(Y[i, j])) - mp.mpf(float(a[i]))
+                * mp.mpf(float(center[j]))))**2
+            for i in range(7) for j in range(24)))
+        residual_weighted_error = mp.sqrt(inverse_frobenius) * residual_relation_error
+        residual_budget_error = (2 * mp.sqrt(j0 + j_error
+                                              + ell**2 * delta_center**2)
+                                 * residual_weighted_error
+                                 + residual_weighted_error**2)
+        image_error = (j_error + mp.mpf(float(high["budget_roundoff"]))
+                       + ell**2 * (2 * radius_mp * delta_total
+                                   + delta_total**2)
+                       + ell2_error * (radius_mp + delta_total)**2
+                       + residual_budget_error)
+        if not all(mp.isfinite(v) for v in (delta_center, delta_radius,
+                                            image_error)):
+            return None
+        return {"center_error_bound": float(delta_center),
+                "radius_error_bound": float(delta_radius),
+                "budget_image_error_bound": float(image_error),
+                "residual_relation_error": float(residual_relation_error),
+                "residual_budget_error_bound": float(residual_budget_error),
+                "reported_ell_error_bound": high["ell_error"]}
 
 
