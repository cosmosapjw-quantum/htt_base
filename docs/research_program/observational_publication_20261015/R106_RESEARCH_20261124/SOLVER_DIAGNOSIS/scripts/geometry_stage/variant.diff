+def _normalized_lie_geometry(H, sig, a_v, n_m, *, family, cell):
+    """H-normalised (sigma/H, a/H, n/H) with the exact R105 cell-loop filters and Jacobi projection."""
+    sigN = pstf_rank2(sig / H)
+    aN = a_v / H
+    nN = n_m / H
+    scale = float(aN @ aN + np.sum(nN * nN))
+    if scale <= 1e-24:
+        aN = np.zeros(3, dtype=np.float64)
+        nN = np.zeros((3, 3), dtype=np.float64)
+    elif float(aN @ aN) <= 1e-24 * max(scale, 1.0):
+        aN = np.zeros(3, dtype=np.float64)
+        nN = 0.5 * (nN + nN.T)
+    else:
+        jac = float(np.max(np.abs(nN @ aN))) / scale
+        if jac > 1e-8:
+            raise CodazziProjectionError(f"[{family}] Lie Jacobi breach at stage in cell {cell}: {jac:.3e}")
+        if jac > 5e-12:
+            anorm2 = float(aN @ aN)
+            a_hat = aN / math.sqrt(anorm2)
+            proj = np.eye(3, dtype=np.float64) - np.outer(a_hat, a_hat)
+            n_proj = proj @ nN @ proj
+            nN = 0.5 * (n_proj + n_proj.T)
+    return sigN, aN, nN
+
