+def _advance_moving_photon_cell_stage_geometry(op, state, delta_N, geometry_at, sub_depths,
+                                               baryon_velocity_at, *, sub_edges=None):
+    """R106-H2 variant of ``_advance_moving_photon_cell``.
+
+    Identical SDIRK(2,2) tableau, optical substeps, conserved-anchor depths and
+    stage-time electron velocity. The Lie/bolometric operator and the shear source
+    of each stage are evaluated at that stage's own cell coordinate u via
+    ``geometry_at(u) -> (LieGeometry, sigma_N)``; the source per unit u is
+    ``shear_source_vector(sigma_N(u), amplitude=delta_N)`` and each stage adds
+    ``gamma*h`` times it (h = substep width in u), exactly as the frozen version.
+    """
+    gamma = 1.0 - 1.0 / math.sqrt(2.0)
+    edges = np.linspace(0.,1.,len(sub_depths)+1) if sub_edges is None else np.asarray(sub_edges,dtype=float)
+    if (edges.shape != (len(sub_depths)+1,) or edges[0] != 0. or edges[-1] != 1.
+        or not np.isfinite(edges).all() or np.any(np.diff(edges) <= 0)):
+        raise ValueError("sub_edges must cover [0,1] in increasing order and match sub_depths")
+    y = np.array(state, dtype=np.complex128, copy=True)
+    for j, depth in enumerate(sub_depths):
+        h = edges[j+1]-edges[j]
+        rate = float(depth) / h
+        stages = []
+        for c in (gamma, 1.0):
+            u = edges[j] + c * h
+            geom_u, sig_u = geometry_at(u)
+            m_total = delta_N * (op.base_operator(geom_u) + op.bolometric_redshift_operator(geom_u))
+            src_u = op.shear_source_vector(sig_u, amplitude=delta_N)
+            v = np.asarray(baryon_velocity_at(u), dtype=np.float64)
+            inc = gamma * h * src_u
+            if rate > 0.0 and np.any(v):
+                moving = MovingCollisionStage(op, v)
+                solve = moving.factor_sdirk_stage(m_total, gamma * h, rate)
+                inc = inc + gamma * float(depth) * moving.emission
+            else:
+                solve = op.factor_sdirk_stage(m_total, gamma * h, rate)
+            stages.append((solve, inc))
+        (solve1, inc1), (solve2, inc2) = stages
+        y1 = solve1(y + inc1)
+        y = solve2(y + ((1.0 - gamma) / gamma) * (y1 - y) + inc2)
+    if not np.all(np.isfinite(y)):
+        raise FloatingPointError("moving photon cell produced a non-finite state")
+    return y
+
