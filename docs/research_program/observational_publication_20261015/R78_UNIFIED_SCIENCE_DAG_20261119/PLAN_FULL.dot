    "PHY-05" [label="PHY-05\\nexceptional VI_-1/9 rank M", fillcolor="#dce9fb", tooltip="PHY-05 / theory_verified_physical_data_pending / exceptional VI_-1/9 rank M2 left flux null; independent noisy residual covariance can rank3"];
