    "SQ-CMB-NULL" [label="SQ-CMB-NULL\\nQualified release-matched ", fillcolor="#fbe1e1", tooltip="SQ-CMB-NULL / blocked_source / Qualified release-matched CMB T/E/B Monte Carlo/null"];
    "SQ-PHOTON-FLUX" [label="SQ-PHOTON-FLUX\\nPhoton flux/kinetic higher", fillcolor="#fbe1e1", tooltip="SQ-PHOTON-FLUX / blocked_source / Photon flux/kinetic higher moments and common normal source"];
    "SQ-LIE-FLUX" [label="SQ-LIE-FLUX\\nIndependent normal-frame r", fillcolor="#fbe1e1", tooltip="SQ-LIE-FLUX / blocked_source / Independent normal-frame rho,j,pi and Bianchi family source"];
    "SQ-OPTICAL" [label="SQ-OPTICAL\\nFinite-redshift Sachs/Jaco", fillcolor="#fff1d7", tooltip="SQ-OPTICAL / pending_conditional / Finite-redshift Sachs/Jacobi + position-drift transfer"];
