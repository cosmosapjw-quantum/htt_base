digraph R78 {
  graph [rankdir=LR, pad=0.4, nodesep=0.30, ranksep=0.62, splines=polyline, concentrate=true, fontname="DejaVu Sans", fontsize=16, label="R78 unified 60-node / 129-edge science dependency DAG", labelloc=t];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, margin="0.11,0.08", color="#8698a8"];
  edge [color="#a4aeb9", arrowsize=0.53, penwidth=0.8];
  subgraph cluster_COMMON {
    label="공통 정본 (7)"; style=rounded; color="#b5c8da"; bgcolor="#fafcff"; fontsize=13;
    "E0" [label="E0", fillcolor="#dcefe3", tooltip="E0 / completed_scoped / Reused published solver-free dossier (NOT newly revalidated astrophysical claims)"];
    "E1" [label="E1", fillcolor="#dcefe3", tooltip="E1 / completed_scoped / Reused real CF4 35,970-group Schur diagnostic only"];
    "E2" [label="E2", fillcolor="#dcefe3", tooltip="E2 / completed_scoped / Reused Planck 9 same-sky + FFP10 999 signal / 300 noise MES conditioning"];
    "E3" [label="E3", fillcolor="#dcefe3", tooltip="E3 / completed_scoped / Frozen PR066/PR521 samplewise functional operators (not physical likelihood)"];
    "X01" [label="X01", fillcolor="#dcefe3", tooltip="X01 / completed_scoped / Bind physical source identities and overlaps across all 6 papers"];
    "X02" [label="X02", fillcolor="#dcefe3", tooltip="X02 / completed_scoped / Complete precise six-paper primary literature novelty comparator"];
    "X03" [label="X03", fillcolor="#dcefe3", tooltip="X03 / completed_scoped / Freeze prospective statistics versus known historical choices"];
  }
  subgraph cluster_P1 {
    label="P1 signed inference"; style=rounded; color="#b5c8da"; bgcolor="#fafcff"; fontsize=13;
    "S01" [label="S01", fillcolor="#dcefe3", tooltip="S01 / completed_scoped / Define typed common x,F,Pi,Q,G_F and boundary domains"];
    "S02" [label="S02", fillcolor="#fbe1e1", tooltip="S02 / blocked_input / Run actual-data conditional finite draw pushforward, retaining unknown physical sectors"];
    "S03" [label="S03", fillcolor="#ebeff3", tooltip="S03 / pending / Evaluate nontrivial anchor/floor, depth and selection sensitivity"];
    "S04" [label="S04", fillcolor="#ebeff3", tooltip="S04 / pending / Qualify real observational law or rigorous externally calibrated identified interval"];
    "S05" [label="S05", fillcolor="#ebeff3", tooltip="S05 / pending / Write P1 real-data statistical-functional paper"];
    "S06" [label="S06", fillcolor="#ebeff3", tooltip="S06 / pending / Decide publication readiness without submitting"];
  }
  subgraph cluster_P2 {
    label="P2 CMB"; style=rounded; color="#b5c8da"; bgcolor="#fafcff"; fontsize=13;
    "L01" [label="L01", fillcolor="#dcefe3", tooltip="L01 / completed_scoped / Map real Planck low-l harmonic/STF/beam/mask/transfer response"];
    "L02" [label="L02", fillcolor="#dcefe3", tooltip="L02 / completed_scoped / Predefine tensor invariant/orbit morphology and selection family"];
    "L03" [label="L03", fillcolor="#ebeff3", tooltip="L03 / pending / Establish release-matched Planck signal+noise+foreground null adequacy"];
    "L04" [label="L04", fillcolor="#ebeff3", tooltip="L04 / pending / Compute corrected joint large-angle morphology rarity"];
    "L05" [label="L05", fillcolor="#ebeff3", tooltip="L05 / pending / Analyze anomaly versus robust negative null interpretation"];
    "L06" [label="L06", fillcolor="#ebeff3", tooltip="L06 / pending / Decide and draft P2 manuscript"];
  }
  subgraph cluster_P3 {
    label="P3 directional H(z,n)"; style=rounded; color="#b5c8da"; bgcolor="#fafcff"; fontsize=13;
    "H01" [label="H01", fillcolor="#dcefe3", tooltip="H01 / completed_scoped / Define H_W(z,n) under survey radial/angular window and velocity law"];
    "H02" [label="H02", fillcolor="#ebeff3", tooltip="H02 / pending / Build empirical CF4 method-selection/calibration/velocity covariance model"];
    "H03" [label="H03", fillcolor="#dcefe3", tooltip="H03 / completed_scoped / Fit observed depth windows monopole/dipole/STF2 with method and patch comparisons"];
    "H04" [label="H04", fillcolor="#ebeff3", tooltip="H04 / pending / Infer physical H(z,n) alternatives with peculiar-velocity and survey covariance"];
    "H05" [label="H05", fillcolor="#ebeff3", tooltip="H05 / pending / Compare 2025–26 CF4 conflicting null and anisotropic papers"];
    "H06" [label="H06", fillcolor="#ebeff3", tooltip="H06 / pending / Decide and draft P3 manuscript"];
  }
  subgraph cluster_P4 {
    label="P4 boost / tilt"; style=rounded; color="#b5c8da"; bgcolor="#fafcff"; fontsize=13;
    "V01" [label="V01", fillcolor="#dcefe3", tooltip="V01 / completed_scoped / Fix beta_RO, beta_RM, beta_MO, windowed B and rapidity with congruence"];
    "V02" [label="V02", fillcolor="#dcefe3", tooltip="V02 / completed_scoped / Inject finite local observer boost through the actual processed Planck source"];
    "V03" [label="V03", fillcolor="#dcefe3", tooltip="V03 / completed_scoped / Obtain physically distinct global tilt source-history response (not endpoint copy)"];
    "V04" [label="V04", fillcolor="#ebeff3", tooltip="V04 / pending / Measure projected local-global information and stable singular values"];
    "V05" [label="V05", fillcolor="#ebeff3", tooltip="V05 / pending / Calibrated local/global joint inference and independent injections"];
    "V06" [label="V06", fillcolor="#ebeff3", tooltip="V06 / pending / Decide and draft P4 manuscript"];
  }
  subgraph cluster_P5 {
    label="P5 Bianchi"; style=rounded; color="#b5c8da"; bgcolor="#fafcff"; fontsize=13;
    "B01" [label="B01", fillcolor="#dcefe3", tooltip="B01 / completed_scoped / Inventory admissible Bianchi I–IX and exceptional VI_-1/9 source/mode templates"];
    "B02" [label="B02", fillcolor="#ebeff3", tooltip="B02 / pending / Qualify external native polarized all-m and high-ell Bianchi transfer atlas"];
    "B03" [label="B03", fillcolor="#ebeff3", tooltip="B03 / pending / Convolve physical Bianchi atlas with actual Planck response and null"];
    "B04" [label="B04", fillcolor="#ebeff3", tooltip="B04 / pending / Evaluate family equivalence, confusion/injection recovery and Bayes evidence"];
    "B05" [label="B05", fillcolor="#ebeff3", tooltip="B05 / pending / Decide/draft independent Bianchi identification paper or verified subset"];
