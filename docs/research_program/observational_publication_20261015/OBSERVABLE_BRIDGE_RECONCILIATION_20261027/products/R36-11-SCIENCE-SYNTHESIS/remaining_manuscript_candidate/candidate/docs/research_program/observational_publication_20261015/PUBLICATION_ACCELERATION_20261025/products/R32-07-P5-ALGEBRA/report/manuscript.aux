\newlabel{physical-interpretation-and-scope}{{VI}{8}{}{section*.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Deterministic separation of the history pair by an additional endpoint shear measurement. Equal closed Frobenius-error balls are disjoint for $r_{\mathrm  {err}}<\alpha \sqrt  6\epsilon /2$, touch at equality, and intersect above it. The radius is a deterministic tensor-error allowance with no probability or confidence interpretation.}}{9}{figure.6}\protected@file@percent }
\newlabel{fig:error_geometry}{{6}{9}{Deterministic separation of the history pair by an additional endpoint shear measurement. Equal closed Frobenius-error balls are disjoint for $r_{\mathrm {err}}<\alpha \sqrt 6\epsilon /2$, touch at equality, and intersect above it. The radius is a deterministic tensor-error allowance with no probability or confidence interpretation}{figure.6}{}}
