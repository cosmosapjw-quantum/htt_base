\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Instantaneous LRS Bianchi V boundary images for one perfect fluid and nonnegative cosmological constant. Columns show the maximal rest-density parameter and its signed normalized shear at $\Omega _\Lambda =0$; rows use $w=0$ and $w=1/3$. The displayed support is $0.02\le K\le 0.98$, $-0.9\le \beta \le 0.9$. The sign follows the oriented momentum constraint.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:domain}{{1}{4}{Instantaneous LRS Bianchi V boundary images for one perfect fluid and nonnegative cosmological constant. Columns show the maximal rest-density parameter and its signed normalized shear at $\Omega _\Lambda =0$; rows use $w=0$ and $w=1/3$. The displayed support is $0.02\le K\le 0.98$, $-0.9\le \beta \le 0.9$. The sign follows the oriented momentum constraint}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Coupled shear--density image curves at fixed curvature, tilt and equation of state. Each curve varies $u$ from zero to one in (9), with signed mirror branches displayed. The terminal points have $\Omega _\Lambda =0$. Scalar projection intervals cannot be recombined independently.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:joint_image}{{2}{4}{Coupled shear--density image curves at fixed curvature, tilt and equation of state. Each curve varies $u$ from zero to one in (9), with signed mirror branches displayed. The terminal points have $\Omega _\Lambda =0$. Scalar projection intervals cannot be recombined independently}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Exact allowed tilt speed at fixed rest-density parameter and curvature. Curves use $\Omega =0.1,0.3,0.6$ and the indicated equation of state. The boundary saturates the normal constraint with $\Omega _\Lambda =0$. Gaps mark the empty domain ($K+\Omega >1$); the line at 0.9 marks only the heatmap display support.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:fixed_matter_tilt}{{3}{5}{Exact allowed tilt speed at fixed rest-density parameter and curvature. Curves use $\Omega =0.1,0.3,0.6$ and the indicated equation of state. The boundary saturates the normal constraint with $\Omega _\Lambda =0$. Gaps mark the empty domain ($K+\Omega >1$); the line at 0.9 marks only the heatmap display support}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {B}Finite-tilt and ultrarelativistic envelopes}{5}{section*.25}\protected@file@percent }
\newlabel{finite-tilt-and-ultrarelativistic-envelopes}{{IV\,B}{5}{}{section*.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Sharp compact-support shear envelopes at $|\beta |\le 0.9$ for $w=0,1/3,1$, compared with the ultrarelativistic supremum $(1-\sqrt  K)^2$. For $0<K<1$ the dashed limiting curve is approached at finite normal energy and vanishing rest density as $|\beta |\to 1$; it is not an attained finite-timelike state.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:shear_envelope}{{4}{6}{Sharp compact-support shear envelopes at $|\beta |\le 0.9$ for $w=0,1/3,1$, compared with the ultrarelativistic supremum $(1-\sqrt K)^2$. For $0<K<1$ the dashed limiting curve is approached at finite normal energy and vanishing rest density as $|\beta |\to 1$; it is not an attained finite-timelike state}{figure.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {V}Identical radiation and different shear histories}{7}{section*.30}\protected@file@percent }
\newlabel{identical-radiation-and-different-shear-histories}{{V}{7}{}{section*.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Exact kinematic Bianchi I histories with equal final radiation. The signed $zz$ shear components and $b_{zz}$ histories differ, while their full final axisymmetric temperature functions coincide. The endpoint shear ratio is $9/5$. The radiation equality follows from common endpoint deformation and collisionless transport, without an Einstein-perfect-fluid evolution assumption.}}{8}{figure.5}\protected@file@percent }
\newlabel{fig:history_temperature}{{5}{8}{Exact kinematic Bianchi I histories with equal final radiation. The signed $zz$ shear components and $b_{zz}$ histories differ, while their full final axisymmetric temperature functions coincide. The endpoint shear ratio is $9/5$. The radiation equality follows from common endpoint deformation and collisionless transport, without an Einstein-perfect-fluid evolution assumption}{figure.5}{}}
