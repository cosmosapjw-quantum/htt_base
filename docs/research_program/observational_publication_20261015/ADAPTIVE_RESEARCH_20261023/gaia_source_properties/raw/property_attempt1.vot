<INFO name="JOBNAME" value=""/>
<INFO name="QUERY_STATUS" value="OK"/>
<INFO name="QUERY" value="SELECT u.source_id AS retained_source_id,q.source_id AS qso_source_id,q.host_galaxy_detected,q.host_galaxy_flag,q.n_transits,q.classlabel_dsc_joint,q.vari_best_class_name,q.vari_best_class_score,q.vari_agn_membership_score,q.source_selection_flags FROM TAP_UPLOAD.ids4756 AS u LEFT OUTER JOIN gaiadr3.qso_candidates AS q ON u.source_id=q.source_id ORDER BY u.source_id" ucd="meta.query"/>

<PARAM name="CITATION" ucd="meta.bib" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/gaia-users/credits">
<DESCRIPTION>How to cite and acknowledge Gaia:</DESCRIPTION>
</PARAM>
<PARAM name="RELEASE" ucd="meta.version" datatype="char" arraysize="*" value="Gaia DR3">
<DESCRIPTION>Gaia data release</DESCRIPTION>
</PARAM>
<PARAM name="HELP" ucd="meta.ref.url" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/gaia-users/archive">
<DESCRIPTION>Tutorials, documentation, and help:</DESCRIPTION>
</PARAM>
<PARAM name="ISSUES" ucd="meta.ref.url" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/gaia-users/known-issues">
<DESCRIPTION>Known issues in the data:</DESCRIPTION>
</PARAM>
<PARAM name="DATA" ucd="meta.ref.url" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/gaia/data-access">
<DESCRIPTION>Gaia data:</DESCRIPTION>
</PARAM>
<PARAM name="TERMS" ucd="meta.ref.url" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/esdc/terms-and-conditions">
<DESCRIPTION>Terms and conditions for use of Gaia data:</DESCRIPTION>
</PARAM>
<PARAM name="HOME" ucd="meta.ref.url" datatype="char" arraysize="*" value="https://www.cosmos.esa.int/web/gaia">
<DESCRIPTION>Gaia mission home:</DESCRIPTION>
</PARAM>
<PARAM name="PUBLISHER" ucd="meta.id;meta.curation" datatype="char" arraysize="*" value="ESA/Gaia/DPAC">
<DESCRIPTION>Dataset publisher</DESCRIPTION>
</PARAM>
<PARAM name="CREATOR" ucd="meta.ref" datatype="char" arraysize="*" value="Gaia Collaboration">
<DESCRIPTION>Dataset creator</DESCRIPTION>
</PARAM>


<TABLE>
<FIELD datatype="long" name="retained_source_id"/>
<FIELD datatype="long" name="qso_source_id" ucd="meta.id">
<DESCRIPTION>Unique source identifier (unique within a particular Data Release)</DESCRIPTION>
</FIELD>
<FIELD datatype="boolean" name="host_galaxy_detected" ucd="stat.fit.param">
<DESCRIPTION>Flag indicating whether a host galaxy has been detected</DESCRIPTION>
</FIELD>
<FIELD datatype="short" name="host_galaxy_flag" ucd="meta.code.qual">
<DESCRIPTION>Flag indicative of processing or scientific quality for the morphological parameters fitting</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="n_transits" ucd="meta.number">
<DESCRIPTION>Number of transits used for the morphological analysis</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="classlabel_dsc_joint" ucd="meta.code.class">
<DESCRIPTION>Class assigned by DSC based on the probability from its Specmod and Allosmod classifiers</DESCRIPTION>
</FIELD>
<FIELD arraysize="*" datatype="char" name="vari_best_class_name" ucd="meta.code.class">
<DESCRIPTION>Name of best class, see table VariClassifierClassDefinition for details of the class</DESCRIPTION>
</FIELD>
<FIELD datatype="float" name="vari_best_class_score" ucd="stat.probability">
<DESCRIPTION>Score of the best class</DESCRIPTION>
</FIELD>
<FIELD datatype="double" name="vari_agn_membership_score" ucd="stat.probability">
<DESCRIPTION>Membership score (0=lowest,1=highest) of source to be of AGN type</DESCRIPTION>
</FIELD>
<FIELD datatype="int" name="source_selection_flags" ucd="meta.code.status">
<DESCRIPTION>Bit indicative of whether the input data from a given module met the source list eligibility criteria for the source of interest</DESCRIPTION>
</FIELD>
