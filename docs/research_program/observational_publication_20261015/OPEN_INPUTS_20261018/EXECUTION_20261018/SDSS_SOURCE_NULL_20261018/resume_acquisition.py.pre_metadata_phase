"""One approved append-only recovery of retained SDSS source ranges; no science."""
from __future__ import annotations

import argparse
from contextlib import contextmanager
import fcntl
import hashlib
import json
import os
from pathlib import Path
import signal
import time
import urllib.error
import urllib.parse
import urllib.request

from acquire_sdss import BLOCK, MD5, RANGES, TOTAL, URL, digest, validate_response

OVERLAP = 65536
INITIAL_SIZES = (1207959552, 796917760, 947912704)
API = "https://zenodo.org/api/records/6824749"
HERE = Path(__file__).resolve().parent


def durable_json(path, value):
    with path.open("x", encoding="utf-8") as stream:
        json.dump(value, stream, indent=2, sort_keys=True)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    directory = os.open(path.parent, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def prefix_digest(stream, length):
    stream.seek(0)
    sha = hashlib.sha256()
    remaining = length
    while remaining:
        block = stream.read(min(BLOCK, remaining))
        if not block:
            raise EOFError("Retained prefix shortened")
        sha.update(block)
        remaining -= len(block)
    return sha.hexdigest()


def resume_bounds(start, end, retained):
    length = end - start + 1
    if retained < OVERLAP or retained >= length:
        raise ValueError("Resume requires an incomplete retained prefix >= 65536 bytes")
    request_start = start + retained - OVERLAP
    request_length = end - request_start + 1
    if not (0 < request_length <= 4 * 1024**3):
        raise ValueError("Resume request exceeds frozen range bound")
    return request_start, request_length


def validate_metadata(value):
    if value.get("id") != 6824749 or value.get("metadata", {}).get("version") != "v1.1.0":
        raise ValueError("Official record/version identity mismatch")
    matches = [f for f in value.get("files", []) if f.get("key") == "mocks.tar.gz"]
    if len(matches) != 1 or matches[0].get("size") != TOTAL or matches[0].get("checksum") != "md5:" + MD5:
        raise ValueError("Official archive size/checksum identity mismatch")


def require_https(url):
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme != "https" or parsed.hostname != "zenodo.org":
        raise ValueError("Expected official Zenodo HTTPS response")


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, response, code, message, headers, new_url):
        # Returning None rejects before urllib reads the redirect body or follows.
        return None


def open_direct(request, timeout=120):
    """Exactly one direct request; HTTPError remains an inspectable response."""
    require_https(request.full_url)
    opener = urllib.request.build_opener(NoRedirect())
    try:
        return opener.open(request, timeout=timeout)
    except urllib.error.HTTPError as response:
        # Caller records status/headers, rejects, and closes without body read.
        return response


def verify_metadata(root, attempt):
    request = urllib.request.Request(API, headers={"Accept": "application/json", "Accept-Encoding": "identity"})
    record = {"url": API, "status": "STARTED"}
    try:
        with open_direct(request, timeout=120) as response:
            record.update(final_url=response.url, http_status=response.status,
                          headers=dict(response.headers.items()))
            durable_json(root / f"recovery.{attempt}.metadata.response.json", record)
            require_https(response.url)
            if response.status != 200:
                raise ValueError(f"Metadata requires direct HTTP200; received {response.status}; body not read")
            if response.headers.get("Content-Encoding", "identity") not in ("", "identity"):
                raise ValueError("Encoded metadata response rejected before body read")
            raw = response.read(2 * 1024**2 + 1)
            record.update(raw_body_utf8=raw.decode("utf-8"))
            path = root / f"recovery.{attempt}.metadata.json"
            durable_json(path, record)
            if len(raw) > 2 * 1024**2:
                raise ValueError("Metadata size boundary failed")
            validate_metadata(json.loads(raw))
        return path
    except BaseException as error:
        record.update(status="FAILED_PRESERVED", error=repr(error))
        durable_json(root / f"recovery.{attempt}.metadata.failure.json", record)
        raise


def seal(root, output):
    """Read-only source preimages; never starts a network request."""
    values = []
    for (start, end), expected in zip(RANGES, INITIAL_SIZES):
        part = root / f"mocks.{start}-{end}.part"
        before = part.stat()
        if before.st_size != expected:
            raise ValueError("Retained size changed; return to controller")
        sha = digest(part)
        after = part.stat()
        if (before.st_size, before.st_mtime_ns, before.st_ino) != (after.st_size, after.st_mtime_ns, after.st_ino):
            raise ValueError("Retained part changed during preseal")
        original = root / f"range.{start}-{end}.response.json"
        metadata = json.loads(original.read_text())
        headers = {key.title(): val for key, val in metadata["headers"].items()}
        validate_response(metadata["http_status"], headers, start, end)
        if metadata["url"] != URL or metadata["source_version"] != "v1.1.0":
            raise ValueError("Original response source identity mismatch")
        require_https(metadata["final_url"])
        request_start, request_length = resume_bounds(start, end, expected)
        values.append({"start": start, "end": end, "bytes": expected, "sha256": sha,
                       "inode": before.st_ino, "mtime_ns": before.st_mtime_ns,
                       "original_response": str(original), "original_response_sha256": digest(original),
                       "request_start": request_start, "request_length": request_length})
    old_pids = (747838, 762427, 762426, 799127)
    if any(Path(f"/proc/{pid}").exists() for pid in old_pids):
        raise ValueError("Historical PID exists; controller must classify it")
    result = {"status": "PRESEALED", "ranges": values, "url": URL, "archive_total": TOTAL,
              "archive_md5": MD5, "old_pids_absent": list(old_pids),
              "historical_exit_codes": "UNKNOWN", "disappearance_cause": "UNKNOWN",
              "source_sha256": {p.name: digest(p) for p in HERE.glob("*.py")},
              "contract_sha256": digest(HERE / "CONTRACT.md"),
              "scientific_budget_sha256": digest(HERE / "SCIENTIFIC_BUDGET.jsonl"),
              "scientific_execution": "NOT_STARTED", "utc_epoch": time.time()}
    durable_json(output, result)
    return result


@contextmanager
def locked_part(path, expected):
    with path.open("r+b", buffering=0) as stream:
        fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        # O_APPEND makes every write append-only, even after reads/overlap checks.
        fcntl.fcntl(stream, fcntl.F_SETFL, fcntl.fcntl(stream, fcntl.F_GETFL) | os.O_APPEND)
        before = os.fstat(stream.fileno())
        if before.st_size != expected["bytes"] or prefix_digest(stream, expected["bytes"]) != expected["sha256"]:
            raise ValueError("Retained prefix size/SHA changed before append")
        if os.fstat(stream.fileno()).st_size != before.st_size:
            raise ValueError("Retained prefix grew during identity check")
        yield stream


def append_response(stream, response, expected, total_length):
    """Compare the entire overlap before any write; preserve all successful writes."""
    retained = expected["bytes"]
    stream.seek(retained - OVERLAP)
    tail = stream.read(OVERLAP)
    overlap = bytearray()
    while len(overlap) < OVERLAP:
        block = response.read(OVERLAP - len(overlap))
        if not block:
            raise EOFError("Short overlap; no append")
        overlap.extend(block)
    if len(tail) != OVERLAP or overlap != tail:
        raise ValueError("Overlap mismatch; no append")
    written = 0
    last_progress = time.monotonic()
    try:
        while retained + written < total_length:
            block = response.read(min(BLOCK, total_length - retained - written))
            if not block:
                raise EOFError(f"Short resumed body at part byte {retained + written}")
            if os.fstat(stream.fileno()).st_size != retained + written:
                raise ValueError("Concurrent part mutation detected")
            view = memoryview(block)
            while view:
                count = stream.write(view)
                if not count:
                    raise OSError("Short filesystem write")
                written += count
                view = view[count:]
            if time.monotonic() - last_progress >= 10:
                os.fsync(stream.fileno())
                print(f"RESUME part {retained+written}/{total_length} bytes", flush=True)
                last_progress = time.monotonic()
        if response.read(1):
            raise ValueError("Resumed body exceeds declared length")
    finally:
        os.fsync(stream.fileno())
    if prefix_digest(stream, retained) != expected["sha256"]:
        raise ValueError("Original retained prefix identity changed")
    return written


def resume_one(root, expected, attempt):
    start, end = expected["start"], expected["end"]
    part = root / f"mocks.{start}-{end}.part"
    completed = root / f"range.{start}-{end}.json"
    if completed.exists():
        receipt = json.loads(completed.read_text())
        if (receipt.get("status") != "VALIDATED" or receipt.get("url") != URL
                or receipt.get("start") != start or receipt.get("end") != end
                or receipt.get("archive_total") != TOTAL or part.stat().st_size != end-start+1
                or digest(part) != receipt.get("sha256")):
            raise ValueError("Completed receipt identity mismatch")
        print(f"REUSE validated range {start}-{end}", flush=True)
        return
    request_start, request_length = resume_bounds(start, end, expected["bytes"])
    if (request_start, request_length) != (expected["request_start"], expected["request_length"]):
        raise ValueError("Frozen resume derivation mismatch")
    prefix = root / f"recovery.{attempt}.range.{start}-{end}"
    record = {"status": "STARTED", "url": URL, "source_version": "v1.1.0", "start": start,
              "end": end, "archive_total": TOTAL, "retained_bytes": expected["bytes"],
              "retained_prefix_sha256": expected["sha256"], "request_start": request_start,
              "request_length": request_length, "overlap_bytes": OVERLAP,
              "original_response": expected["original_response"],
              "original_response_sha256": expected["original_response_sha256"],
              "whole_archive_md5": "PENDING", "pid": os.getpid()}
    started = time.monotonic()
    try:
        with locked_part(part, expected) as stream:
            request = urllib.request.Request(URL, headers={"Range": f"bytes={request_start}-{end}",
                                                        "Accept-Encoding": "identity"})
            with open_direct(request, timeout=120) as response:
                record.update(http_status=response.status, headers=dict(response.headers.items()),
                              final_url=response.url, etag=response.headers.get("ETag", "UNAVAILABLE"))
                durable_json(Path(str(prefix) + ".response.json"), record)
                require_https(response.url)
                validate_response(response.status, response.headers, request_start, end)
                appended = append_response(stream, response, expected, end - start + 1)
            if os.fstat(stream.fileno()).st_size != end - start + 1:
                raise ValueError("Final part size mismatch")
            record.update(status="VALIDATED", bytes=end-start+1, resumed_new_bytes=appended,
                          sha256=prefix_digest(stream, end-start+1),
                          retained_prefix_sha256_after=prefix_digest(stream, expected["bytes"]),
                          elapsed_s=time.monotonic()-started,
                          provenance="original retained prefix plus overlap-verified resumed suffix")
            durable_json(completed, record)
            print(json.dumps(record), flush=True)
    except BaseException as error:
        record.update(status="FAILED_PRESERVED", error=repr(error),
                      partial_bytes=part.stat().st_size, elapsed_s=time.monotonic()-started)
        durable_json(Path(str(prefix) + ".failure.json"), record)
        raise


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("root", type=Path)
    parser.add_argument("--seal", type=Path)
    parser.add_argument("--range-index", type=int, choices=range(3))
    parser.add_argument("--preseal", type=Path)
    parser.add_argument("--attempt")
    args = parser.parse_args()
    if args.seal:
        seal(args.root, args.seal)
    elif args.preseal and args.attempt and args.range_index is not None:
        def interrupted(signum, frame):
            raise InterruptedError(f"Controller signal {signum}; prefix preserved")
        signal.signal(signal.SIGTERM, interrupted)
        signal.signal(signal.SIGINT, interrupted)
        snapshot = json.loads(args.preseal.read_text())
        resume_one(args.root, snapshot["ranges"][args.range_index], args.attempt)
    else:
        parser.error("Use --seal or explicit --preseal/--attempt/--range-index")
