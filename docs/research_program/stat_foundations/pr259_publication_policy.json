{
  "policy_id": "PR259-PUBLICATION-POLICY",
  "schema_version": 1,
  "change_set_id": "CS-PR259-FROZEN-LINEAGE",
  "publication_group_id": "PG-PR259-FROZEN-LINEAGE",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "e7c20643c0dd323481f0887aff8e437a1bf7950a",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "required_review_cells": [
    "candidate_identity",
    "historical_hash_preservation",
    "registered_transition_authority",
    "unknown_and_duplicate_transition_refusal",
    "prior_and_current_hash_mutation",
    "bootstrap_scope",
    "canonical_mirror_equivalence",
    "collection_regression",
    "claim_ceiling",
    "latest_target_integration"
  ],
  "required_commands": [
    {
      "id": "pr259-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr259_chronology.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr259-dag",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml"
      ],
      "timeout_seconds": 180
    },
    {
      "id": "pr259-mirrors",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/sync_pr_dag_mirrors.py",
        "--check"
      ],
      "timeout_seconds": 180
    },
    {
      "id": "pr259-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr259_chronology.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed"
  ],
  "forbidden_inputs": [
    "historical receipt rewrite",
    "native-solver output",
    "native morphology atlas",
    "observed-data science output"
  ]
}
