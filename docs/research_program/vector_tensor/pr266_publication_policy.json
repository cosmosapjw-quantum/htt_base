{
  "policy_id": "PR266-PUBLICATION-POLICY",
  "schema_version": 1,
  "change_set_id": "CS-PR266-DEPTH-MASK-PATH",
  "publication_group_id": "PG-PR266-DEPTH-MASK-PATH",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "e7c20643c0dd323481f0887aff8e437a1bf7950a",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "required_review_cells": [
    "candidate_identity",
    "sky_support_reuse",
    "nested_mask_path",
    "non_nested_refusal",
    "provenance_binding",
    "transport_composition",
    "covariance_transport",
    "coherence_rank_refusal",
    "covariance_perturbation",
    "depth_scramble_control",
    "obsstat_mio_htt_ownership",
    "model_likelihood_separation",
    "mutation_resistance",
    "claim_ceiling",
    "adjacent_regression",
    "latest_target_integration"
  ],
  "required_commands": [
    {
      "id": "pr266-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr266_depth_path.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr266-adjacent",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr266_depth_path.py",
        "adjacent"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr266-dag-strict",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr266-claim-language",
      "argv": [
        "{python}",
        "-B",
        "scripts/check_claim_language.py",
        "htt/src/common/depth_path.py",
        "htt/obsstat/depth_path.py",
        "htt/mio/formalism/depth_path.py",
        "htt/htt/htt/infer/depth_path.py",
        "tests/contracts/test_depth_path.py",
        "docs/research_program/vector_tensor/pr266_spec.yaml",
        "docs/PR_DELTAS/pr-266.md"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr266-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr266_depth_path.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "support_nesting_rule_changed",
    "transport_or_covariance_rule_changed",
    "ownership_boundary_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "silently pooled incompatible sky supports",
    "MIO coherence report as HTT model prediction",
    "native low-ell solver output",
    "native morphology atlas",
    "PR-151 partial acquisition",
    "global-tilt evidence from coherence alone",
    "Bianchi family label"
  ]
}
