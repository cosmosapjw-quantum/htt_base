{
  "schema_version": 1,
  "policy_id": "PR274-PUBLICATION-POLICY",
  "change_set_id": "CS-PR274-DATA-ADMISSION",
  "publication_group_id": "PG-PR274-DATA-ADMISSION",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "e7c20643c0dd323481f0887aff8e437a1bf7950a",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "claim_ceiling": "diagnostic_only",
  "family_identification_gate": "BLOCKED_PRE_NATIVE_ATLAS",
  "required_commands": [
    {
      "id": "pr274-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr274_data_admission.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr274-generator-check",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/build_pr274_data_admission.py",
        "--check"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "pr274-adjacent",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr274_data_admission.py",
        "adjacent"
      ],
      "timeout_seconds": 1800
    },
    {
      "id": "pr274-dag-strict",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr274-claim-language",
      "argv": [
        "{python}",
        "-B",
        "scripts/check_claim_language.py",
        "htt/src/common/vector_tensor_data_admission.py",
        "htt/obsstat/vector_tensor_data_admission.py",
        "htt/htt/htt/infer/vector_tensor_data_admission.py",
        "tests/contracts/test_vector_tensor_data_admission.py",
        "docs/research_program/vector_tensor/pr274_spec.yaml",
        "docs/PR_DELTAS/pr-274.md"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr274-research-surface-claim-lint",
      "argv": [
        "{python}",
        "-B",
        "scripts/claim_lint_research_surfaces.py"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr274-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr274_data_admission.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "required_review_cells": [
    "candidate_binding",
    "frozen_input_hashes",
    "closed_candidate_schema",
    "source_identity",
    "release_version",
    "license_identity",
    "repository_path_and_hash",
    "mask_selection_identity",
    "covariance_identity",
    "transfer_provenance",
    "required_field_coverage",
    "name_only_refusal",
    "pr151_partial_refusal",
    "separate_execution_authorization",
    "terminal_result",
    "no_data_execution",
    "claim_ceiling",
    "claim_language"
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "candidate_registry_bytes_changed",
    "data_identity_registry_bytes_changed",
    "data_identity_evidence_bytes_changed",
    "source_evidence_bytes_changed",
    "admission_requirement_changed",
    "data_execution_authorization_changed",
    "owner_surface_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "dataset name used as source identity",
    "bare or unregistered source, release, or license identity",
    "PR-151 partial or background acquisition",
    "raw or incomplete input used for a figure",
    "unbound mask, selection, covariance, transfer, or required fields",
    "automatic observed-data execution",
    "native solver or native morphology atlas placeholder",
    "Bianchi family label or identification claim"
  ]
}
