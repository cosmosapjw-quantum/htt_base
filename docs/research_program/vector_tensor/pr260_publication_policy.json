{
  "policy_id": "PR260-PUBLICATION-POLICY",
  "schema_version": 1,
  "change_set_id": "CS-PR260-VECTOR-TENSOR-INTAKE",
  "publication_group_id": "PG-PR260-VECTOR-TENSOR-INTAKE",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "e7c20643c0dd323481f0887aff8e437a1bf7950a",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "required_review_cells": [
    "candidate_identity",
    "source_schema_identity",
    "source_cardinality_and_partition",
    "identifier_disjointness",
    "proof_class_owner_dependency_evidence",
    "cardinality_alias_semantics",
    "pr261_275_dependency_order",
    "canonical_mirror_equivalence",
    "mutation_refusal",
    "claim_ceiling",
    "latest_target_integration"
  ],
  "required_commands": [
    {
      "id": "pr260-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr260_intake.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr260-dag-strict",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr260-mirrors",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/sync_pr_dag_mirrors.py",
        "--check"
      ],
      "timeout_seconds": 180
    },
    {
      "id": "pr260-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr260_intake.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "source_partition_changed"
  ],
  "forbidden_inputs": [
    "proof-status self-promotion",
    "raw-cardinality theorem count",
    "native-solver output",
    "native morphology atlas",
    "observed-data science output",
    "PR-151 partial acquisition"
  ]
}
