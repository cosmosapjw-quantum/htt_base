{
  "policy_id": "PR264-PUBLICATION-POLICY",
  "schema_version": 1,
  "change_set_id": "CS-PR264-TENSOR-XQFG",
  "publication_group_id": "PG-PR264-TENSOR-XQFG",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "e7c20643c0dd323481f0887aff8e437a1bf7950a",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "required_review_cells": [
    "candidate_identity",
    "functional_and_anchor_identity",
    "explicit_scalarization",
    "samplewise_pushforward",
    "q_point_bound_separation",
    "zero_and_missing_support",
    "support_gauge_duality",
    "direction_catalogue_partiality",
    "rotation_and_scaling_covariance",
    "occupancy_eligibility_and_monotonicity",
    "legacy_scalar_reduction",
    "result_mutation",
    "mio_ownership_and_claim_ceiling",
    "adjacent_regression",
    "latest_target_integration"
  ],
  "required_commands": [
    {
      "id": "pr264-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr264_tensor_departure_statistics.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr264-adjacent",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr264_tensor_departure_statistics.py",
        "adjacent"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr264-dag-strict",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr264-claim-language",
      "argv": [
        "{python}",
        "-B",
        "scripts/check_claim_language.py",
        "htt/src/common/tensor_departure_statistics.py",
        "htt/mio/formalism/tensor_departure_statistics.py",
        "tests/contracts/test_tensor_departure_statistics.py",
        "docs/research_program/vector_tensor/pr264_spec.yaml",
        "docs/PR_DELTAS/pr-264.md"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr264-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr264_tensor_departure_statistics.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "scalarization_rule_changed",
    "anchor_or_support_rule_changed",
    "occupancy_eligibility_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "native low-ell solver output",
    "native morphology atlas",
    "observed-data science output",
    "PR-151 partial acquisition",
    "MIO likelihood, posterior, or evidence operation",
    "physical occupancy label",
    "Bianchi family label"
  ]
}
