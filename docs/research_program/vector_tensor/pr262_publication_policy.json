{
  "policy_id": "PR262-PUBLICATION-POLICY",
  "schema_version": 1,
  "change_set_id": "CS-PR262-TENSOR-FUNCTIONALS",
  "publication_group_id": "PG-PR262-TENSOR-FUNCTIONALS",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "e7c20643c0dd323481f0887aff8e437a1bf7950a",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "required_review_cells": [
    "candidate_identity",
    "shared_anchor_authority",
    "value_domain_codomain_separation",
    "typed_missingness",
    "rank_and_support_refusal",
    "anchor_covariance_and_scaling",
    "o3_parity",
    "functional_admissibility",
    "serialization_and_content_identity",
    "mio_ownership_boundary",
    "bool_nan_shape_mutations",
    "claim_ceiling",
    "adjacent_regression",
    "latest_target_integration"
  ],
  "required_commands": [
    {
      "id": "pr262-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr262_tensor_functionals.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr262-adjacent",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr262_tensor_functionals.py",
        "adjacent"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr262-dag-strict",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr262-claim-language",
      "argv": [
        "{python}",
        "-B",
        "scripts/check_claim_language.py",
        "htt/src/common/tensor_functionals.py",
        "htt/mio/formalism/tensor_functionals.py",
        "tests/contracts/test_tensor_functionals.py",
        "docs/research_program/vector_tensor/pr262_spec.yaml",
        "docs/PR_DELTAS/pr-262.md"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr262-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr262_tensor_functionals.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "functional_registry_changed",
    "anchor_authority_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "native low-ell solver output",
    "native morphology atlas",
    "observed-data science output",
    "PR-151 partial acquisition",
    "parallel anchor hierarchy",
    "MIO likelihood, posterior, or evidence operation"
  ]
}
