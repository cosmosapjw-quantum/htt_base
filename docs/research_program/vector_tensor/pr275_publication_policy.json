  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "claim_ceiling": "diagnostic_only",
  "family_identification_gate": "BLOCKED_PRE_NATIVE_ATLAS",
  "required_commands": [
    {
      "id": "pr275-focused",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr275_report.py", "focused"],
      "timeout_seconds": 900
    },
    {
      "id": "pr275-generator-check",
      "argv": ["{python}", "-B", "scripts/vector_tensor/build_pr275_proof_atlas.py", "--check"],
      "timeout_seconds": 300
    },
    {
      "id": "pr275-adjacent",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr275_report.py", "adjacent"],
      "timeout_seconds": 1800
    },
    {
      "id": "pr275-dag-strict",
      "argv": ["{python}", "-B", "scripts/codex_harness/validate_pr_dag.py", "docs/codex_handoff/pr_backlog.yaml", "--status", "docs/codex_handoff/pr_status.yaml", "--strict-rescue-slice"],
      "timeout_seconds": 240
    },
    {
      "id": "pr275-claim-language",
      "argv": ["{python}", "-B", "scripts/check_claim_language.py", "scripts/vector_tensor/build_pr275_proof_atlas.py", "tests/contracts/test_vector_tensor_report.py", "docs/research_program/vector_tensor/pr275_spec.yaml", "docs/research_program/vector_tensor/report/VECTOR_TENSOR_PROGRAM_REPORT.md", "docs/PR_DELTAS/pr-275.md"],
      "timeout_seconds": 240
    },
    {
      "id": "pr275-research-surface-claim-lint",
      "argv": ["{python}", "-B", "scripts/claim_lint_research_surfaces.py"],
      "timeout_seconds": 240
    },
    {
      "id": "pr275-smoke",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr275_report.py", "smoke"],
      "timeout_seconds": 900
    }
  ],
  "required_review_cells": [
    "candidate_binding",
    "frozen_input_hashes",
    "source_obligation_partition",
    "cardinality_alias_semantics",
    "source_status_nonpromotion",
    "evidence_layer_separation",
    "cas_aggregate_scope",
    "inconclusive_and_restricted_rendering",
    "generated_count_determinism",
    "synthetic_case_source_binding",
    "plot_quantity_and_units",
    "plot_category_and_manifest",
    "governance_figure_refusal",
    "data_admission_boundary",
    "no_observed_data_execution",
    "replication_commands_and_environment",
    "seed_and_tolerance_provenance",
    "source_identity_and_hashes",
    "manuscript_number_refusal",
    "claim_ceiling",
    "family_identification_gate",
    "claim_language"
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "theorem_registry_bytes_changed",
    "proof_evidence_bytes_changed",
    "cas_adjudication_bytes_changed",
    "synthetic_pack_bytes_changed",
    "data_admission_result_bytes_changed",
    "generator_or_plot_bytes_changed",
    "report_or_replication_bytes_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "hand-copied proof status or theorem count",
    "evidence-layer verdict used to promote a source obligation",
    "governance or readiness plot used as a scientific result",
    "raw, partial, or unadmitted observed data",
    "native solver or native morphology atlas placeholder",
    "Bianchi family label or identification claim"
  ]
}
