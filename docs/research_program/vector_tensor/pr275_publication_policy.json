{
  "schema_version": 1,
  "policy_id": "PR275-PUBLICATION-POLICY",
  "change_set_id": "CS-PR275-PROOF-ATLAS-REPORT",
  "publication_group_id": "PG-PR275-PROOF-ATLAS-REPORT",
  "target_ref": "origin/research/pr04-multicomponent",
