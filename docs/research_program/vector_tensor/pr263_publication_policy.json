{
  "policy_id": "PR263-PUBLICATION-POLICY",
  "schema_version": 1,
  "change_set_id": "CS-PR263-ORBIT-CATALOGUE-V3",
  "publication_group_id": "PG-PR263-ORBIT-CATALOGUE-V3",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "e7c20643c0dd323481f0887aff8e437a1bf7950a",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "required_review_cells": [
    "candidate_identity",
    "o3_so3_action_composition",
    "scalar_pseudoscalar_parity",
    "shear_strata",
    "stabilizer_boundaries",
    "cyclic_chart_conditioning",
    "chart_overlap",
    "signature_generation_rule",
    "typed_missingness",
    "v2_explicit_channel_replay",
    "spec_state_report_mutation",
    "obsstat_ownership_boundary",
    "unproven_and_claim_ceiling",
    "adjacent_regression",
    "latest_target_integration"
  ],
  "required_commands": [
    {
      "id": "pr263-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr263_orbit_catalogue_v3.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr263-adjacent",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr263_orbit_catalogue_v3.py",
        "adjacent"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr263-dag-strict",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr263-claim-language",
      "argv": [
        "{python}",
        "-B",
        "scripts/check_claim_language.py",
        "htt/src/common/orbit_catalogue_v3.py",
        "htt/obsstat/orbit_catalogue_v3.py",
        "tests/contracts/test_orbit_catalogue_v3.py",
        "docs/research_program/vector_tensor/pr263_spec.yaml",
        "docs/PR_DELTAS/pr-263.md"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr263-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr263_orbit_catalogue_v3.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "orbit_signature_changed",
    "parity_rule_changed",
    "stratum_or_chart_rule_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "native low-ell solver output",
    "native morphology atlas",
    "observed-data science output",
    "PR-151 partial acquisition",
    "nearest-orbit family label",
    "likelihood, posterior, or evidence operation"
  ]
}
