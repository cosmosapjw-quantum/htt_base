{
  "policy_id": "PR261-PUBLICATION-POLICY",
  "schema_version": 1,
  "change_set_id": "CS-PR261-JOINT-ANISOTROPY-STATE",
  "publication_group_id": "PG-PR261-JOINT-ANISOTROPY-STATE",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "e7c20643c0dd323481f0887aff8e437a1bf7950a",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "required_review_cells": [
    "candidate_identity",
    "three_layer_ownership",
    "typed_missingness",
    "units_and_acceleration_normalization",
    "frame_congruence_support_consistency",
    "pr256_payload_replay",
    "legacy_value_and_role_safety",
    "o3_action_and_parity",
    "transfer_provenance",
    "bool_nan_shape_mutations",
    "serialization_and_content_identity",
    "claim_ceiling",
    "adjacent_regression",
    "latest_target_integration"
  ],
  "required_commands": [
    {
      "id": "pr261-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr261_joint_state.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr261-adjacent",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr261_joint_state.py",
        "adjacent"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr261-dag-strict",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr261-claim-language",
      "argv": [
        "{python}",
        "-B",
        "scripts/check_claim_language.py",
        "htt/src/common/joint_anisotropy_state.py",
        "tests/contracts/test_joint_anisotropy_state.py",
        "docs/research_program/vector_tensor/pr261_spec.yaml",
        "docs/PR_DELTAS/pr-261.md"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr261-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr261_joint_state.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "state_schema_changed",
    "legacy_adapter_binding_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "native low-ell solver output",
    "native morphology atlas",
    "observed-data science output",
    "PR-151 partial acquisition",
    "implicit legacy beta semantics",
    "TSC or Teff active ownership"
  ]
}
