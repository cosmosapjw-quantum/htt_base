{
  "policy_id": "PR267-PUBLICATION-POLICY",
  "schema_version": 1,
  "change_set_id": "CS-PR267-ANISOTROPY-TYPE-REPORT",
  "publication_group_id": "PG-PR267-ANISOTROPY-TYPE-REPORT",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "e7c20643c0dd323481f0887aff8e437a1bf7950a",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "claim_ceiling": "diagnostic_only",
  "family_identification_gate": "BLOCKED_PRE_NATIVE_ATLAS",
  "required_review_cells": [
    "candidate_identity",
    "dependency_and_claim_authority",
    "joint_state_and_geometry_missingness",
    "orbit_replay_and_unproven_status",
    "anchored_rank_replay",
    "principal_angle_replay",
    "velocity_frame_replay_adapter",
    "open_set_full_replay",
    "response_class_namespace",
    "conditional_exceedance_binding",
    "depth_coherence_binding",
    "rank_transition",
    "open_set_continuity",
    "local_global_overlap",
    "weak_identification_abstention",
    "partial_report_rendering",
    "mutation_resistance",
    "claim_and_family_ceiling",
    "adjacent_regression",
    "latest_target_integration"
  ],
  "required_commands": [
    {
      "id": "pr267-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr267_anisotropy_type_report.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr267-adjacent",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr267_anisotropy_type_report.py",
        "adjacent"
      ],
      "timeout_seconds": 1200
    },
    {
      "id": "pr267-dag-strict",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr267-claim-language",
      "argv": [
        "{python}",
        "-B",
        "scripts/check_claim_language.py",
        "htt/src/common/anisotropy_type_report.py",
        "htt/htt/htt/infer/anisotropy_type_report.py",
        "tests/contracts/test_anisotropy_type_report.py",
        "docs/research_program/vector_tensor/pr267_spec.yaml",
        "docs/PR_DELTAS/pr-267.md"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr267-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr267_anisotropy_type_report.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "decision_precedence_changed",
    "upstream_replay_contract_changed",
    "response_class_namespace_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "unreplayed mutable upstream report",
    "family-labelled response class",
    "response-class alias outside the exact neutral/local/global vocabulary",
    "native solver or native morphology atlas placeholder",
    "PR-151 partial acquisition",
    "MIO posterior or evidence",
    "nearest-label fallback after abstention"
  ]
}
