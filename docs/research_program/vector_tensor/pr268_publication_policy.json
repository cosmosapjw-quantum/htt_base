{
  "schema_version": 1,
  "policy_id": "PR268-PUBLICATION-POLICY",
  "change_set_id": "CS-PR268-THEOREM-REGISTRY-V3",
  "publication_group_id": "PG-PR268-THEOREM-REGISTRY-V3",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "e7c20643c0dd323481f0887aff8e437a1bf7950a",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "claim_ceiling": "diagnostic_only",
  "family_identification_gate": "BLOCKED_PRE_NATIVE_ATLAS",
  "required_commands": [
    {
      "id": "pr268-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr268_theorem_registry.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr268-adjacent",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr268_theorem_registry.py",
        "adjacent"
      ],
      "timeout_seconds": 1200
    },
    {
      "id": "pr268-dag-strict",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr268-claim-language",
      "argv": [
        "{python}",
        "-B",
        "scripts/check_claim_language.py",
        "htt/src/common/theorem_signatures_v3.py",
        "htt/src/common/tensor_foundations_oracle.py",
        "tests/contracts/test_theorem_signatures_v3.py",
        "docs/research_program/vector_tensor/pr268_spec.yaml",
        "docs/PR_DELTAS/pr-268.md"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr268-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr268_theorem_registry.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "required_review_cells": [
    "frozen_v2_bytes",
    "exact_65_alias",
    "exact_58_alias",
    "true_source_partitions",
    "cross_group_id_disjointness",
    "statement_identity",
    "assumption_missingness",
    "domain_missingness",
    "frame_and_branch_missingness",
    "proof_class",
    "owner_and_dependency",
    "evidence_path",
    "claim_ceiling",
    "no_proof_promotion",
    "oracle_source_copy",
    "oracle_statement_links",
    "oracle_determinism",
    "oracle_mutations",
    "claim_language",
    "latest_target_integration"
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "source_registry_changed",
    "statement_identity_changed",
    "oracle_vector_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "modified theorem-signature v2 source",
    "raw row count used as theorem count",
    "untyped premise inferred from prose",
    "oracle self-report used as proof adjudication",
    "native solver or native morphology atlas placeholder",
    "observed or PR-151 partial data"
  ]
}
