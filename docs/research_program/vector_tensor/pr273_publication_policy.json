{
  "schema_version": 1,
  "policy_id": "PR273-PUBLICATION-POLICY",
  "change_set_id": "CS-PR273-BLIND-SYNTHETIC-INTEGRATION",
  "publication_group_id": "PG-PR273-BLIND-SYNTHETIC-INTEGRATION",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "e7c20643c0dd323481f0887aff8e437a1bf7950a",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "claim_ceiling": "diagnostic_only",
  "family_identification_gate": "BLOCKED_PRE_NATIVE_ATLAS",
  "required_commands": [
    {
      "id": "pr273-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr273_blind_synthetic.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr273-generator-check",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/build_pr273_blind_synthetic.py",
        "--check"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "pr273-adjacent",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr273_blind_synthetic.py",
        "adjacent"
      ],
      "timeout_seconds": 1800
    },
    {
      "id": "pr273-dag-strict",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr273-claim-language",
      "argv": [
        "{python}",
        "-B",
        "scripts/check_claim_language.py",
        "htt/src/common/blind_synthetic_contract.py",
        "htt/htt/htt/infer/vector_tensor_blind_integration.py",
        "tests/integration/test_vector_tensor_blind_synthetic.py",
        "docs/research_program/vector_tensor/pr273_spec.yaml",
        "docs/PR_DELTAS/pr-273.md"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr273-research-surface-claim-lint",
      "argv": [
        "{python}",
        "-B",
        "scripts/claim_lint_research_surfaces.py"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr273-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr273_blind_synthetic.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "required_review_cells": [
    "candidate_binding",
    "preregistration_chronology",
    "frozen_input_hashes",
    "blind_analysis_boundary",
    "held_out_truth_separation",
    "state_functional_orbit_chain",
    "x_q_f_gf_pi_chain",
    "type_report_chain",
    "all_required_case_classes",
    "mutation_kill_matrix",
    "htt_mio_ownership",
    "no_observed_data",
    "claim_ceiling",
    "claim_language"
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "challenge_bytes_changed",
    "truth_vault_bytes_changed",
    "case_membership_changed",
    "mutation_set_changed",
    "depth_alert_threshold_changed",
    "owner_surface_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "truth vault during analysis",
    "sibling reviewer verdicts before independent submission",
    "observed or PR-151 partial data",
    "MIO likelihood, posterior, Bayes factor, or evidence",
    "native solver or native morphology atlas placeholder"
  ]
}
