  "required_commands": [
    {
      "id": "pr269-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr269_pillar_t_core.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr269-adjacent",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr269_pillar_t_core.py",
        "adjacent"
      ],
      "timeout_seconds": 1200
    },
    {
      "id": "pr269-dag-strict",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr269-claim-language",
      "argv": [
        "{python}",
        "-B",
        "scripts/check_claim_language.py",
