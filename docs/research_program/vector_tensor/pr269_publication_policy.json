        "docs/PR_DELTAS/pr-269.md"
      ],
      "timeout_seconds": 240
    },
    {
      "id": "pr269-smoke",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr269_pillar_t_core.py",
        "smoke"
      ],
      "timeout_seconds": 900
    }
  ],
  "required_review_cells": [
    "frozen_input_hashes",
    "exact_vt_selection",
    "exact_tf_selection",
    "exact_legacy_t_inventory",
    "statement_identity",
    "explicit_added_premises",
    "frame_and_branch_conventions",
    "tf12_acceleration_units_and_nonzero_expansion",
    "tf12_gradient_normalization_and_finite_output",
    "domain_boundaries",
    "counterexample_boundaries",
    "analytic_derivation",
    "executable_boundary_vectors",
    "scale_covariant_linear_action",
    "hostile_registry_mutation_refusal",
    "legacy_reference_resolution",
    "untyped_legacy_inconclusive",
    "no_source_status_promotion",
    "no_oracle_status_promotion",
    "no_unnecessary_cas",
    "claim_ceiling",
    "claim_language",
    "latest_target_integration"
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "source_registry_changed",
    "typed_statement_changed",
    "added_premise_changed",
    "counterexample_boundary_changed",
    "proof_registry_bytes_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "modified PR-268 theorem-signature v3 source",
    "source status or oracle self-report used as proof verdict",
    "unrecorded assumption or narrowed domain",
    "unregistered CAS shortcut",
    "native solver or native morphology atlas placeholder",
    "observed or PR-151 partial data"
  ]
