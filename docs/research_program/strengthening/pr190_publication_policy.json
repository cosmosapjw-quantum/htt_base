    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "typed_state_or_orbit_contract_changed",
    "registered_endpoint_changed",
    "frame_or_congruence_changed",
    "matter_model_epoch_or_scale_changed",
    "cas_contract_or_axis_changed",
    "claim_ceiling_changed"
