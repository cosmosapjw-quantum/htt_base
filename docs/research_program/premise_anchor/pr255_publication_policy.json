{
  "schema_version": 1,
  "policy_id": "PR255-PUBLICATION-POLICY",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "required_review_cells": [
    "candidate_identity",
    "changed_public_apis",
    "changed_call_sites",
    "bool_as_int",
    "nan_inf",
    "empty_zero_negative",
    "shape_dtype",
    "duplicate_alias_reuse",
    "mutation_control",
    "property_metamorphic",
    "compatibility",
    "concurrency_replay_state",
    "latest_target_integration"
  ],
  "required_commands": [
    {
      "id": "pr255-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr255_integration.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr255-synthetic-benchmark",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr255_integration.py",
        "benchmark"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr255-direct-fisher-oracle",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr255_response_geometry_oracle.py"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr255-adjacent-contracts",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr255_integration.py",
        "adjacent"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr255-common-contracts",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr255_integration.py",
        "common"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr255-claim-and-history",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr255_integration.py",
        "claim"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "dag-and-status",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 180
    }
  ]
}
