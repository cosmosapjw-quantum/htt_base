{
  "policy_id": "PR257-PUBLICATION-POLICY",
  "schema_version": 1,
  "change_set_id": "CS-PR257-LOWELL-MORPHOLOGY",
  "publication_group_id": "PG-PR257-LOWELL-MORPHOLOGY",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "bbdabec76458d0e66187fbd2631718059f7a7c8d",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "required_review_cells": [
    "candidate_identity",
    "changed_public_apis",
    "changed_call_sites",
    "bool_as_int",
    "nan_inf",
    "empty_zero_negative",
    "shape_dtype",
    "duplicate_alias_reuse",
    "mutation_control",
    "property_metamorphic",
    "compatibility",
    "concurrency_replay_state",
    "latest_target_integration"
  ],
  "required_commands": [
    {
      "id": "pr257-focused",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr257_integration.py",
        "focused"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr257-synthetic-benchmark",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr257_integration.py",
        "benchmark"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr257-independent-oracle",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr257_morphology_oracle.py"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr257-cas-adjudication",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr257_integration.py",
        "cas"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr257-adjacent-contracts",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr257_integration.py",
        "adjacent"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "pr257-claim-and-history",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr257_integration.py",
        "claim"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "dag-and-status",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml",
        "--status",
        "docs/codex_handoff/pr_status.yaml",
        "--strict-rescue-slice"
      ],
      "timeout_seconds": 180
    }
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed"
  ],
  "forbidden_inputs": [
    "PR-151 partial acquisition bytes",
    "old Rust science output",
    "native-solver output",
    "observed Planck, DESI, or CMB product"
  ]
}
