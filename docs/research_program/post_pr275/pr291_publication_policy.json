{
  "schema_version": 1,
  "policy_id": "PR291-PUBLICATION-POLICY",
  "change_set_id": "CS-PR291-CF4-REBOOT",
  "publication_group_id": "PG-PR291-CF4-REBOOT",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "feeb89387d949f41276bec56a6becc08af613214",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "default_publication_mode": "unattended_external_publisher_only",
  "unattended_publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "attended_publication": {
    "enabled": true,
    "authorization_mode": "attended_explicit_user",
    "transaction": "sealed_sha_push_then_single_pr_create",
    "max_transactions": 1,
    "requires_current_turn_authorization": true,
    "direct_mutation_commands_forbidden": true,
    "nonce_ledger_binding": "authorization_hmac_frozen_external_inode_v1",
    "publisher_entrypoint": ".agent-harness/scripts/attended_pr_publisher.py",
    "forbidden_actions": ["force_push", "approve", "merge", "ruleset_mutation"]
  },
  "claim_ceiling": "diagnostic_only",
  "family_identification_gate": "BLOCKED_PRE_NATIVE_ATLAS",
  "required_commands": [
    {
      "id": "pr291-focused",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr291_cf4_lane.py", "focused"],
      "timeout_seconds": 1800
    },
    {
      "id": "pr291-preactivation",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr291_cf4_lane.py", "check"],
      "timeout_seconds": 600
    },
    {
      "id": "pr291-adjacent",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr291_cf4_lane.py", "adjacent"],
      "timeout_seconds": 1800
    },
    {
      "id": "pr291-portable-clean",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr291_cf4_lane.py", "portable"],
      "timeout_seconds": 1800
    },
    {
      "id": "pr291-policy-cross-binding",
      "argv": [
        "{python}", "-B", "-m", "pytest", "-p", "no:cacheprovider", "-q",
        "scripts/codex_harness/test_publication_integrity.py", "-k",
        "policy_nonrelaxable_metadata_fails_closed or candidate_seal_cross_binds_declared_policy_identity"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "pr291-dag-strict",
      "argv": [
        "{python}", "-B", "scripts/codex_harness/validate_pr_dag.py",
        "docs/codex_handoff/pr_backlog.yaml", "--status",
        "docs/codex_handoff/pr_status.yaml", "--strict-rescue-slice"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "pr291-claim-language",
      "argv": [
        "{python}", "-B", "scripts/check_claim_language.py", "--strict-missing",
        "--include-archives", "docs/research_program/post_pr275/pr291_spec.yaml",
        "htt/src/common/cf4_observed_lane_activation.py",
        "htt/obsstat/cf4_post275_lane.py",
        "tests/integration/test_cf4_post275_lane.py",
        "docs/research_program/post_pr275/data_runs/cf4/PR291_NONEXECUTION_RECEIPT.json",
        "docs/PR_DELTAS/pr-291.md"
      ],
      "timeout_seconds": 300
    }
  ],
  "required_review_cells": [
    "candidate_identity",
    "spec_before_execution",
    "dependency_terminal_replay",
    "data_identity_and_human_authorization_separation",
    "preflight_before_first_write",
    "synthetic_estimand_identity",
    "group_row_selection_and_frame_conventions",
    "full_covariance_and_effective_rank",
    "depth_zoa_nested_support_and_transport",
    "weak_identification_and_identified_set_abstention",
    "legacy_p0_and_curl_disposition",
    "blocked_no_numeric_output",
    "portable_clean_integration",
    "publication_policy_cross_binding",
    "claim_and_family_ceiling",
    "latest_target_integration"
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "spec_bytes_changed",
    "dependency_or_admission_receipt_changed",
    "human_gate_status_changed",
    "catalogue_selection_covariance_or_estimand_identity_changed",
    "terminal_mapping_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "ordinary-agent H-CF4 authorization",
    "unadmitted CF4 catalogue",
    "catalogue label without exact grouped rows selection and covariance",
    "synthetic fixture labelled observed",
    "diagonal covariance shortcut",
    "favourable identified-set endpoint as point estimate",
    "retired P0 or velocity-shape headline",
    "0.0089 curl diagnostic labelled physical vorticity",
    "native solver or transfer validation",
    "anisotropy or family identification"
  ]
}
