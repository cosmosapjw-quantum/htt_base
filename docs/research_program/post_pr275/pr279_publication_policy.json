  "claim_ceiling": "diagnostic_only",
  "family_identification_gate": "BLOCKED_PRE_NATIVE_ATLAS",
  "required_commands": [
    {"id": "pr279-source-check", "argv": ["{python}", "-B", "scripts/codex_harness/run_pr279_reverse_trace.py", "check"], "timeout_seconds": 600},
    {"id": "pr279-focused", "argv": ["{python}", "-B", "scripts/codex_harness/run_pr279_reverse_trace.py", "focused"], "timeout_seconds": 1200},
    {"id": "pr279-dag", "argv": ["{python}", "-B", "scripts/codex_harness/validate_pr_dag.py", "docs/codex_handoff/pr_backlog.yaml", "--status", "docs/codex_handoff/pr_status.yaml", "--strict-rescue-slice"], "timeout_seconds": 300},
    {"id": "pr279-mirror-check", "argv": ["{python}", "-B", "scripts/codex_harness/sync_pr_dag_mirrors.py", "--check"], "timeout_seconds": 300},
    {"id": "pr279-collect", "argv": ["{python}", "-B", "scripts/codex_harness/run_pr279_reverse_trace.py", "collect"], "timeout_seconds": 1800},
    {"id": "pr279-smoke", "argv": ["{python}", "-B", "scripts/codex_harness/run_pr279_reverse_trace.py", "smoke"], "timeout_seconds": 1200},
    {"id": "pr279-claim-language", "argv": ["{python}", "-B", "scripts/check_claim_language.py"], "timeout_seconds": 300},
    {"id": "pr279-research-surface-claim-lint", "argv": ["{python}", "-B", "scripts/claim_lint_research_surfaces.py"], "timeout_seconds": 300}
