{
  "schema_version": 1,
  "policy_id": "PR278-PUBLICATION-POLICY-V2",
  "change_set_id": "CS-PR278-TIER-A-ADJUDICATION",
  "publication_group_id": "PG-PR278-TIER-A-ADJUDICATION",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "a7800430660c5a4bd532d8655fc63df03b21496e",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "default_publication_mode": "unattended_external_publisher_only",
  "unattended_publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "attended_publication": {
    "enabled": true,
    "authorization_mode": "attended_explicit_user",
    "transaction": "sealed_sha_push_then_single_pr_create",
    "max_transactions": 1,
    "requires_current_turn_authorization": true,
    "direct_mutation_commands_forbidden": true,
    "nonce_ledger_binding": "authorization_hmac_frozen_external_inode_v1",
    "publisher_entrypoint": ".agent-harness/scripts/attended_pr_publisher.py",
    "forbidden_actions": [
      "force_push",
      "approve",
      "merge",
      "ruleset_mutation"
    ]
  },
  "claim_ceiling": "diagnostic_only",
  "family_identification_gate": "BLOCKED_PRE_NATIVE_ATLAS",
  "required_commands": [
    {
      "id": "pr278-source-layout-probe",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr278_tier_a_adjudication.py", "probe"],
      "timeout_seconds": 300
    },
    {
      "id": "pr278-frozen-source",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr278_tier_a_adjudication.py", "verify-frozen-source"],
      "timeout_seconds": 300
    },
    {
      "id": "pr278-source-regeneration",
      "argv": [
        "{python}",
        "-B",
        "scripts/codex_harness/run_pr278_tier_a_adjudication.py",
        "check-source"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "pr278-panel-receipt",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr278_tier_a_adjudication.py", "verify-panel"],
      "timeout_seconds": 300
    },
    {
      "id": "pr278-final-ledger",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr278_tier_a_adjudication.py", "verify-ledger"],
      "timeout_seconds": 300
    },
    {
      "id": "pr278-targeted",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr278_tier_a_adjudication.py", "focused"],
      "timeout_seconds": 1200
    },
    {
      "id": "pr278-dag",
      "argv": ["{python}", "-B", "scripts/codex_harness/validate_pr_dag.py", "docs/codex_handoff/pr_backlog.yaml", "--status", "docs/codex_handoff/pr_status.yaml", "--strict-rescue-slice"],
      "timeout_seconds": 300
    },
    {
      "id": "pr278-mirror-check",
      "argv": ["{python}", "-B", "scripts/codex_harness/sync_pr_dag_mirrors.py", "--check"],
      "timeout_seconds": 300
    },
    {
      "id": "pr278-collect",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr278_tier_a_adjudication.py", "collect"],
      "timeout_seconds": 1800
    },
    {
      "id": "pr278-smoke",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr278_tier_a_adjudication.py", "smoke"],
      "timeout_seconds": 1200
    },
    {
      "id": "pr278-claim-language",
      "argv": ["{python}", "-B", "scripts/check_claim_language.py"],
      "timeout_seconds": 300
    },
    {
      "id": "pr278-research-surface-claim-lint",
      "argv": ["{python}", "-B", "scripts/claim_lint_research_surfaces.py"],
      "timeout_seconds": 300
    }
  ],
  "required_review_cells": [
    "candidate_binding",
    "source_ledger_identity",
    "tracked_panel_receipt",
    "panel_failures_preserved",
    "twenty_family_eligibility",
    "eight_event_gates",
    "sixty_two_row_totality",
    "terminal_receipt_binding",
    "non_author_independence",
    "per_lane_verdict",
    "evidence_fingerprint",
    "dissent_and_ceiling",
    "no_bulk_promotion",
    "cf4_p0_zero_rescue",
    "pr157_aggregator_boundary",
    "capability_non_issuance",
    "portable_source_layout",
    "owner_role_firewalls",
    "native_family_gate",
    "claim_ceiling",
    "claim_language"
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "source_ledger_hash_changed",
    "panel_receipt_hash_changed",
    "final_ledger_hash_changed",
    "family_partition_changed",
    "event_gate_changed",
    "verdict_or_crosswalk_semantics_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "author self-approval",
    "family-level bulk verdict copied to claim rows",
    "missing or drifted terminal receipt",
    "completed status used as a capability grant",
    "event-gated family promoted before its event",
    "CF4 P0 rescue",
    "native solver or native morphology atlas placeholder",
    "MIO posterior or evidence semantics",
    "Bianchi family identification claim"
  ]
}
