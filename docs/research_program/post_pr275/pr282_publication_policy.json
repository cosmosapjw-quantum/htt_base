{
  "schema_version": 1,
  "policy_id": "PR282-PUBLICATION-POLICY",
  "change_set_id": "CS-PR282-EXACT-PARITY",
  "publication_group_id": "PG-PR282-EXACT-PARITY",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "feeb89387d949f41276bec56a6becc08af613214",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "default_publication_mode": "unattended_external_publisher_only",
  "unattended_publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "attended_publication": {
    "enabled": true,
    "authorization_mode": "attended_explicit_user",
    "transaction": "sealed_sha_push_then_single_pr_create",
    "max_transactions": 1,
    "requires_current_turn_authorization": true,
    "direct_mutation_commands_forbidden": true,
    "nonce_ledger_binding": "authorization_hmac_frozen_external_inode_v1",
    "publisher_entrypoint": ".agent-harness/scripts/attended_pr_publisher.py",
    "forbidden_actions": [
      "force_push",
      "approve",
      "merge",
      "ruleset_mutation"
    ]
  },
  "claim_ceiling": "diagnostic_only",
  "family_identification_gate": "BLOCKED_PRE_NATIVE_ATLAS",
  "required_commands": [
    {
      "id": "pr282-focused",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr282_exact_parity_readiness.py", "focused"],
      "timeout_seconds": 900
    },
    {
      "id": "pr282-adjacent",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr282_exact_parity_readiness.py", "adjacent"],
      "timeout_seconds": 1200
    },
    {
      "id": "pr282-receipt-replay",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr282_exact_parity_readiness.py", "check"],
      "timeout_seconds": 300
    },
    {
      "id": "pr282-publication-policy-cross-binding",
      "argv": ["{python}", "-B", "-m", "pytest", "-p", "no:cacheprovider", "-q", "scripts/codex_harness/test_publication_integrity.py", "-k", "policy_nonrelaxable_metadata_fails_closed or candidate_seal_cross_binds_declared_policy_identity"],
      "timeout_seconds": 300
    },
    {
      "id": "pr282-dag-strict",
      "argv": ["{python}", "-B", "scripts/codex_harness/validate_pr_dag.py", "docs/codex_handoff/pr_backlog.yaml", "--status", "docs/codex_handoff/pr_status.yaml", "--strict-rescue-slice"],
      "timeout_seconds": 300
    },
    {
      "id": "pr282-claim-language",
      "argv": ["{python}", "-B", "scripts/check_claim_language.py", "--strict-missing", "htt/obsstat/exact_parity_readiness.py", "tests/obsstat/test_exact_parity_readiness.py", "docs/research_program/post_pr275/pr282_spec.yaml", "docs/PR_DELTAS/pr-282.md"],
      "timeout_seconds": 300
    }
  ],
  "required_review_cells": [
    "candidate_identity",
    "spec_before_execution",
    "exact_reflection_involution",
    "estimator_anti_equivariance",
    "mask_equivariance_execution",
    "weighting_equivariance_execution",
    "no_caller_readiness",
    "no_posthoc_threshold",
    "registered_mutation_completeness",
    "dependent_evalue_arithmetic_merge",
    "receipt_recomputation_and_content_address",
    "publication_policy_cross_binding",
    "h1_h2_h3_separation",
    "claim_and_family_ceiling",
    "portable_clean_integration",
    "latest_target_integration"
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "spec_bytes_changed",
    "reflection_or_support_action_changed",
    "estimator_mask_or_weighting_changed",
    "mutation_registry_changed",
    "receipt_schema_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "native low-ell solver output",
    "native morphology atlas",
    "observed-sky science output",
    "PR-151 partial acquisition",
    "caller-supplied readiness boolean",
    "post-result tolerance change",
    "binomial pooling of dependent signs",
    "geometry or family label"
  ]
}
