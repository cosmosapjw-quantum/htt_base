{
  "schema_version": 1,
  "policy_id": "PR280-PUBLICATION-POLICY",
  "change_set_id": "CS-PR280-HERMETIC-HARNESS-V4",
  "publication_group_id": "PG-PR280-HERMETIC-HARNESS-V4",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "315277077e27e8493342f5b219da152197bad059",
  "max_open_prs": 1,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 1,
  "max_file_overlap_prs": 0,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "default_publication_mode": "unattended_external_publisher_only",
  "unattended_publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "attended_publication": {
    "enabled": true,
    "authorization_mode": "attended_explicit_user",
    "transaction": "sealed_sha_push_then_single_pr_create",
    "max_transactions": 1,
    "requires_current_turn_authorization": true,
    "direct_mutation_commands_forbidden": true,
    "nonce_ledger_binding": "authorization_hmac_frozen_external_inode_v1",
    "publisher_entrypoint": ".agent-harness/scripts/attended_pr_publisher.py",
    "forbidden_actions": ["force_push", "approve", "merge", "ruleset_mutation"]
  },
  "claim_ceiling": "diagnostic_only",
  "family_identification_gate": "BLOCKED_PRE_NATIVE_ATLAS",
  "required_commands": [
    {"id": "pr280-manifest-check", "argv": ["{python}", "-B", "scripts/codex_harness/run_pr280_harness.py", "check"], "timeout_seconds": 600},
    {"id": "pr280-focused", "argv": ["{python}", "-B", "scripts/codex_harness/run_pr280_harness.py", "focused"], "timeout_seconds": 1800},
    {"id": "pr280-package", "argv": ["{python}", "-B", "scripts/codex_harness/run_pr280_harness.py", "package"], "timeout_seconds": 1800},
    {"id": "pr280-inventory-structure-check", "argv": ["{python}", "-B", "scripts/codex_harness/run_pr280_harness.py", "inventory-structure-check"], "timeout_seconds": 600},
    {"id": "pr280-dag", "argv": ["{python}", "-B", "scripts/codex_harness/validate_pr_dag.py", "docs/codex_handoff/pr_backlog.yaml", "--status", "docs/codex_handoff/pr_status.yaml", "--strict-rescue-slice"], "timeout_seconds": 300},
    {"id": "pr280-mirrors", "argv": ["{python}", "-B", "scripts/codex_harness/sync_pr_dag_mirrors.py", "--check"], "timeout_seconds": 300},
    {"id": "pr280-claim-language", "argv": ["{python}", "-B", "scripts/check_claim_language.py"], "timeout_seconds": 300},
    {"id": "pr280-claim-surface", "argv": ["{python}", "-B", "scripts/claim_lint_research_surfaces.py"], "timeout_seconds": 300}
  ],
  "required_review_cells": [
    "candidate_binding",
    "profile_manifest_schema",
    "explicit_smoke_and_fast_paths",
    "active_import_provenance",
    "root_addopts_cleared",
    "cache_provider_disabled",
    "full_inventory_junit_identity",
    "ten_bucket_totality",
    "unknown_zero",
    "active_core_zero_or_receipt_bound_root_cause_successor",
    "optional_grade_isolation",
    "data_execution_boundary",
    "formal_axis_isolation",
    "receipt_derived_smoke_status",
    "publication_waiver_ban",
    "pr124_resource_portability",
    "pr124_present_drift_fail_closed",
    "historical_receipt_preservation",
    "changed_surface_local_only",
    "g_ci_h_non_authorization",
    "claim_ceiling",
    "family_identification_gate",
    "claim_language"
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "profile_manifest_changed",
    "failure_rule_or_bucket_changed",
    "execution_receipt_changed",
    "junit_or_classification_identity_changed",
    "package_resource_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "cached pytest outcome",
    "marker-only smoke or fast selection",
    "caller-supplied smoke readiness",
    "unregistered failure bucket",
    "unknown failure hidden by fallback classification",
    "broad-suite publication waiver",
    "mutated historical PR-124 receipt",
    "missing formal axis counted as pass",
    "unadmitted data execution",
    "native solver or morphology atlas placeholder",
    "MIO posterior or evidence semantics",
    "Bianchi family identification claim"
  ]
}
