{
  "schema_version": 1,
  "policy_id": "PR283-PUBLICATION-POLICY",
  "change_set_id": "CS-PR283-WEAK-IDENTIFICATION",
  "publication_group_id": "PG-PR283-WEAK-IDENTIFICATION",
  "target_ref": "origin/research/pr04-multicomponent",
  "target_sha": "ff9ef9f45747e559c5343b463cf010dfc3a7432a",
  "max_open_prs": 10,
  "max_direct_to_target_prs": 1,
  "max_prs_per_change_set": 1,
  "max_stack_depth": 10,
  "max_file_overlap_prs": 9,
  "max_inventory_age_seconds": 300,
  "max_receipt_age_seconds": 1800,
  "max_authorization_ttl_seconds": 1800,
  "default_publication_mode": "unattended_external_publisher_only",
  "unattended_publication_requires_external_publisher": true,
  "ordinary_agent_push_forbidden": true,
  "ordinary_agent_pr_mutation_forbidden": true,
  "attended_publication": {
    "enabled": true,
    "authorization_mode": "attended_explicit_user",
    "transaction": "sealed_sha_push_then_single_pr_create",
    "max_transactions": 1,
    "requires_current_turn_authorization": true,
    "direct_mutation_commands_forbidden": true,
    "nonce_ledger_binding": "authorization_hmac_frozen_external_inode_v1",
    "publisher_entrypoint": ".agent-harness/scripts/attended_pr_publisher.py",
    "forbidden_actions": [
      "force_push",
      "approve",
      "merge",
      "ruleset_mutation"
    ]
  },
  "claim_ceiling": "diagnostic_only",
  "family_identification_gate": "BLOCKED_PRE_NATIVE_ATLAS",
  "required_commands": [
    {
      "id": "pr283-process-recovery-bootstrap",
      "argv": ["{python}", "-B", "-m", "pytest", "-p", "no:cacheprovider", "-q", "tests/contracts/test_process_recovery_auto_stacked.py"],
      "timeout_seconds": 300
    },
    {
      "id": "pr283-focused",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr283_weak_identification.py", "focused"],
      "timeout_seconds": 900
    },
    {
      "id": "pr283-adjacent",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr283_weak_identification.py", "adjacent"],
      "timeout_seconds": 1200
    },
    {
      "id": "pr283-receipt-replay",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr283_weak_identification.py", "check"],
      "timeout_seconds": 300
    },
    {
      "id": "pr283-pr272-predecessor-replay",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr282_exact_parity_readiness.py", "pr272"],
      "timeout_seconds": 600
    },
    {
      "id": "pr283-portable-clean-replay",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr283_weak_identification.py", "portable"],
      "timeout_seconds": 1200
    },
    {
      "id": "pr283-publication-policy-cross-binding",
      "argv": ["{python}", "-B", "-m", "pytest", "-p", "no:cacheprovider", "-q", "scripts/codex_harness/test_publication_integrity.py", "-k", "policy_nonrelaxable_metadata_fails_closed or candidate_seal_cross_binds_declared_policy_identity"],
      "timeout_seconds": 300
    },
    {
      "id": "pr283-source-replay-caller-migrations",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr283_weak_identification.py", "caller-migrations"],
      "timeout_seconds": 1200
    },
    {
      "id": "pr283-harness-portability",
      "argv": ["{python}", "-B", "scripts/codex_harness/run_pr283_weak_identification.py", "harness-portability"],
      "timeout_seconds": 1200
    },
    {
      "id": "pr283-dag-strict",
      "argv": ["{python}", "-B", "scripts/codex_harness/validate_pr_dag.py", "docs/codex_handoff/pr_backlog.yaml", "--status", "docs/codex_handoff/pr_status.yaml", "--strict", "--work-unit", "PR-283", "--candidate-ref", "HEAD"],
      "timeout_seconds": 300
    },
    {
      "id": "pr283-claim-language",
      "argv": ["{python}", "-B", "scripts/check_claim_language.py", "--strict-missing", "htt/src/common/source_separation.py", "htt/src/common/open_set_response_classes.py", "htt/src/common/vector_tensor_statistical_inference.py", "htt/htt/htt/statistics/open_set_response_classes.py", "tests/contracts/test_weak_identification.py", "tests/contracts/test_pillar_s_inference.py", "docs/research_program/vector_tensor/integration/PR283_PR272_OPEN_SET_V1_RELOCATION.json", "docs/research_program/post_pr275/pr283_spec.yaml", "docs/generated/pr283_weak_identification_receipt.json", "docs/PR_DELTAS/pr-283.md"],
      "timeout_seconds": 300
    }
  ],
  "required_review_cells": [
    "candidate_identity",
    "spec_before_execution",
    "covariance_supported_rank_ladder",
    "full_rank_small_angle_status",
    "full_rank_small_singular_value_status",
    "rank_deficiency_distinct_from_weak_identification",
    "threshold_contract_identity",
    "exact_source_geometry_report_replay",
    "exact_normalizer_spec_binding",
    "mandatory_threshold_contract_enforcement",
    "all_source_gate_callers_migrated",
    "principal_angle_and_singular_value_identity",
    "mandatory_open_set_abstention",
    "no_point_estimate_or_nearest_fallback",
    "registered_mutation_completeness",
    "receipt_recomputation_and_content_address",
    "pr272_predecessor_replay_preservation",
    "publication_policy_cross_binding",
    "claim_and_family_ceiling",
    "portable_clean_integration",
    "serial_stack_bootstrap_integrity",
    "latest_target_integration"
  ],
  "invalidates_review": [
    "candidate_sha_changed",
    "candidate_tree_changed",
    "diff_digest_changed",
    "tests_changed",
    "target_sha_changed",
    "spec_bytes_changed",
    "rank_angle_or_singular_contract_changed",
    "threshold_contract_changed",
    "source_gate_or_classifier_changed",
    "mutation_registry_changed",
    "receipt_schema_changed",
    "claim_ceiling_changed"
  ],
  "forbidden_inputs": [
    "native low-ell solver output",
    "native morphology atlas",
    "observed-sky science output",
    "PR-151 partial acquisition",
    "caller-supplied readiness or candidate label",
    "post-result threshold change",
    "weak-identification point estimate",
    "geometry or family label"
  ]
}
