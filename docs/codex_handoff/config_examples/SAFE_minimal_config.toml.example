# Optional only. Do not install unless your Codex version accepts these keys.
# The handoff package works without this file.

# project_doc_max_bytes is a project-instruction discovery knob in some Codex versions.
# Keep it outside `[agents]` if used.
# project_doc_max_bytes = 32768
# project_doc_fallback_filenames = ["agent.md"]

# Some Codex versions support global subagent settings here; others do not.
# If your Codex throws AgentRoleToml errors, remove this table.
# [agents]
# max_threads = 6
# max_depth = 1
# job_max_runtime_seconds = 1800
