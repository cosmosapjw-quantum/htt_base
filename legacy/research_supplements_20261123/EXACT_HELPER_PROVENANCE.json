    "source_sha256": "ce27f01c495d9e23927bad2262b1313b5ab7adb85cb56380d2f768eec2dc6b28",
    "source": "def _angular_sep(l1, b1, l2, b2):\n    d1, d2 = _unit_vec(l1, b1), _unit_vec(l2, b2)\n    return np.arccos(np.clip(np.dot(d1, d2), -1, 1))",
