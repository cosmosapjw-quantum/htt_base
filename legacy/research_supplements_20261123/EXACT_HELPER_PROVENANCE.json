    "source_sha256": "50bb2951bd65a40e73fe19b5ef81e1d5be1993c4ea3e9edb93ab4856b7b449c5",
    "source": "def _unit_vec(l_deg, b_deg):\n    l, b = np.radians(l_deg), np.radians(b_deg)\n    return np.array([np.cos(b)*np.cos(l), np.cos(b)*np.sin(l), np.sin(b)])",
