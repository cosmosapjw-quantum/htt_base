# ─────────────────────────────────────────────────────────────────────
#  Rust / Cargo
# ─────────────────────────────────────────────────────────────────────
/target/
**/target/
**/*.rs.bk
*.pdb

# Cargo.lock IS committed (library produces a cdylib binary artifact).
# Do not ignore it.

# Rust incremental / coverage
**/*.profraw
**/*.gcda
**/*.gcno
/coverage/
/lcov.info
/tarpaulin-report.html

# ─────────────────────────────────────────────────────────────────────
#  Python (future integration — bass_rs cdylib + Python wrappers)
# ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
.python-version

# Packaging / build artefacts
build/
dist/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/
.eggs/

# maturin / PyO3 (bass_rs is a pyo3 cdylib)
# Built .so / .pyd land in target/ already, but maturin develop may also
# drop them into the source tree:
*.so
*.pyd
*.dylib
*.dll
# Exception: committed reference artifacts (rare — uncomment if needed)
# !reference/*.so

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# pytest / mypy / ruff / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# ─────────────────────────────────────────────────────────────────────
#  Profiling / benchmarking artefacts
# ─────────────────────────────────────────────────────────────────────
# perf
perf.data
perf.data.old
perf.data.*

# flamegraph / samply
flamegraph.svg
flamegraph.html
*.perf-folded
profile.json
profile.json.gz

# valgrind / callgrind / cachegrind / massif / heaptrack / dhat
callgrind.out.*
cachegrind.out.*
massif.out.*
heaptrack.*.gz
heaptrack.*.zst
dhat-heap.json
dhat-*.json

# pprof (Rust pprof crate)
*.pb
*.pb.gz
pprof.*.pb

# criterion / iai-callgrind output
/criterion/
/target/criterion/
iai-callgrind.*.out

# hyperfine exports
hyperfine-*.json
hyperfine-*.csv
hyperfine-*.md

# cargo-pgo / LLVM PGO
/pgo-data/
*.profdata

# ─────────────────────────────────────────────────────────────────────
#  Scientific run outputs (keep repo lean — outputs regenerable)
# ─────────────────────────────────────────────────────────────────────
# Large generated spectra / chains / MCMC — adjust if specific files
# must be kept under version control.
/logs/*.log
/logs/*.csv.gz
/logs/run-*/
/tests_log/*.tmp
/plots/*.tmp.png
*.npy.tmp
*.h5.tmp
*.fits.tmp

/workdir
/perf_runs
/project
/session_artifacts
/session_notes

# Intermediate cache files (CAMB / CLASS style)
*.cachegrind
*.cl_cache
*.bg_cache

# Local LaTeX build byproducts. The repo tracks the final manuscript PDF and
# manifest under docs/generated/manuscript_pdf/, not latexmk scratch files.
/docs/generated/manuscript_pdf/*.aux
/docs/generated/manuscript_pdf/*.bbl
/docs/generated/manuscript_pdf/*.blg
/docs/generated/manuscript_pdf/*.fdb_latexmk
/docs/generated/manuscript_pdf/*.fls
/docs/generated/manuscript_pdf/*.log
/docs/generated/manuscript_pdf/*.out
/docs/generated/manuscript_pdf/*.toc
/docs/manuscript/*.aux
/docs/manuscript/*.bbl
/docs/manuscript/*.blg
/docs/manuscript/*.fdb_latexmk
/docs/manuscript/*.fls
/docs/manuscript/*.log
/docs/manuscript/*.out
/docs/manuscript/*.toc
/docs/manuscript/main.pdf
# Final-results report: track main.tex + main.pdf (it is the deliverable), drop
# latexmk scratch and the transient claim-lint check file.
/docs/final_report/*.aux
/docs/final_report/*.bbl
/docs/final_report/*.blg
/docs/final_report/*.fdb_latexmk
/docs/final_report/*.fls
/docs/final_report/*.log
/docs/final_report/*.out
/docs/final_report/*.toc
/docs/final_report/.claim_lint_check.md

# External audit/revision input drops are preserved locally but are not source
# artifacts. Curated outputs live under docs/generated/ and docs/audits/.
/AUDIT_REPORT.md
/RESEARCH_AUDIT_REPORT.md
/HTT_Bianchi_VER*_external_audit.zip
/HTT_Bianchi_revision_program.zip
/egs_theorem_program.zip
/external_audit_package_adversarial_audit_*.zip
/htt_beyond_mes_egs_theorem_program_*.zip

# Prior-version reference archive (VER04 / IS-22): large binary zips + PDF kept
# locally for reference. Surveyed in docs/OLD_VERSION_ARCHIVE_SURVEY.md.
/old_version/
/htt_publishable_novel_analysis_program_*.zip
/htt_revision_upgrade_package_*.zip
/publishable_data_analysis_program.zip
/codex_handoff_htt_presolver_v4_config_hotfix_*/
/codex_handoff_htt_presolver_v4_config_hotfix_*.zip
/codex_handoff_htt_presolver_v3_skillset_augmented_2026-06-11/.codex/

