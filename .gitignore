# ─────────────────────────────────────────────────────────────────────
#  Rust / Cargo
# ─────────────────────────────────────────────────────────────────────
/target/
**/target/
**/*.rs.bk
*.pdb

# Cargo.lock IS committed (library produces a cdylib binary artifact).
# Do not ignore it.

# Rust incremental / coverage
**/*.profraw
**/*.gcda
**/*.gcno
/coverage/
/lcov.info
/tarpaulin-report.html

# ─────────────────────────────────────────────────────────────────────
#  Python (future integration — bass_rs cdylib + Python wrappers)
# ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
.python-version

# Packaging / build artefacts
build/
dist/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/
.eggs/

# maturin / PyO3 (bass_rs is a pyo3 cdylib)
# Built .so / .pyd land in target/ already, but maturin develop may also
# drop them into the source tree:
*.so
*.pyd
*.dylib
*.dll
# Exception: committed reference artifacts (rare — uncomment if needed)
# !reference/*.so

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# pytest / mypy / ruff / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.hypothesis/

