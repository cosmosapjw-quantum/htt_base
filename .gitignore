/docs/final_report/*.aux
/docs/final_report/*.bbl
/docs/final_report/*.blg
/docs/final_report/*.fdb_latexmk
/docs/final_report/*.fls
/docs/final_report/*.log
/docs/final_report/*.out
/docs/final_report/*.toc
/docs/final_report/.claim_lint_check.md

