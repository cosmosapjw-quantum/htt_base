{"url":"https://api.github.com/repos/jgm/pandoc/releases/107607666","assets_url":"https://api.github.com/repos/jgm/pandoc/releases/107607666/assets","upload_url":"https://uploads.github.com/repos/jgm/pandoc/releases/107607666/assets{?name,label}","html_url":"https://github.com/jgm/pandoc/releases/tag/3.1.3","id":107607666,"author":{"login":"jgm","id":3044,"node_id":"MDQ6VXNlcjMwNDQ=","avatar_url":"https://avatars.githubusercontent.com/u/3044?v=4","gravatar_id":"","url":"https://api.github.com/users/jgm","html_url":"https://github.com/jgm","followers_url":"https://api.github.com/users/jgm/followers","following_url":"https://api.github.com/users/jgm/following{/other_user}","gists_url":"https://api.github.com/users/jgm/gists{/gist_id}","starred_url":"https://api.github.com/users/jgm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jgm/subscriptions","organizations_url":"https://api.github.com/users/jgm/orgs","repos_url":"https://api.github.com/users/jgm/repos","events_url":"https://api.github.com/users/jgm/events{/privacy}","received_events_url":"https://api.github.com/users/jgm/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"RE_kwDOAAi5es4GafZy","tag_name":"3.1.3","target_commitish":"main","name":"pandoc 3.1.3","draft":false,"immutable":false,"prerelease":false,"created_at":"2023-06-07T01:02:46Z","updated_at":"2023-06-07T04:42:05Z","published_at":"2023-06-07T04:42:05Z","assets":[{"url":"https://api.github.com/repos/jgm/pandoc/releases/assets/111630302","id":111630302,"node_id":"RA_kwDOAAi5es4Gp1fe","name":"pandoc-3.1.3-1-amd64.deb","label":null,"uploader":{"login":"jgm","id":3044,"node_id":"MDQ6VXNlcjMwNDQ=","avatar_url":"https://avatars.githubusercontent.com/u/3044?v=4","gravatar_id":"","url":"https://api.github.com/users/jgm","html_url":"https://github.com/jgm","followers_url":"https://api.github.com/users/jgm/followers","following_url":"https://api.github.com/users/jgm/following{/other_user}","gists_url":"https://api.github.com/users/jgm/gists{/gist_id}","starred_url":"https://api.github.com/users/jgm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jgm/subscriptions","organizations_url":"https://api.github.com/users/jgm/orgs","repos_url":"https://api.github.com/users/jgm/repos","events_url":"https://api.github.com/users/jgm/events{/privacy}","received_events_url":"https://api.github.com/users/jgm/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":28247732,"digest":null,"download_count":45204,"created_at":"2023-06-07T04:35:46Z","updated_at":"2023-06-07T04:36:13Z","browser_download_url":"https://github.com/jgm/pandoc/releases/download/3.1.3/pandoc-3.1.3-1-amd64.deb"},{"url":"https://api.github.com/repos/jgm/pandoc/releases/assets/111630331","id":111630331,"node_id":"RA_kwDOAAi5es4Gp1f7","name":"pandoc-3.1.3-1-arm64.deb","label":null,"uploader":{"login":"jgm","id":3044,"node_id":"MDQ6VXNlcjMwNDQ=","avatar_url":"https://avatars.githubusercontent.com/u/3044?v=4","gravatar_id":"","url":"https://api.github.com/users/jgm","html_url":"https://github.com/jgm","followers_url":"https://api.github.com/users/jgm/followers","following_url":"https://api.github.com/users/jgm/following{/other_user}","gists_url":"https://api.github.com/users/jgm/gists{/gist_id}","starred_url":"https://api.github.com/users/jgm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jgm/subscriptions","organizations_url":"https://api.github.com/users/jgm/orgs","repos_url":"https://api.github.com/users/jgm/repos","events_url":"https://api.github.com/users/jgm/events{/privacy}","received_events_url":"https://api.github.com/users/jgm/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":30323186,"digest":null,"download_count":1567,"created_at":"2023-06-07T04:36:13Z","updated_at":"2023-06-07T04:36:49Z","browser_download_url":"https://github.com/jgm/pandoc/releases/download/3.1.3/pandoc-3.1.3-1-arm64.deb"},{"url":"https://api.github.com/repos/jgm/pandoc/releases/assets/111630388","id":111630388,"node_id":"RA_kwDOAAi5es4Gp1g0","name":"pandoc-3.1.3-arm64-macOS.pkg","label":null,"uploader":{"login":"jgm","id":3044,"node_id":"MDQ6VXNlcjMwNDQ=","avatar_url":"https://avatars.githubusercontent.com/u/3044?v=4","gravatar_id":"","url":"https://api.github.com/users/jgm","html_url":"https://github.com/jgm","followers_url":"https://api.github.com/users/jgm/followers","following_url":"https://api.github.com/users/jgm/following{/other_user}","gists_url":"https://api.github.com/users/jgm/gists{/gist_id}","starred_url":"https://api.github.com/users/jgm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jgm/subscriptions","organizations_url":"https://api.github.com/users/jgm/orgs","repos_url":"https://api.github.com/users/jgm/repos","events_url":"https://api.github.com/users/jgm/events{/privacy}","received_events_url":"https://api.github.com/users/jgm/received_events","type":"User","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":39573835,"digest":null,"download_count":4316,"created_at":"2023-06-07T04:36:49Z","updated_at":"2023-06-07T04:37:13Z","browser_download_url":"https://github.com/jgm/pandoc/releases/download/3.1.3/pandoc-3.1.3-arm64-macOS.pkg"},{"url":"https://api.github.com/repos/jgm/pandoc/releases/assets/111630403","id":111630403,"node_id":"RA_kwDOAAi5es4Gp1hD","name":"pandoc-3.1.3-arm64-macOS.zip","label":null,"uploader":{"login":"jgm","id":3044,"node_id":"MDQ6VXNlcjMwNDQ=","avatar_url":"https://avatars.githubusercontent.com/u/3044?v=4","gravatar_id":"","url":"https://api.github.com/users/jgm","html_url":"https://github.com/jgm","followers_url":"https://api.github.com/users/jgm/followers","following_url":"https://api.github.com/users/jgm/following{/other_user}"