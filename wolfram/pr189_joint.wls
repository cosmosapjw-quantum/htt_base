Needs["xAct`xTensor`"]; Print["XACT_LOAD_OK"];
jointSup = Maximize[{x + y, 0 <= x <= 1 && 0 <= y <= 1 && x + y <= 1}, {x, y}][[1]];
prodSup = Maximize[{x, 0 <= x <= 1}, x][[1]] + Maximize[{y, 0 <= y <= 1}, y][[1]];
factSup = Maximize[{x + y, 0 <= x <= 1 && 0 <= y <= 1}, {x, y}][[1]];
Print["joint_sup=", jointSup];
Print["product_sup=", prodSup];
Print["strict_1_lt_2=", jointSup < prodSup];
Print["factorized_joint_sup=", factSup];
If[jointSup === 1 && prodSup === 2 && jointSup < prodSup && factSup === 2, Print["PR189_WOLFRAM_PASS"], Print["PR189_WOLFRAM_FAIL"]];
Exit[0];
